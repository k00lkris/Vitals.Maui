<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
               x:Class="Vitals.Maui.Views.VitalsAnalysisView"
               x:DataType="vm:VitalsAnalysisViewModel">

    <Grid x:Name="PopupRoot"
          RowDefinitions="*,Auto"
          HeightRequest="680"
          WidthRequest="360"
          BackgroundColor="{DynamicResource CardBackground}">

        <ScrollView Grid.Row="0" Padding="16">
            <VerticalStackLayout Spacing="14">

                <!-- Header -->
                <Label Text="📊  Vitals Analysis"
                       FontSize="20" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}" />

                <Label FontSize="13" TextColor="{DynamicResource TextMuted}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding SelectedPatient.FullName,
                                      TargetNullValue='', FallbackValue='', Mode=OneWay}"
                                  TextColor="{DynamicResource PrimaryAccent}" />
                            <Span Text="  •  Last " TextColor="{DynamicResource TextMuted}" />
                            <Span Text="{Binding SelectedDays, Mode=OneWay}" TextColor="{DynamicResource PrimaryAccent}" />
                            <Span Text=" days  •  " TextColor="{DynamicResource TextMuted}" />
                            <Span Text="{Binding SelectedMetricReadingCount, Mode=OneWay}" TextColor="{DynamicResource PrimaryAccent}" />
                            <Span Text=" readings" TextColor="{DynamicResource TextMuted}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Day Range Buttons -->
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                    <Button Grid.Column="0" Text="15d"
                            BackgroundColor="{Binding Btn15Color}"
                            TextColor="{Binding Btn15TextColor}" FontSize="12"
                            HeightRequest="36" CornerRadius="6"
                            Command="{Binding SelectDaysCommand}"
                            CommandParameter="15" />
                    <Button Grid.Column="1" Text="30d"
                            BackgroundColor="{Binding Btn30Color}"
                            TextColor="{Binding Btn30TextColor}" FontSize="12"
                            HeightRequest="36" CornerRadius="6"
                            Command="{Binding SelectDaysCommand}"
                            CommandParameter="30" />
                    <Button Grid.Column="2" Text="45d"
                            BackgroundColor="{Binding Btn45Color}"
                            TextColor="{Binding Btn45TextColor}" FontSize="12"
                            HeightRequest="36" CornerRadius="6"
                            Command="{Binding SelectDaysCommand}"
                            CommandParameter="45" />
                    <Button Grid.Column="3" Text="60d"
                            BackgroundColor="{Binding Btn60Color}"
                            TextColor="{Binding Btn60TextColor}" FontSize="12"
                            HeightRequest="36" CornerRadius="6"
                            Command="{Binding SelectDaysCommand}"
                            CommandParameter="60" />
                    <Button Grid.Column="4"
                            Text="{Binding CustomDaysLabel}"
                            BackgroundColor="{Binding BtnCustomColor}"
                            TextColor="{Binding BtnCustomTextColor}" FontSize="12"
                            HeightRequest="36" CornerRadius="6"
                            Clicked="OnCustomDaysClicked" />
                </Grid>

                <!-- Busy -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{DynamicResource PrimaryAccent}"
                                   HorizontalOptions="Center" />

                <!-- Analysis Tabs -->
                <VerticalStackLayout Spacing="12"
                                     IsVisible="{Binding HasAnalysisResponse}">
                    <!-- Optional vital tabs are only shown when the signed-in
                         user tracks that metric. BP is always available. -->
                    <!-- Primary vital tabs stay on one row. Using equal Grid
                         columns avoids Temp wrapping on narrower phone widths. -->
                    <Grid ColumnDefinitions="*,*,*,*"
                          ColumnSpacing="6">
                        <Button Grid.Column="0"
                                Text="❤️ BP"
                                BackgroundColor="{Binding TabBpColor}"
                                TextColor="{Binding TabBpTextColor}" FontSize="12"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="bp" />
                        <Button Grid.Column="1"
                                Text="💓 HR"
                                IsVisible="{Binding TrackHeartRate}"
                                BackgroundColor="{Binding TabHrColor}"
                                TextColor="{Binding TabHrTextColor}" FontSize="12"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="hr" />
                        <Button Grid.Column="2"
                                Text="🫁 SpO₂"
                                IsVisible="{Binding TrackSpo2}"
                                BackgroundColor="{Binding TabSpo2Color}"
                                TextColor="{Binding TabSpo2TextColor}" FontSize="12"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="spo2" />
                        <Button Grid.Column="3"
                                Text="🌡️ Temp"
                                IsVisible="{Binding TrackTemperature}"
                                BackgroundColor="{Binding TabTempColor}"
                                TextColor="{Binding TabTempTextColor}" FontSize="12"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="temp" />
                    </Grid>

                    <!-- Weight and Glucose are secondary tabs. Center the visible
                         buttons as a group beneath the four primary tabs. -->
                    <HorizontalStackLayout Spacing="6"
                                           HorizontalOptions="Center">
                        <Button Text="⚖️ Weight"
                                WidthRequest="96"
                                IsVisible="{Binding TrackWeight}"
                                BackgroundColor="{Binding TabWeightColor}"
                                TextColor="{Binding TabWeightTextColor}" FontSize="12"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="weight" />
                        <Button Text="🩸 Glucose"
                                WidthRequest="100"
                                IsVisible="{Binding TrackGlucose}"
                                BackgroundColor="{Binding TabGlucoseColor}"
                                TextColor="{Binding TabGlucoseTextColor}" FontSize="12"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="glucose" />
                    </HorizontalStackLayout>

                    <!-- BP's own data gate belongs directly below the vital
                         selector so it reads as the state of the selected BP tab. -->
                    <Border Padding="16"
                            BackgroundColor="{DynamicResource CardBackground}"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{DynamicResource CardStroke}"
                            IsVisible="{Binding ShowBpInsufficient}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="📈  Not Enough Data Yet"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryAccent}" />
                            <Label Text="{Binding Analysis.Message}"
                                   FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Analysis Results -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasAnalysisResults}">

                    <!-- ==================== BP TAB ==================== -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowBpAnalysis}">

                        <!-- Classification -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="ACC/AHA Classification"
                                       FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.ClassificationDisplay}"
                                       FontSize="18" FontAttributes="Bold">
                                    <Label.TextColor>
                                        <Binding Path="Analysis.ClassificationColor" />
                                    </Label.TextColor>
                                </Label>
                                <Label FontSize="12" TextColor="{DynamicResource TextMuted}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Avg BP  " />
                                            <Span Text="{Binding Analysis.Systolic.Avg, StringFormat='{0:F1}', Mode=OneWay}"
                                                  TextColor="{DynamicResource TextPrimary}" />
                                            <Span Text=" / " />
                                            <Span Text="{Binding Analysis.Diastolic.Avg, StringFormat='{0:F1}', Mode=OneWay}"
                                                  TextColor="{DynamicResource TextPrimary}" />
                                            <Span Text=" mmHg" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,4,0,2" />
                                <Label FontSize="12" TextColor="{DynamicResource TextMuted}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="MAP  " />
                                            <Span Text="{Binding Analysis.Map.Avg, StringFormat='{0:F1}', Mode=OneWay}"
                                                  TextColor="{DynamicResource TextPrimary}" />
                                            <Span Text=" mmHg  " />
                                            <Span Text="{Binding Analysis.Map.RangeLabel, Mode=OneWay}" FontSize="11" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="Mean arterial pressure — the average pressure the arteries experience across the full heartbeat cycle. Normal: 70–100 mmHg."
                                       FontSize="10" TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Trend -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="BLOOD PRESSURE TREND"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryAccent}" />

                                <!-- Systolic -->
                                <Label Text="Systolic" FontSize="11" FontAttributes="Bold" TextColor="#d32f2f" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Direction" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label FontSize="14" FontAttributes="Bold">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Analysis.Systolic.TrendArrow, Mode=OneWay}" FontSize="16" />
                                                    <Span Text="  " />
                                                    <Span Text="{Binding Analysis.Systolic.TrendLabel, Mode=OneWay}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                            <Label.TextColor>
                                                <Binding Path="Analysis.Systolic.TrendColor" />
                                            </Label.TextColor>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="Rate of Change" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Systolic.SlopeDisplay}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <Label Text="Significance" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Systolic.PValueDisplay}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Label Text="Consistency" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Systolic.ConsistencyLabel}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="2">
                                        <Label Text="Momentum" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Systolic.MomentumLabel}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,4" />

                                <!-- Diastolic -->
                                <Label Text="Diastolic" FontSize="11" FontAttributes="Bold" TextColor="#1976d2" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Direction" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label FontSize="14" FontAttributes="Bold">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Analysis.Diastolic.TrendArrow, Mode=OneWay}" FontSize="16" />
                                                    <Span Text="  " />
                                                    <Span Text="{Binding Analysis.Diastolic.TrendLabel, Mode=OneWay}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                            <Label.TextColor>
                                                <Binding Path="Analysis.Diastolic.TrendColor" />
                                            </Label.TextColor>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="Rate of Change" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Diastolic.SlopeDisplay}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <Label Text="Significance" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Diastolic.PValueDisplay}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Label Text="Consistency" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Diastolic.ConsistencyLabel}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="2">
                                        <Label Text="Momentum" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Diastolic.MomentumLabel}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- BP Burden — Hypertension -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.IsHypotension,
                                    Converter={StaticResource InvertedBoolConverter}}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="BP BURDEN" FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="Percentage of time spent in each range:"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                    <Border Grid.Column="0" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileNormalBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Burden.NormalDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="Normal" FontSize="10" TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="&lt;120" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileLowBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Burden.ElevatedDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#f57c00" HorizontalOptions="Center" />
                                            <Label Text="Elevated" FontSize="10" TextColor="#f57c00" HorizontalOptions="Center" />
                                            <Label Text="120-129" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileSevereBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Burden.Stage1Display}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="Stage 1" FontSize="10" TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="130-139" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="3" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileCriticalBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Burden.Stage2Display}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#7b1fa2" HorizontalOptions="Center" />
                                            <Label Text="Stage 2" FontSize="10" TextColor="#7b1fa2" HorizontalOptions="Center" />
                                            <Label Text="≥140" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- BP Burden — Hypotension -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.IsHypotension}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="LOW BP BURDEN" FontSize="11" FontAttributes="Bold" TextColor="#1976d2" />
                                <Label Text="Percentage of time spent in each low BP range:"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                    <Border Grid.Column="0" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileNormalBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.HypoBurden.NormalDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="Normal" FontSize="10" TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="≥90" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileLowBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.HypoBurden.ModerateDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="{DynamicResource PrimaryAccent}" HorizontalOptions="Center" />
                                            <Label Text="Low" FontSize="10" TextColor="{DynamicResource PrimaryAccent}" HorizontalOptions="Center" />
                                            <Label Text="80-89" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileSevereBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.HypoBurden.SevereDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="Severe" FontSize="10" TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="&lt;80" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Low Diastolic Burden -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.IsHypotension}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="LOW DIASTOLIC BURDEN" FontSize="11" FontAttributes="Bold" TextColor="#1976d2" />
                                <Label Text="Percentage of time spent in each diastolic range:"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                    <Border Grid.Column="0" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileNormalBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.LowDbpBurden.NormalDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="Normal" FontSize="10" TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="≥70" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileLowBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.LowDbpBurden.LowDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="{DynamicResource PrimaryAccent}" HorizontalOptions="Center" />
                                            <Label Text="Low" FontSize="10" TextColor="{DynamicResource PrimaryAccent}" HorizontalOptions="Center" />
                                            <Label Text="60-69" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileSevereBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.LowDbpBurden.SevereDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="Severe" FontSize="10" TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="&lt;60" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="3" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileCriticalBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.LowDbpBurden.CriticalDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#ff1744" HorizontalOptions="Center" />
                                            <Label Text="Critical" FontSize="10" TextColor="#ff1744" HorizontalOptions="Center" />
                                            <Label Text="&lt;50" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                                <Label FontSize="12" TextColor="{DynamicResource TextMuted}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Lowest recorded diastolic: " />
                                            <Span Text="{Binding Analysis.LowDbpBurden.LowestDiaDisplay, Mode=OneWay}"
                                                  FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding Analysis.LowDbpBurden.PlainEnglish}"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="WordWrap" />
                                <Border Padding="10,8"
                                        BackgroundColor="{DynamicResource TileCriticalBg}"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#ff1744"
                                        IsVisible="{Binding Analysis.ShowLowDiastolicAlert}">
                                    <Label Text="{Binding Analysis.LowDiastolicAlertText}"
                                           FontSize="12" TextColor="#ff1744"
                                           LineBreakMode="WordWrap" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- SBP Burden + TTR -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="BLOOD PRESSURE BURDEN &amp; TIME IN RANGE"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Pumping Pressure Burden"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextSecondary}" />
                                        <Label Text="Time pumping pressure exceeded 130 mmHg (weighted by excess)"
                                               FontSize="10" TextColor="{DynamicResource TextMuted}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Padding="12,8"
                                            BackgroundColor="{DynamicResource TileSevereBg}"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center"
                                            Margin="8,0,0,0">
                                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.SbpBurden.PctDisplay}"
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="of readings" FontSize="9" TextColor="{DynamicResource TextMuted}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding Analysis.SbpBurden.PlainEnglish}"
                                           FontSize="12" TextColor="{DynamicResource TextMuted}"
                                           LineBreakMode="WordWrap" Margin="0,4,0,0" />
                                </Grid>
                                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,4" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Time in Healthy Range"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextSecondary}" />
                                        <Label Text="Pumping pressure within target range of 100–130 mmHg"
                                               FontSize="10" TextColor="{DynamicResource TextMuted}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Padding="12,8"
                                            BackgroundColor="{DynamicResource TileNormalBg}"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center"
                                            Margin="8,0,0,0">
                                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Ttr.PctDisplay}"
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="of time" FontSize="9" TextColor="{DynamicResource TextMuted}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding Analysis.Ttr.PlainEnglish}"
                                           FontSize="12" TextColor="{DynamicResource TextMuted}"
                                           LineBreakMode="WordWrap" Margin="0,4,0,0" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Resting Pressure Burden (DBP) -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="RESTING PRESSURE BURDEN"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="How often the heart's resting pressure between beats exceeds the healthy threshold of 80 mmHg"
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="WordWrap" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Diastolic Burden"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextSecondary}" />
                                        <Label Text="The heart's resting pressure between beats"
                                               FontSize="10" TextColor="{DynamicResource TextMuted}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Padding="12,8"
                                            BackgroundColor="{DynamicResource TileLowBg}"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center"
                                            Margin="8,0,0,0">
                                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.DbpBurden.PctDisplay}"
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#ffa726" HorizontalOptions="Center" />
                                            <Label Text="of time" FontSize="9" TextColor="{DynamicResource TextMuted}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding Analysis.DbpBurden.PlainEnglish}"
                                           FontSize="12" TextColor="{DynamicResource TextMuted}"
                                           LineBreakMode="WordWrap" Margin="0,4,0,0" />
                                </Grid>
                                <Border Padding="10,8"
                                        BackgroundColor="{DynamicResource TileLowBg}"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#ffa726"
                                        IsVisible="{Binding ShowDiastolicWarning}">
                                    <Label Text="{Binding DiastolicWarningText}"
                                           FontSize="12" TextColor="#ffa726"
                                           LineBreakMode="WordWrap" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Plain English -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding PlainEnglishSummary,
                                    Converter={StaticResource StringToBoolConverter}}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="💬  In Plain English"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding PlainEnglishSummary}"
                                       FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding PcpLine}"
                                       FontSize="13" TextColor="{DynamicResource PrimaryAccent}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap"
                                       IsVisible="{Binding PcpLine,
                                           Converter={StaticResource StringToBoolConverter}}" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <!-- ==================== HR TAB ==================== -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowHr}">

                        <!-- §6.1 Latest reading + context -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Latest Reading" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.HeartRate.Bpm, StringFormat='{0} BPM'}"
                                       FontSize="24" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding Analysis.HeartRate.RecordedAt, StringFormat='{0:MMM d, yyyy \\a\\t h:mm tt}'}"
                                       FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,8" />
                                <Grid ColumnDefinitions="*,*" RowSpacing="4" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="Activity" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.HeartRate.ActivityContextDisplay}" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="Position" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.HeartRate.PostureDisplay}" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Label Text="{Binding Analysis.HeartRate.SymptomTagsDisplay, StringFormat='Symptoms: {0}'}"
                                       FontSize="12" TextColor="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                                <Label Text="{Binding Analysis.HeartRate.IrregularPulseDisplay}"
                                       FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Heart Rate — Plain English -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding HrSummary, Converter={StaticResource StringToBoolConverter}}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="In Plain English" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding HrSummary}" FontSize="13" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- §6.2 Resting central tendency -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.HeartRate.HasRestingSummary}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Resting Average" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.HeartRate.RestingSummary.Mean, StringFormat='{0:F0} BPM mean  ·  {1:F0} BPM median'}"
                                       FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Analysis.HeartRate.RestingSummary.N}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center" />
                                        <Label Text="readings" FontSize="10" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding Analysis.HeartRate.RestingSummary.DistinctDays}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center" />
                                        <Label Text="days" FontSize="10" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2">
                                        <Label Text="{Binding Analysis.HeartRate.RestingSummary.Range, StringFormat='{0} BPM'}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center" />
                                        <Label Text="range" FontSize="10" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- §6.3 Dispersion -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.HeartRate.HasDispersion}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Reading-to-Reading Variability" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.HeartRate.Dispersion.Sd, StringFormat='SD {0:F1} BPM'}"
                                       FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding Analysis.HeartRate.Dispersion.Iqr, StringFormat='IQR {0:F1} BPM'}"
                                       FontSize="13" TextColor="{DynamicResource TextSecondary}" />

                                <!-- §6.3 comparison vs prior 30 days — fixed, independent of the selected window -->
                                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,8"
                                         IsVisible="{Binding Analysis.HeartRate.DispersionTrend.Message, Converter={StaticResource StringToBoolConverter}}" />
                                <Label Text="{Binding Analysis.HeartRate.DispersionTrend.Message}"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" FontAttributes="Italic"
                                       IsVisible="{Binding Analysis.HeartRate.DispersionTrend.Message, Converter={StaticResource StringToBoolConverter}}" />
                                <Label FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                       IsVisible="{Binding Analysis.HeartRate.HasDispersionTrendComparison}">
                                    <Label.Text>
                                        <Binding Path="Analysis.HeartRate.DispersionTrend.SdDelta" StringFormat="SD change vs. prior 30 days: {0:+0.0;-0.0} BPM" />
                                    </Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <!-- §6.4/§6.5 Trend -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.HeartRate.HasTrend}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Trend" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label FontSize="16" FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Analysis.HeartRate.Trend.TrendArrow, Mode=OneWay}" FontSize="18" />
                                            <Span Text=" " />
                                            <Span Text="{Binding Analysis.HeartRate.Trend.TrendLabelDisplay, Mode=OneWay}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                    <Label.TextColor>
                                        <Binding Path="Analysis.HeartRate.Trend.TrendColor" />
                                    </Label.TextColor>
                                </Label>
                                <Label Text="{Binding Analysis.HeartRate.Trend.SlopeDisplay}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                <Label Text="{Binding Analysis.HeartRate.Trend.PValueDisplay}" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                <Label Text="{Binding Analysis.HeartRate.Trend.ConsistencyDisplay}" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                <!-- §6.5 LOESS: smoothed-trend data availability. Chart overlay
                                     rendering is a follow-up — this confirms the smoothed series
                                     exists without yet drawing it. -->
                                <Label Text="A smoothed trend line is available for the chart view."
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" FontAttributes="Italic"
                                       Margin="0,4,0,0"
                                       IsVisible="{Binding Analysis.HeartRate.HasLoess}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- §6.6 Personal baseline deviation -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.HeartRate.HasBaselineDeviation}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="This Week vs. Your Typical Baseline" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Grid ColumnDefinitions="*,*">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Analysis.HeartRate.BaselineDeviation.BaselineMedian, StringFormat='{0:F0} BPM'}"
                                               FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                        <Label Text="Prior 30 days (baseline)" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding Analysis.HeartRate.BaselineDeviation.RecentMedian, StringFormat='{0:F0} BPM'}"
                                               FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                        <Label Text="Last 7 days (recent)" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Label Text="{Binding Analysis.HeartRate.BaselineDeviation.DeltaDisplay, StringFormat='Change: {0}'}"
                                       FontSize="13" TextColor="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- §6.7 High/low resting-rate events -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.HeartRate.HasRateEvents}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="High/Low Resting Readings" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label FontSize="16" FontAttributes="Bold" TextColor="#d32f2f">
                                            <Label.Text>
                                                <Binding Path="Analysis.HeartRate.RateEvents.High.Count" StringFormat="{}{0} high" />
                                            </Label.Text>
                                        </Label>
                                        <Label FontSize="11" TextColor="{DynamicResource TextMuted}">
                                            <Label.Text>
                                                <Binding Path="Analysis.HeartRate.RateEvents.Thresholds.High" StringFormat="above {0} BPM" />
                                            </Label.Text>
                                        </Label>
                                        <Label FontSize="11" TextColor="{DynamicResource TextSecondary}"
                                               IsVisible="{Binding Analysis.HeartRate.RateEvents.High.HasPct}">
                                            <Label.Text>
                                                <Binding Path="Analysis.HeartRate.RateEvents.High.Pct" StringFormat="{}{0:F0}% of readings" />
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label FontSize="16" FontAttributes="Bold" TextColor="#1976d2">
                                            <Label.Text>
                                                <Binding Path="Analysis.HeartRate.RateEvents.Low.Count" StringFormat="{}{0} low" />
                                            </Label.Text>
                                        </Label>
                                        <Label FontSize="11" TextColor="{DynamicResource TextMuted}">
                                            <Label.Text>
                                                <Binding Path="Analysis.HeartRate.RateEvents.Thresholds.Low" StringFormat="below {0} BPM" />
                                            </Label.Text>
                                        </Label>
                                        <Label FontSize="11" TextColor="{DynamicResource TextSecondary}"
                                               IsVisible="{Binding Analysis.HeartRate.RateEvents.Low.HasPct}">
                                            <Label.Text>
                                                <Binding Path="Analysis.HeartRate.RateEvents.Low.Pct" StringFormat="{}{0:F0}% of readings" />
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                                <Label FontSize="11" TextColor="{DynamicResource TextMuted}" Margin="0,4,0,0"
                                       IsVisible="{Binding Analysis.HeartRate.RateEvents.HasMarkedLow}">
                                    <Label.Text>
                                        <Binding Path="Analysis.HeartRate.RateEvents.MarkedLowCount" StringFormat="{}{0} of these were markedly low" />
                                    </Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <!-- §6.8 Time-of-day pattern -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.HeartRate.TimeOfDay.Buckets.HasAny}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Time-of-Day Pattern" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" IsVisible="{Binding Analysis.HeartRate.TimeOfDay.Buckets.HasMorning}">
                                        <Label Text="Morning" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.HeartRate.TimeOfDay.Buckets.Morning.Mean, StringFormat='{0:F0} BPM'}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" IsVisible="{Binding Analysis.HeartRate.TimeOfDay.Buckets.HasAfternoon}">
                                        <Label Text="Afternoon" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.HeartRate.TimeOfDay.Buckets.Afternoon.Mean, StringFormat='{0:F0} BPM'}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" IsVisible="{Binding Analysis.HeartRate.TimeOfDay.Buckets.HasEvening}">
                                        <Label Text="Evening" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.HeartRate.TimeOfDay.Buckets.Evening.Mean, StringFormat='{0:F0} BPM'}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" IsVisible="{Binding Analysis.HeartRate.TimeOfDay.Buckets.HasOvernight}">
                                        <Label Text="Overnight" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.HeartRate.TimeOfDay.Buckets.Overnight.Mean, StringFormat='{0:F0} BPM'}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Label FontSize="12" TextColor="{DynamicResource TextSecondary}" Margin="0,4,0,0"
                                       IsVisible="{Binding Analysis.HeartRate.HasTimeOfDayPattern}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="Highest: {0}  ·  Lowest: {1}">
                                            <Binding Path="Analysis.HeartRate.TimeOfDay.PatternSummary.HighestPeriod" />
                                            <Binding Path="Analysis.HeartRate.TimeOfDay.PatternSummary.LowestPeriod" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <!-- §6.9 Symptom association -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.HeartRate.HasSymptomAssociation}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Symptoms Logged with Readings" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <!-- BindableLayout, not CollectionView — a small static list
                                     inside a page that's already one big ScrollView; CollectionView
                                     doesn't size itself correctly when nested this way. -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Analysis.HeartRate.SymptomAssociationList}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Spacing="2" Margin="0,0,0,8">
                                                <!-- Plain Label bound to HeaderDisplay (combines tag + count
                                                     in C#) — same pattern as HrUnavailableAnalysis.DisplayText,
                                                     not FormattedString/Span. -->
                                                <Label Text="{Binding HeaderDisplay}" FontSize="13"
                                                       FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                                <Label FontSize="12" TextColor="{DynamicResource TextSecondary}"
                                                       IsVisible="{Binding HasPctLow}">
                                                    <Label.Text>
                                                        <Binding Path="PctLow" StringFormat="{}{0:F0}% occurred with a low reading" />
                                                    </Label.Text>
                                                </Label>
                                                <Label FontSize="12" TextColor="{DynamicResource TextSecondary}"
                                                       IsVisible="{Binding HasPctHigh}">
                                                    <Label.Text>
                                                        <Binding Path="PctHigh" StringFormat="{}{0:F0}% occurred with a high reading" />
                                                    </Label.Text>
                                                </Label>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- §6.11 Cross-vital same-event context -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.HeartRate.CrossVitalContext.HasAny}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Alongside Other Vitals" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                       IsVisible="{Binding Analysis.HeartRate.CrossVitalContext.HasBloodPressure}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="Blood pressure was elevated alongside {0} high and {1} low heart-rate reading(s)">
                                            <Binding Path="Analysis.HeartRate.CrossVitalContext.BloodPressure.CoOccurrenceHigh" />
                                            <Binding Path="Analysis.HeartRate.CrossVitalContext.BloodPressure.CoOccurrenceLow" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <Label FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                       IsVisible="{Binding Analysis.HeartRate.CrossVitalContext.HasOxygenSaturation}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="SpO₂ was abnormal alongside {0} high and {1} low heart-rate reading(s)">
                                            <Binding Path="Analysis.HeartRate.CrossVitalContext.OxygenSaturation.CoOccurrenceHigh" />
                                            <Binding Path="Analysis.HeartRate.CrossVitalContext.OxygenSaturation.CoOccurrenceLow" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <Label FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                       IsVisible="{Binding Analysis.HeartRate.CrossVitalContext.HasTemperature}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="Temperature was abnormal alongside {0} high and {1} low heart-rate reading(s)">
                                            <Binding Path="Analysis.HeartRate.CrossVitalContext.Temperature.CoOccurrenceHigh" />
                                            <Binding Path="Analysis.HeartRate.CrossVitalContext.Temperature.CoOccurrenceLow" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <!-- §6.10 Medication-change association -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.HeartRate.HasMedicationAssociations}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Around Medication Changes" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <!-- BindableLayout, not CollectionView — same reasoning as above. -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Analysis.HeartRate.MedicationAssociations}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Spacing="2" Margin="0,0,0,10">
                                                <!-- Both plain Labels bound to combined-string properties on
                                                     the model — NameAndChangeDisplay and BpmChangeDisplay —
                                                     replacing FormattedString/Span and MultiBinding
                                                     respectively. Same pattern as HrUnavailableAnalysis
                                                     .DisplayText above. -->
                                                <Label Text="{Binding NameAndChangeDisplay}" FontSize="13"
                                                       FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                                <Label Text="{Binding EffectiveDate, StringFormat='{0:MMM d, yyyy}'}" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                                <Label Text="{Binding BpmChangeDisplay}" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                                                <Label Text="⚠ Another medication change occurred in this same window — treat this comparison as less certain"
                                                       FontSize="11" TextColor="#f57c00" FontAttributes="Italic"
                                                       IsVisible="{Binding Confounded}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- §6.12 Data support -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Data Confidence" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.HeartRate.DataSupport.SupportStateDisplay}"
                                       FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                <Label FontSize="12" TextColor="{DynamicResource TextSecondary}"
                                       IsVisible="{Binding Analysis.HeartRate.DataSupport.HasCoverage}">
                                    <Label.Text>
                                        <Binding Path="Analysis.HeartRate.DataSupport.DistinctDayCoveragePct" StringFormat="Logged on {0:F0}% of days in this window" />
                                    </Label.Text>
                                </Label>
                                <!-- BindableLayout, not CollectionView — same reasoning as above. -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Analysis.HeartRate.DataSupport.UnavailableAnalyses}"
                                                     IsVisible="{Binding Analysis.HeartRate.HasUnavailableAnalyses}"
                                                     Margin="0,6,0,0"
                                                     Spacing="2">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Single plain Label bound to DisplayText (a computed property
                                                 on the model that combines name + reason in C#) — the same
                                                 binding pattern already confirmed working elsewhere on this
                                                 page (SupportStateDisplay), not FormattedString/Span. -->
                                            <Label Text="{Binding DisplayText}" FontSize="11"
                                                   TextColor="{DynamicResource TextMuted}"
                                                   LineBreakMode="WordWrap" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding HrPcpLine}" FontSize="13" TextColor="{DynamicResource PrimaryAccent}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap"
                                       IsVisible="{Binding HrPcpLine, Converter={StaticResource StringToBoolConverter}}" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <!-- ==================== SPO2 TAB ==================== -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowSpo2}">

                        <!-- Latest reading + context -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Latest Reading" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Spo2.Spo2, StringFormat='{0}%'}"
                                       FontSize="24" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding Analysis.Spo2.RecordedAt, StringFormat='{0:MMM d, yyyy \\a\\t h:mm tt}'}"
                                       FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                                <Label Text="{Binding Analysis.Spo2.TargetProfile.SourceDisplay}"
                                       FontSize="11" TextColor="{DynamicResource TextMuted}" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Plain-English summary -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Spo2Summary, Converter={StaticResource StringToBoolConverter}}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="In Plain English" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Spo2Summary}" FontSize="13" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Central tendency (all logged readings — no resting filter yet) -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Spo2.HasSpotSummary}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Average" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Spo2.SpotSummary.Mean, StringFormat='{0:F1}% mean  ·  {1:F1}% median'}"
                                       FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Analysis.Spo2.SpotSummary.N}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center" />
                                        <Label Text="readings" FontSize="10" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding Analysis.Spo2.SpotSummary.DistinctDays}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center" />
                                        <Label Text="days" FontSize="10" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2">
                                        <Label Text="{Binding Analysis.Spo2.SpotSummary.Range, StringFormat='{0} pts'}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" HorizontalOptions="Center" />
                                        <Label Text="range" FontSize="10" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Dispersion -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Spo2.HasDispersion}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Reading-to-Reading Variability" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Spo2.Dispersion.Sd, StringFormat='SD {0:F1} pts'}"
                                       FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding Analysis.Spo2.Dispersion.Iqr, StringFormat='IQR {0:F1} pts'}"
                                       FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Trend -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Spo2.HasTrend}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Trend" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label FontSize="16" FontAttributes="Bold" Text="{Binding Analysis.Spo2.Trend.TrendArrow}">
                                    <Label.TextColor>
                                        <Binding Path="Analysis.Spo2.Trend.TrendColor" />
                                    </Label.TextColor>
                                </Label>
                                <Label Text="{Binding Analysis.Spo2.Trend.TrendLabelDisplay}" FontSize="14" TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding Analysis.Spo2.Trend.SlopeDisplay}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                <Label Text="{Binding Analysis.Spo2.Trend.PValueDisplay}" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                <Label Text="{Binding Analysis.Spo2.Trend.ConsistencyDisplay}" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                <Label Text="A smoothed trend line is available for the chart view."
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" FontAttributes="Italic"
                                       Margin="0,4,0,0"
                                       IsVisible="{Binding Analysis.Spo2.HasLoess}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Personal baseline deviation -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Spo2.HasBaselineDeviation}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="This Week vs. Your Typical Baseline" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Grid ColumnDefinitions="*,*">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Analysis.Spo2.BaselineDeviation.BaselineMedian, StringFormat='{0:F1}%'}"
                                               FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                        <Label Text="Prior 30 days (baseline)" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding Analysis.Spo2.BaselineDeviation.RecentMedian, StringFormat='{0:F1}%'}"
                                               FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                        <Label Text="Last 7 days (recent)" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Label Text="{Binding Analysis.Spo2.BaselineDeviation.DeltaDisplay, StringFormat='Change: {0}'}"
                                       FontSize="13" TextColor="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Low observations -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Spo2.LowObservations.HasReadings}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Readings Below Target" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Spo2.LowObservations.Count, StringFormat='{0} logged reading(s)'}"
                                       FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding Analysis.Spo2.LowObservations.Threshold, StringFormat='below {0}%'}"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                <Label FontSize="12" TextColor="{DynamicResource TextSecondary}"
                                       IsVisible="{Binding Analysis.Spo2.LowObservations.HasPct}">
                                    <Label.Text>
                                        <Binding Path="Analysis.Spo2.LowObservations.PctOfLoggedReadings" StringFormat="{}{0:F0}% of logged readings" />
                                    </Label.Text>
                                </Label>
                                <Label Text="These are counts of logged readings, not a measure of continuous time below target."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}" FontAttributes="Italic" Margin="0,6,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Confirmed low-observation episodes -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Spo2.HasConfirmedEpisodes}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Repeat-Confirmed Low Episodes" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Spo2.ConfirmedLowObservations.ConfirmationRuleMinutes, StringFormat='Two or more below-target readings within {0} minutes of each other'}"
                                       FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                <!-- BindableLayout, not CollectionView — same reasoning as above. -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Analysis.Spo2.ConfirmedLowObservations.Episodes}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Single plain Label bound to SummaryDisplay (a computed
                                                 property on the model) — not FormattedString/Span. -->
                                            <Label Text="{Binding SummaryDisplay}" FontSize="12"
                                                   TextColor="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Marked-low readings -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Spo2.HasMarkedLow}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Markedly Low Readings" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Spo2.MarkedLowObservations.Count, StringFormat='{0} reading(s)'}"
                                       FontSize="16" FontAttributes="Bold" TextColor="#d32f2f" />
                                <Label Text="{Binding Analysis.Spo2.MarkedLowObservations.Threshold, StringFormat='below {0}% — symptoms near these readings are important context for the care team'}"
                                       FontSize="12" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Reference bands — descriptive counts of logged readings only,
                             deliberately NOT framed as "time in range" (spec's own safety
                             rule: never imply continuous coverage from spot readings). -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Spo2.HasReferenceBands}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Reference Bands (Logged Readings)" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                    <Border Grid.Column="0" Padding="8,6" BackgroundColor="{DynamicResource TileNormalBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Spo2.ReferenceBands.AtOrAbove95.Count}" FontSize="16" FontAttributes="Bold" TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="Normal" FontSize="10" TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="≥95%" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="8,6" BackgroundColor="{DynamicResource TileLowBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Spo2.ReferenceBands.Band92To94.Count}" FontSize="16" FontAttributes="Bold" TextColor="#f57c00" HorizontalOptions="Center" />
                                            <Label Text="Mild" FontSize="10" TextColor="#f57c00" HorizontalOptions="Center" />
                                            <Label Text="92-94%" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Padding="8,6" BackgroundColor="{DynamicResource TileSevereBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Spo2.ReferenceBands.Band88To91.Count}" FontSize="16" FontAttributes="Bold" TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="Moderate" FontSize="10" TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="88-91%" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="3" Padding="8,6" BackgroundColor="{DynamicResource TileCriticalBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Spo2.ReferenceBands.Below88.Count}" FontSize="16" FontAttributes="Bold" TextColor="#7b1fa2" HorizontalOptions="Center" />
                                            <Label Text="Severe" FontSize="10" TextColor="#7b1fa2" HorizontalOptions="Center" />
                                            <Label Text="&lt;88%" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                                <Label Text="Counts of logged readings only — not a measure of time spent in each range."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}" FontAttributes="Italic" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Time-of-day pattern -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Spo2.TimeOfDay.Buckets.HasAny}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Readings by Time of Day" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" IsVisible="{Binding Analysis.Spo2.TimeOfDay.Buckets.HasMorning}">
                                        <Label Text="Morning" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Spo2.TimeOfDay.Buckets.Morning.Median, StringFormat='{0:F1}%'}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" IsVisible="{Binding Analysis.Spo2.TimeOfDay.Buckets.HasAfternoon}">
                                        <Label Text="Afternoon" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Spo2.TimeOfDay.Buckets.Afternoon.Median, StringFormat='{0:F1}%'}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" IsVisible="{Binding Analysis.Spo2.TimeOfDay.Buckets.HasEvening}">
                                        <Label Text="Evening" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Spo2.TimeOfDay.Buckets.Evening.Median, StringFormat='{0:F1}%'}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" IsVisible="{Binding Analysis.Spo2.TimeOfDay.Buckets.HasOvernight}">
                                        <Label Text="Overnight" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Spo2.TimeOfDay.Buckets.Overnight.Median, StringFormat='{0:F1}%'}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Label FontSize="12" TextColor="{DynamicResource TextSecondary}" Margin="0,4,0,0"
                                       IsVisible="{Binding Analysis.Spo2.HasTimeOfDayPattern}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="Highest: {0}  ·  Lowest: {1}">
                                            <Binding Path="Analysis.Spo2.TimeOfDay.PatternSummary.HighestPeriod" />
                                            <Binding Path="Analysis.Spo2.TimeOfDay.PatternSummary.LowestPeriod" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Cross-vital context for low observations -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Spo2.HasCrossVitalCorrelations}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Correlation with Other Vitals" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <!-- BindableLayout, not CollectionView — a handful of static rows
                                     inside a page that's already one big ScrollView; CollectionView
                                     expects to manage its own scrolling/virtualization and doesn't
                                     size itself correctly when nested this way. -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Analysis.Spo2.CorrelationItems}"
                                                     Spacing="2">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Label Text="{Binding DisplayText}" FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Label Text="Physician reference only — correlation does not establish cause."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}" FontAttributes="Italic" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Data support -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Data Confidence" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Spo2.DataSupport.SupportStateDisplay}"
                                       FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                <Label FontSize="12" TextColor="{DynamicResource TextSecondary}"
                                       IsVisible="{Binding Analysis.Spo2.DataSupport.HasCoverage}">
                                    <Label.Text>
                                        <Binding Path="Analysis.Spo2.DataSupport.DistinctDayCoveragePct" StringFormat="Logged on {0:F0}% of days in this window" />
                                    </Label.Text>
                                </Label>
                                <!-- Single Label bound to UnavailableAnalysesDisplay (combines every
                                     entry into one string in C#) — replaces the BindableLayout, which
                                     was still more machinery than this small, static text needs:
                                     ScrollView -> BindableLayout -> DataTemplate -> item BindingContext
                                     -> DisplayText, now just ScrollView -> Label -> one string. -->
                                <Label Text="{Binding Analysis.Spo2.DataSupport.UnavailableAnalysesDisplay}"
                                       IsVisible="{Binding Analysis.Spo2.DataSupport.HasUnavailableAnalyses}"
                                       FontSize="11"
                                       TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="WordWrap"
                                       Margin="0,6,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Care team -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Spo2PcpLine}" FontSize="13" TextColor="{DynamicResource PrimaryAccent}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap"
                                       IsVisible="{Binding Spo2PcpLine, Converter={StaticResource StringToBoolConverter}}" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <!-- ==================== TEMP TAB ==================== -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowTemp}">

                        <!-- In Plain English -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding TempSummary, Converter={StaticResource StringToBoolConverter}}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="💬  In Plain English" FontSize="13" FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding TempSummary}"
                                       FontSize="13"
                                       TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Latest temperature + measurement context -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Temperature.HasLatest}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Latest Temperature" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />

                                <Label Text="{Binding Analysis.Temperature.Latest.DualUnitDisplay}"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="Measurement" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.Latest.MeasurementContextDisplay}"
                                               FontSize="13" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextSecondary}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Recorded" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.Latest.RecordedAt, StringFormat='{0:MMM d, yyyy h:mm tt}'}"
                                               FontSize="13"
                                               TextColor="{DynamicResource TextSecondary}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Same-site personal baseline -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Temperature.HasBaseline}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Personal Baseline" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Same-site median" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.Baseline.MedianDualUnitDisplay}"
                                               FontSize="16" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="Current vs baseline" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.Baseline.DeltaCurrentDisplay}"
                                               FontSize="16" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <Label Text="Measurement site" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.Baseline.SiteDisplay}"
                                               FontSize="13"
                                               TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Label Text="Support" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.Baseline.SupportDisplay}"
                                               FontSize="13"
                                               TextColor="{DynamicResource TextSecondary}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Label Text="Personal baseline comparisons use the same measurement site."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       FontAttributes="Italic" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Fever-range logged observations -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Temperature.HasRangeEvents}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Fever-Range Observations" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Logged readings" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.RangeEvents.FeverCount}"
                                               FontSize="18" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="Percent of logged readings" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.RangeEvents.FeverLoggedPct, StringFormat='{0:F1}%'}"
                                               FontSize="18" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <Label Text="Febrile days" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.RangeEvents.FebrileDaysDisplay}"
                                               FontSize="13"
                                               TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Label Text="Configured reference" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.TargetProfile.FeverReferenceDisplay}"
                                               FontSize="13"
                                               TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Label Text="This percentage describes logged readings only; it does not estimate the percentage of time spent with fever."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Recorded fever episodes -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Temperature.HasEpisodes}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Recorded Fever Episodes" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Temperature.EpisodeCount, StringFormat='{0} episode(s) in this window'}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Analysis.Temperature.Episodes}"
                                                     Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10"
                                                    BackgroundColor="{DynamicResource CardBackground}"
                                                    Stroke="{DynamicResource CardStroke}"
                                                    StrokeShape="RoundRectangle 8">
                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="{Binding EpisodeId, StringFormat='Episode {0}'}"
                                                           FontSize="12" FontAttributes="Bold"
                                                           TextColor="{DynamicResource TextPrimary}" />

                                                    <Label Text="{Binding PeakContextDisplay}"
                                                           FontSize="12"
                                                           TextColor="{DynamicResource TextSecondary}"
                                                           LineBreakMode="WordWrap" />

                                                    <!-- Single plain Label bound to MinimumLabelDisplay,
                                                         not FormattedString/Span — see the model's own
                                                         comment for why. -->
                                                    <Label Text="{Binding MinimumLabelDisplay}"
                                                           FontSize="12"
                                                           TextColor="{DynamicResource TextSecondary}" />

                                                    <Label Text="{Binding ObservedSpanSentence}"
                                                           FontSize="12"
                                                           TextColor="{DynamicResource TextSecondary}"
                                                           LineBreakMode="WordWrap" />

                                                    <Label Text="{Binding FeverReadingCount, StringFormat='{0} fever-range reading(s)'}"
                                                           FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}" />

                                                    <Label Text="{Binding SitesDisplay, StringFormat='Measurement site(s): {0}'}"
                                                           FontSize="11"
                                                           TextColor="{DynamicResource TextMuted}"
                                                           LineBreakMode="WordWrap" />

                                                    <Label Text="{Binding DeltaLatestFromPeakDisplay, StringFormat='Latest vs recorded peak: {0}'}"
                                                           IsVisible="{Binding HasLatestDelta}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource TextSecondary}"
                                                           LineBreakMode="WordWrap" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Acute episode trajectory -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Temperature.HasAcuteTrend}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Acute Episode Trend" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Direction" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding Analysis.Temperature.AcuteTrend.TrendArrow}"
                                                   FontSize="18" FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimary}" />
                                            <Label Text="{Binding Analysis.Temperature.AcuteTrend.TrendLabelDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="Modeled rate" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.AcuteTrend.SlopeDisplay}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
                                        <Label Text="Sample support" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.AcuteTrend.SupportDisplay}"
                                               FontSize="13"
                                               TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Label Text="Short-window same-site episode model; this is not a long-term temperature trend."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Low temperature / hypothermia-range observations -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Temperature.HasRangeEvents}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Low Temperature" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Lowest recorded" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.RangeEvents.LowestDisplay}"
                                               FontSize="18" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                        <Label Text="{Binding Analysis.Temperature.RangeEvents.LowestSiteDisplay}"
                                               FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="Hypothermia-range readings" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.RangeEvents.HypothermiaRangeCount}"
                                               FontSize="18" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
                                        <Label Text="Hypothermia reference" FontSize="11"
                                               TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.TargetProfile.HypothermiaReferenceDisplay}"
                                               FontSize="13"
                                               TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Analysis.Temperature.RangeEvents.HypothermiaReadings}"
                                                     IsVisible="{Binding Analysis.Temperature.RangeEvents.HasHypothermiaReadings}"
                                                     Spacing="2">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Label Text="{Binding DisplayText}"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource TextSecondary}"
                                                   LineBreakMode="WordWrap" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="If a current or repeat measurement is below 95°F, seek urgent medical evaluation."
                                       IsVisible="{Binding Analysis.Temperature.RangeEvents.HasHypothermiaReadings}"
                                       FontSize="11"
                                       TextColor="#d32f2f"
                                       FontAttributes="Bold"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Cross-vital same-event context -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Temperature.CrossVitalContext.HasAnyPairedVitals}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Cross-Vital Context" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />

                                <Label Text="Vitals recorded alongside fever-range observations"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />

                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                    <Border Grid.Column="0" Padding="8"
                                            BackgroundColor="{DynamicResource CardBackground}"
                                            Stroke="{DynamicResource CardStroke}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Temperature.CrossVitalContext.PairedCounts.HeartRate}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   TextColor="{DynamicResource TextPrimary}" />
                                            <Label Text="Heart rate" FontSize="9"
                                                   HorizontalOptions="Center"
                                                   TextColor="{DynamicResource TextMuted}" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border Grid.Column="1" Padding="8"
                                            BackgroundColor="{DynamicResource CardBackground}"
                                            Stroke="{DynamicResource CardStroke}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Temperature.CrossVitalContext.PairedCounts.OxygenSaturation}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   TextColor="{DynamicResource TextPrimary}" />
                                            <Label Text="SpO₂" FontSize="9"
                                                   HorizontalOptions="Center"
                                                   TextColor="{DynamicResource TextMuted}" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border Grid.Column="2" Padding="8"
                                            BackgroundColor="{DynamicResource CardBackground}"
                                            Stroke="{DynamicResource CardStroke}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Temperature.CrossVitalContext.PairedCounts.BloodPressure}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   TextColor="{DynamicResource TextPrimary}" />
                                            <Label Text="Blood pressure" FontSize="9"
                                                   HorizontalOptions="Center"
                                                   TextColor="{DynamicResource TextMuted}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Analysis.Temperature.CrossVitalContext.FeverObservations}"
                                                     Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding DisplayText}"
                                                       FontSize="12" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextSecondary}"
                                                       LineBreakMode="WordWrap" />

                                                <Label Text="{Binding Context.HeartRate, StringFormat='Heart rate: {0} BPM'}"
                                                       IsVisible="{Binding Context.HasHeartRate}"
                                                       FontSize="11"
                                                       TextColor="{DynamicResource TextMuted}" />

                                                <Label Text="{Binding Context.OxygenSaturation, StringFormat='SpO₂: {0}%'}"
                                                       IsVisible="{Binding Context.HasOxygenSaturation}"
                                                       FontSize="11"
                                                       TextColor="{DynamicResource TextMuted}" />

                                                <!-- Single plain Label bound to BloodPressureContextDisplay,
                                                     not MultiBinding — see the model's own comment for why. -->
                                                <Label Text="{Binding BloodPressureContextDisplay}"
                                                       IsVisible="{Binding Context.HasBloodPressure}"
                                                       FontSize="11"
                                                       TextColor="{DynamicResource TextMuted}" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Label Text="These measurements occurred alongside one another; this does not establish causation."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Data support / measurement-site limitations -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Weight.HasVariation}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Daily Variability" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Weight.VariationDisplay}"
                                       FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="Weight statistics use one median value per local calendar day so multiple checks on one day do not receive extra statistical weight."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Data Confidence" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />

                                <Label Text="{Binding Analysis.Temperature.DataSupport.SupportStateDisplay}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />

                                <Label Text="{Binding Analysis.Temperature.DataSupport.CoverageDisplay}"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}" />

                                <Label Text="{Binding Analysis.Temperature.DataSupport.KnownSiteCoverageDisplay}"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}" />

                                <Label Text="{Binding Analysis.Temperature.DataSupport.SiteConsistencyDisplay}"
                                       IsVisible="{Binding Analysis.Temperature.DataSupport.HasSiteConsistency}"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}" />

                                <Label Text="{Binding Analysis.Temperature.DataSupport.ModalSiteDisplay, StringFormat='Most common measurement site: {0}'}"
                                       IsVisible="{Binding Analysis.Temperature.DataSupport.ModalSiteDisplay, Converter={StaticResource StringToBoolConverter}}"
                                       FontSize="12"
                                       TextColor="{DynamicResource TextSecondary}" />

                                <Label Text="{Binding Analysis.Temperature.DataSupport.MeasurementSiteLimitationDisplay}"
                                       IsVisible="{Binding Analysis.Temperature.DataSupport.MeasurementSiteLimitationDisplay, Converter={StaticResource StringToBoolConverter}}"
                                       FontSize="11"
                                       TextColor="#f57c00"
                                       FontAttributes="Italic"
                                       LineBreakMode="WordWrap"
                                       Margin="0,4,0,0" />

                                <Label Text="{Binding Analysis.Temperature.UnavailableAnalysesDisplay}"
                                       IsVisible="{Binding Analysis.Temperature.HasUnavailableAnalyses}"
                                       FontSize="11"
                                       TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="WordWrap"
                                       Margin="0,6,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Care team -->
                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding TempPcpLine, Converter={StaticResource StringToBoolConverter}}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Care Team" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding TempPcpLine}"
                                       FontSize="13"
                                       TextColor="{DynamicResource PrimaryAccent}"
                                       FontAttributes="Italic"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <!-- ==================== WEIGHT TAB ==================== -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowWeight}">

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding WeightSummary, Converter={StaticResource StringToBoolConverter}}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="💬  In Plain English" FontSize="13" FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding WeightSummary}"
                                       FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Weight.HasLatest}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Latest Weight" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Weight.LatestDisplay}"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding Analysis.Weight.Latest.RecordedAt, StringFormat='{0:MMM d, yyyy h:mm tt}'}"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Weight.HasBmi}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="BMI Screening Context" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Weight.BmiDisplay}"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding Analysis.Weight.BmiCategoryDisplay, StringFormat='BMI screening category: {0}'}"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextSecondary}" />
                                <Label Text="{Binding Analysis.Weight.BmiContextDisplay}"
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="BMI is a screening measure, not a diagnosis or a direct measure of body fat."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Weight.HasBmiUnavailable}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="BMI Screening Context" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="BMI unavailable"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding Analysis.Weight.BmiUnavailableDisplay}"
                                       FontSize="12" TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Weight.HasHistoricalBmi}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="Historical BMI Trajectory" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Weight.HistoricalBmiSummaryDisplay}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding Analysis.Weight.HistoricalBmiRecentPointsDisplay}"
                                       FontSize="11" TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding Analysis.Weight.HistoricalBmiCoverageDisplay}"
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="Each historical BMI point uses that day's median Weight and the newest active height observation effective on or before that date. Newer heights are never backfilled into older Weight dates."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Weight.HasHistoricalBmiUnavailable}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Historical BMI Trajectory" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="Historical BMI unavailable"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding Analysis.Weight.HistoricalBmiUnavailableDisplay}"
                                       FontSize="12" TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Weight.HasSummary}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Logged Reading Summary" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />

                                <Label Text="{Binding Analysis.Weight.SummarySourceDisplay}"
                                       FontSize="11"
                                       TextColor="{DynamicResource TextMuted}" />

                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      ColumnSpacing="16"
                                      RowSpacing="0">

                                    <!-- Table header -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="Metric"
                                           Padding="0,5,0,7"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource TextMuted}" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="Weight"
                                           Padding="0,5,0,7"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End"
                                           TextColor="{DynamicResource TextMuted}" />

                                    <!-- Mean -->
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="Mean"
                                           Padding="0,8"
                                           FontSize="13"
                                           TextColor="{DynamicResource TextSecondary}" />
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Analysis.Weight.SummaryMeanDisplay}"
                                           Padding="0,8"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End"
                                           TextColor="{DynamicResource TextPrimary}" />

                                    <!-- Median -->
                                    <Label Grid.Row="2" Grid.Column="0"
                                           Text="Median"
                                           Padding="0,8"
                                           FontSize="13"
                                           TextColor="{DynamicResource TextSecondary}" />
                                    <Label Grid.Row="2" Grid.Column="1"
                                           Text="{Binding Analysis.Weight.SummaryMedianDisplay}"
                                           Padding="0,8"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End"
                                           TextColor="{DynamicResource TextPrimary}" />

                                    <!-- Minimum -->
                                    <Label Grid.Row="3" Grid.Column="0"
                                           Text="Minimum"
                                           Padding="0,8"
                                           FontSize="13"
                                           TextColor="{DynamicResource TextSecondary}" />
                                    <Label Grid.Row="3" Grid.Column="1"
                                           Text="{Binding Analysis.Weight.SummaryMinDisplay}"
                                           Padding="0,8"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End"
                                           TextColor="{DynamicResource TextPrimary}" />

                                    <!-- Maximum -->
                                    <Label Grid.Row="4" Grid.Column="0"
                                           Text="Maximum"
                                           Padding="0,8"
                                           FontSize="13"
                                           TextColor="{DynamicResource TextSecondary}" />
                                    <Label Grid.Row="4" Grid.Column="1"
                                           Text="{Binding Analysis.Weight.SummaryMaxDisplay}"
                                           Padding="0,8"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End"
                                           TextColor="{DynamicResource TextPrimary}" />
                                </Grid>

                                <BoxView HeightRequest="1"
                                         BackgroundColor="{DynamicResource DividerColor}"
                                         Margin="0,2,0,0"
                                         IsVisible="{Binding Analysis.Weight.HasBaselineChange}" />

                                <Label Text="{Binding Analysis.Weight.BaselineChangeDisplay}"
                                       IsVisible="{Binding Analysis.Weight.HasBaselineChange}"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Weight.HasRecentChange}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Recent 7-Day Comparison" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Weight.RecentChangeDisplay}"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="Each period uses the median of distinct measurement days; at least two measured days are required in each 7-day block."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Weight.HasTrend}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Longitudinal Trend" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Weight.TrendDisplay}"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding Analysis.Weight.Trend.FitDisplay}"
                                       FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                <Label Text="This is a descriptive modeled pattern, not a judgment that weight gain or loss is beneficial or harmful."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Data Confidence" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Weight.DataSupport.SupportStateDisplay}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding Analysis.Weight.DataSupport.CoverageDisplay}"
                                       FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                                <Label Text="{Binding Analysis.Weight.UnavailableAnalysesDisplay}"
                                       IsVisible="{Binding Analysis.Weight.HasUnavailableAnalyses}"
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="WordWrap" Margin="0,6,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Weight.HasLimitations}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Interpretation Limits" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Weight.LimitationsDisplay}"
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding WeightPcpLine, Converter={StaticResource StringToBoolConverter}}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Care Team" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding WeightPcpLine}" FontSize="13"
                                       TextColor="{DynamicResource PrimaryAccent}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <!-- ==================== GLUCOSE TAB ==================== -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowGlucose}">

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding GlucoseSummary, Converter={StaticResource StringToBoolConverter}}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="💬  In Plain English" FontSize="13" FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding GlucoseSummary}"
                                       FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Glucose.HasLatest}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Latest Blood Glucose" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Glucose.LatestDisplay}"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding Analysis.Glucose.LatestContextDisplay}"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding Analysis.Glucose.Latest.RecordedAt, StringFormat='{0:MMM d, yyyy h:mm tt}'}"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Glucose.HasSummary}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="Logged Reading Summary"
                                           FontSize="11"
                                           TextColor="{DynamicResource PrimaryAccent}" />
                                    <Label Grid.Column="1"
                                           Text="mg/dL"
                                           FontSize="11"
                                           HorizontalTextAlignment="End"
                                           TextColor="{DynamicResource TextMuted}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*,*"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="8"
                                      RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="Mean"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{DynamicResource TextMuted}" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="Median"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{DynamicResource TextMuted}" />
                                    <Label Grid.Row="0" Grid.Column="2"
                                           Text="Min"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{DynamicResource TextMuted}" />
                                    <Label Grid.Row="0" Grid.Column="3"
                                           Text="Max"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{DynamicResource TextMuted}" />

                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding Analysis.Glucose.Summary.Mean, StringFormat='{0:F0}'}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{DynamicResource TextPrimary}" />
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Analysis.Glucose.Summary.Median, StringFormat='{0:F0}'}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{DynamicResource TextPrimary}" />
                                    <Label Grid.Row="1" Grid.Column="2"
                                           Text="{Binding Analysis.Glucose.Summary.Min, StringFormat='{0:F0}'}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{DynamicResource TextPrimary}" />
                                    <Label Grid.Row="1" Grid.Column="3"
                                           Text="{Binding Analysis.Glucose.Summary.Max, StringFormat='{0:F0}'}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{DynamicResource TextPrimary}" />
                                </Grid>

                                <Label Text="{Binding Analysis.Glucose.ContextCompletenessDisplay}"
                                       IsVisible="{Binding Analysis.Glucose.HasContextSummary}"
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Glucose.HasContextSummaries}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Context-Specific Summaries" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Glucose.ContextSummariesDisplay}"
                                       FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="Vitals compares glucose only within the same recorded context rather than mixing fasting, meal-related, bedtime, and random readings."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Glucose.HasContextTrends}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Context-Specific Trends" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Glucose.ContextTrendsDisplay}"
                                       FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="Trend calculations require repeated readings in the same measurement context over time."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Glucose.HasLowEvents}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Low Glucose Observations" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Glucose.LowEvents.RiskLabel}"
                                       IsVisible="{Binding Analysis.Glucose.LowEvents.HasLowReadings}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{Binding Analysis.Glucose.LowEvents.RiskColor}" />
                                <Label Text="{Binding Analysis.Glucose.LowEventsDisplay}"
                                       FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="Logged values below 70 mg/dL are identified for review. Vitals does not infer symptoms or severity beyond the recorded glucose value."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Glucose.HasGmi}">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="Glucose Management Indicator (GMI)" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Glucose.GmiValueDisplay}"
                                       FontSize="20" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding Analysis.Glucose.GmiMessageDisplay}"
                                       FontSize="12" TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding Analysis.Glucose.GmiRequirementDisplay}"
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap" />
                                <BoxView HeightRequest="1"
                                         BackgroundColor="{DynamicResource DividerColor}"
                                         Margin="0,2,0,0" />
                                <Label Text="{Binding Analysis.Glucose.Gmi.Disclosure}"
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Data Confidence" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Glucose.DataSupport.SupportStateDisplay}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="{Binding Analysis.Glucose.DataSupport.CoverageDisplay}"
                                       FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                                <Label Text="{Binding Analysis.Glucose.UnavailableAnalysesDisplay}"
                                       IsVisible="{Binding Analysis.Glucose.HasUnavailableAnalyses}"
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="WordWrap" Margin="0,6,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.Glucose.HasLimitations}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Interpretation Limits" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Glucose.LimitationsDisplay}"
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding GlucosePcpLine, Converter={StaticResource StringToBoolConverter}}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Care Team" FontSize="11"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding GlucosePcpLine}" FontSize="13"
                                       TextColor="{DynamicResource PrimaryAccent}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <!-- Status -->
                    <Label Text="{Binding StatusMessage}"
                           IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                           TextColor="#d32f2f"
                           FontSize="13"
                           HorizontalOptions="Center" />

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="1" Padding="16" BackgroundColor="{DynamicResource CardBackground}">
            <Button Text="✖  Close"
                    BackgroundColor="{DynamicResource ButtonSecondary}"
                    TextColor="{DynamicResource ButtonSecondaryText}"
                    FontSize="15"
                    HeightRequest="48"
                    CornerRadius="8"
                    Clicked="OnCloseClicked" />
        </Grid>
    </Grid>
</toolkit:Popup>
