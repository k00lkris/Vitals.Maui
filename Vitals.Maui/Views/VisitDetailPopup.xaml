<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
               x:Class="Vitals.Maui.Views.VisitDetailPopup"
               x:DataType="vm:VisitDetailViewModel">

    <Grid RowDefinitions="*,Auto"
          HeightRequest="680"
          WidthRequest="360"
          BackgroundColor="{DynamicResource CardBackground}">

        <ScrollView Grid.Row="0" Padding="16">
            <VerticalStackLayout Spacing="14">

                <!-- Doctor Picker -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Doctor" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                    <Label Text="{Binding SelectedDoctor.Name,
                               TargetNullValue='No doctor selected',
                               FallbackValue='No doctor selected'}"
                           FontSize="14" TextColor="{DynamicResource TextSecondary}"
                           IsVisible="{Binding IsEditing,
                               Converter={StaticResource InvertedBoolConverter}}" />
                    <Picker Title="Select doctor..."
                            TitleColor="{DynamicResource TextMuted}"
                            TextColor="{DynamicResource TextPrimary}"
                            BackgroundColor="{DynamicResource PageBackground}"
                            ItemsSource="{Binding PatientDoctors}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedDoctor}"
                            IsVisible="{Binding IsEditing}" />
                </VerticalStackLayout>

                <!-- Visit Date -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Visit Date" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                    <Label Text="{Binding VisitDate, StringFormat='{0:MMM d, yyyy h:mm tt}'}"
                           FontSize="14" TextColor="{DynamicResource TextSecondary}"
                           IsVisible="{Binding IsEditing,
                               Converter={StaticResource InvertedBoolConverter}}" />
                    <DatePicker Date="{Binding VisitDate}"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="{DynamicResource PageBackground}"
                                IsVisible="{Binding IsEditing}" />
                </VerticalStackLayout>

                <!-- Reason -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Reason for Visit" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                    <Label Text="{Binding Reason, TargetNullValue='—', FallbackValue='—'}"
                           FontSize="14" TextColor="{DynamicResource TextSecondary}"
                           LineBreakMode="WordWrap"
                           IsVisible="{Binding IsEditing,
                               Converter={StaticResource InvertedBoolConverter}}" />
                    <Entry Text="{Binding Reason}"
                           FontSize="14" TextColor="{DynamicResource TextPrimary}"
                           BackgroundColor="{DynamicResource PageBackground}"
                           Placeholder="Reason for visit"
                           PlaceholderColor="{DynamicResource TextMuted}"
                           IsVisible="{Binding IsEditing}" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                <!-- Vitals Snapshot (add mode only) -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsAddMode}">
                    <Label Text="Vitals Snapshot (optional)"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{DynamicResource PrimaryAccent}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Systolic" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                            <Entry Text="{Binding Systolic}" Keyboard="Numeric"
                                   TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="{DynamicResource PageBackground}"
                                   Placeholder="—" PlaceholderColor="{DynamicResource TextMuted}"
                                   FontSize="14" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Diastolic" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                            <Entry Text="{Binding Diastolic}" Keyboard="Numeric"
                                   TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="{DynamicResource PageBackground}"
                                   Placeholder="—" PlaceholderColor="{DynamicResource TextMuted}"
                                   FontSize="14" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Text="Heart Rate" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                            <Entry Text="{Binding HeartRate}" Keyboard="Numeric"
                                   TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="{DynamicResource PageBackground}"
                                   Placeholder="—" PlaceholderColor="{DynamicResource TextMuted}"
                                   FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="SpO₂ %" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                            <Entry Text="{Binding OxygenSaturation}" Keyboard="Numeric"
                                   TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="{DynamicResource PageBackground}"
                                   Placeholder="—" PlaceholderColor="{DynamicResource TextMuted}"
                                   FontSize="14" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Temp °F" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                            <Entry Text="{Binding Temperature}" Keyboard="Numeric"
                                   TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="{DynamicResource PageBackground}"
                                   Placeholder="—" PlaceholderColor="{DynamicResource TextMuted}"
                                   FontSize="14" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Text="Weight lbs" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                            <Entry Text="{Binding Weight}" Keyboard="Numeric"
                                   TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="{DynamicResource PageBackground}"
                                   Placeholder="—" PlaceholderColor="{DynamicResource TextMuted}"
                                   FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Glucose" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                            <Entry Text="{Binding BloodGlucose}" Keyboard="Numeric"
                                   TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="{DynamicResource PageBackground}"
                                   Placeholder="—" PlaceholderColor="{DynamicResource TextMuted}"
                                   FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />
                </VerticalStackLayout>

                <!-- Notes -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Notes" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                    <Label Text="{Binding Notes, TargetNullValue='—', FallbackValue='—'}"
                           FontSize="14" TextColor="{DynamicResource TextSecondary}"
                           LineBreakMode="WordWrap"
                           IsVisible="{Binding IsEditing,
                               Converter={StaticResource InvertedBoolConverter}}" />
                    <Editor Text="{Binding Notes}"
                            FontSize="14" TextColor="{DynamicResource TextPrimary}"
                            BackgroundColor="{DynamicResource PageBackground}"
                            Placeholder="Visit notes"
                            PlaceholderColor="{DynamicResource TextMuted}"
                            AutoSize="TextChanges" MinimumHeightRequest="80"
                            IsVisible="{Binding IsEditing}" />
                </VerticalStackLayout>

                <!-- Follow Up -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Follow Up" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                    <Label Text="{Binding DisplayFollowUp}"
                           FontSize="14" TextColor="{DynamicResource TextSecondary}"
                           IsVisible="{Binding IsEditing,
                               Converter={StaticResource InvertedBoolConverter}}" />
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsEditing}">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding HasFollowUp}"
                                  Color="{DynamicResource ButtonBackground}" />
                        <Label Grid.Column="1"
                               Text="Schedule follow up"
                               FontSize="13" TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center" />
                    </Grid>
                    <DatePicker Date="{Binding FollowUpDate}"
                                TextColor="{DynamicResource TextPrimary}"
                                BackgroundColor="{DynamicResource PageBackground}"
                                IsVisible="{Binding HasFollowUp}" />
                </VerticalStackLayout>

                <!-- Status -->
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage,
                           Converter={StaticResource StringToBoolConverter}}"
                       TextColor="#d32f2f" FontSize="13"
                       HorizontalOptions="Center" />

                <!-- Busy -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{DynamicResource PrimaryAccent}"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="1"
              Padding="16"
              BackgroundColor="{DynamicResource CardBackground}"
              ColumnDefinitions="*,*" ColumnSpacing="8">

            <Button Grid.Column="0" Text="✖  Close"
                    BackgroundColor="{DynamicResource ButtonSecondary}"
                    TextColor="{DynamicResource ButtonSecondaryText}"
                    FontSize="15" HeightRequest="48" CornerRadius="8"
                    IsVisible="{Binding IsEditing,
                        Converter={StaticResource InvertedBoolConverter}}"
                    Clicked="OnCloseClicked" />
            <Button Grid.Column="1" Text="✏️  Edit"
                    BackgroundColor="{DynamicResource ButtonBackground}"
                    TextColor="{DynamicResource TextPrimary}"
                    FontSize="15" HeightRequest="48" CornerRadius="8"
                    IsVisible="{Binding IsEditing,
                        Converter={StaticResource InvertedBoolConverter}}"
                    Command="{Binding StartEditCommand}" />
            <Button Grid.Column="0" Text="✖  Cancel"
                    BackgroundColor="{DynamicResource ButtonSecondary}"
                    TextColor="{DynamicResource ButtonSecondaryText}"
                    FontSize="15" HeightRequest="48" CornerRadius="8"
                    IsVisible="{Binding IsEditing}"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="1" Text="✅  Save"
                    BackgroundColor="{DynamicResource ButtonBackground}"
                    TextColor="{DynamicResource TextPrimary}"
                    FontSize="15" HeightRequest="48" CornerRadius="8"
                    IsVisible="{Binding IsEditing}"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</toolkit:Popup>
