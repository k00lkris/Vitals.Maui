<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Vitals.Maui.Views"
       x:Class="Vitals.Maui.AppShell"
       FlyoutBackgroundColor="{DynamicResource CardBackground}"
       FlyoutBehavior="Flyout"
       Shell.BackgroundColor="{DynamicResource CardBackground}"
       Shell.ForegroundColor="{DynamicResource ShellForeground}"
       Shell.TitleColor="{DynamicResource ShellTitle}">

    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="FlyoutItem">
                <Setter Property="Shell.ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Grid HeightRequest="44">
                                <Label Text="{Binding Title}"
                                       TextColor="{DynamicResource ShellForeground}"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       Margin="20,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- Flyout Header -->
    <Shell.FlyoutHeader>
        <Grid HeightRequest="180"
          BackgroundColor="#0f3460"
          Padding="24,40,24,16">
            <VerticalStackLayout VerticalOptions="End" Spacing="8">
                <Image Source="vitals_logo.png"
                   HeightRequest="48"
                   HorizontalOptions="Start"
                   Aspect="AspectFit" />
                <Label Text="Patient"
                   FontSize="12"
                   TextColor="#90caf9" />
                <Border Padding="10,8"
                    BackgroundColor="#16213e"
                    StrokeShape="RoundRectangle 8"
                    Stroke="#2a2a4a">
                    <Picker Title="Select Patient"
                        TitleColor="White"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        ItemsSource="{Binding Patients}"
                        SelectedItem="{Binding SelectedPatient}" />
                </Border>
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Home / Dashboard -->
    <FlyoutItem Title="🏠  Home"
                Route="Dashboard">
        <ShellContent
            ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <!-- Enter Vitals -->
    <FlyoutItem Title="➕  Enter Vitals"
                Route="VitalsEntry">
        <ShellContent
            ContentTemplate="{DataTemplate views:VitalsEntryPage}" />
    </FlyoutItem>

    <!-- Medications -->
    <FlyoutItem Title="💊  Medications"
                Route="Medications">
        <ShellContent
            ContentTemplate="{DataTemplate views:MedicationsPage}" />
    </FlyoutItem>

    <!-- Care Team -->
    <FlyoutItem Title="👨‍⚕️  Care Team"
                Route="CareTeam">
        <ShellContent
            ContentTemplate="{DataTemplate views:CareTeamPage}" />
    </FlyoutItem>

    <!-- Generate PDF -->
    <FlyoutItem Title="📄  Generate PDF"
                Route="GeneratePdf">
        <ShellContent
            ContentTemplate="{DataTemplate views:GeneratePdfPage}" />
    </FlyoutItem>

    <FlyoutItem Title="⚠️  Allergies"
            Route="Allergies">
        <ShellContent
            ContentTemplate="{DataTemplate views:AllergiesPage}" />
    </FlyoutItem>

    <!-- Vitals History -->
    <FlyoutItem Title="📋  Vitals History"
            Route="VitalsHistory">
        <ShellContent
            ContentTemplate="{DataTemplate views:VitalsHistoryPage}" />
    </FlyoutItem>

    <FlyoutItem Title="🏥  Visit Log"
            Route="VisitLog">
        <ShellContent
            ContentTemplate="{DataTemplate views:VisitLogPage}" />
    </FlyoutItem>

    <FlyoutItem Title="⚠️  Incident Log"
            Route="IncidentLog">
        <ShellContent
            ContentTemplate="{DataTemplate views:IncidentLogPage}" />
    </FlyoutItem>

    <FlyoutItem Title="📝  Notes"
            Route="Notes">
        <ShellContent
            ContentTemplate="{DataTemplate views:NotesPage}" />
    </FlyoutItem>

    <!-- Settings -->
    <FlyoutItem Title="⚙️  Settings"
                Route="Settings">
        <ShellContent
            ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>

    <!-- Flyout Footer -->
    <Shell.FlyoutFooter>
        <Grid Padding="24,16" BackgroundColor="#0f3460">
            <Label Text="Vitals v0.1 alpha"
               FontSize="11"
               TextColor="#666666"
               HorizontalOptions="Center" />
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
