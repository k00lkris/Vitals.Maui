<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             x:Class="Vitals.Maui.Views.OnboardingPatientSetupPage"
             x:DataType="vm:OnboardingPatientSetupViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource VitalsBluePageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <!-- Back -->
            <Button Text="←"
                    Command="{Binding BackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource VitalsBlueTextSecondary}"
                    FontSize="22"
                    HorizontalOptions="Start"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0" />

            <Label Text="{Binding Title}"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{StaticResource VitalsBlueTextPrimary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding Subtitle}"
                   FontSize="14"
                   TextColor="{StaticResource VitalsBlueTextSecondary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="16,0,16,8" />

            <!-- Form -->
            <Border Padding="16"
                    BackgroundColor="{StaticResource VitalsBlueCardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource VitalsBlueCardStroke}">
                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="First name" FontSize="13" TextColor="{StaticResource VitalsBlueTextSecondary}" />
                        <Entry Text="{Binding FirstName}"
                               Placeholder="First name"
                               TextColor="{StaticResource VitalsBlueTextPrimary}"
                               PlaceholderColor="{StaticResource VitalsBlueTextMuted}"
                               BackgroundColor="Transparent" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Last name" FontSize="13" TextColor="{StaticResource VitalsBlueTextSecondary}" />
                        <Entry Text="{Binding LastName}"
                               Placeholder="Last name"
                               TextColor="{StaticResource VitalsBlueTextPrimary}"
                               PlaceholderColor="{StaticResource VitalsBlueTextMuted}"
                               BackgroundColor="Transparent" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Date of birth" FontSize="13" TextColor="{StaticResource VitalsBlueTextSecondary}" />
                        <DatePicker Date="{Binding Dob}"
                                    TextColor="{StaticResource VitalsBlueTextPrimary}"
                                    BackgroundColor="Transparent" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Gender (optional)" FontSize="13" TextColor="{StaticResource VitalsBlueTextSecondary}" />
                        <Picker SelectedItem="{Binding Gender}"
                                TextColor="{StaticResource VitalsBlueTextPrimary}"
                                TitleColor="{StaticResource VitalsBlueTextMuted}"
                                Title="Select one"
                                BackgroundColor="Transparent">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Female</x:String>
                                    <x:String>Male</x:String>
                                    <x:String>Prefer not to say</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Height (optional)"
                               FontSize="13"
                               TextColor="{StaticResource VitalsBlueTextSecondary}" />
                        <Label Text="Used for weight-related calculations. You can update this later in Settings."
                               FontSize="11"
                               TextColor="{StaticResource VitalsBlueTextMuted}"
                               LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Grid.Column="0"
                                           Text="{Binding HeightFeet}"
                                           Placeholder="5"
                                           Keyboard="Numeric"
                                           MaxLength="1"
                                           TextColor="{StaticResource VitalsBlueTextPrimary}"
                                           PlaceholderColor="{StaticResource VitalsBlueTextMuted}"
                                           BackgroundColor="Transparent" />
                                    <Label Grid.Column="1"
                                           Text="ft"
                                           FontSize="13"
                                           TextColor="{StaticResource VitalsBlueTextSecondary}"
                                           VerticalOptions="Center"
                                           Margin="6,0,0,0" />
                                </Grid>
                                <BoxView HeightRequest="1" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Grid.Column="0"
                                           Text="{Binding HeightInches}"
                                           Placeholder="10"
                                           Keyboard="Numeric"
                                           MaxLength="2"
                                           TextColor="{StaticResource VitalsBlueTextPrimary}"
                                           PlaceholderColor="{StaticResource VitalsBlueTextMuted}"
                                           BackgroundColor="Transparent" />
                                    <Label Grid.Column="1"
                                           Text="in"
                                           FontSize="13"
                                           TextColor="{StaticResource VitalsBlueTextSecondary}"
                                           VerticalOptions="Center"
                                           Margin="6,0,0,0" />
                                </Grid>
                                <BoxView HeightRequest="1" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                   FontSize="13"
                   TextColor="#E57373"
                   HorizontalOptions="Center" />

            <Button Text="Continue"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{StaticResource VitalsBlueButtonBackground}"
                    TextColor="{StaticResource VitalsBlueTextPrimary}"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    CornerRadius="12"
                    Margin="0,8,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource VitalsBluePrimaryAccent}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
