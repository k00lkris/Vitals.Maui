<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             xmlns:models="clr-namespace:Vitals.Maui.Models"
             x:Class="Vitals.Maui.Views.IncidentLogPage"
             x:DataType="vm:IncidentLogViewModel"
             BackgroundColor="{DynamicResource PageBackground}">

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy}"
                 RefreshColor="{DynamicResource PrimaryAccent}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Header -->
                <Border Padding="16"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource CardStroke}">
                    <VerticalStackLayout Spacing="10">
                        <Label FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Incident Log — " TextColor="{DynamicResource PrimaryAccent}" />
                                    <Span Text="{Binding SelectedPatient.FullName,
                                              TargetNullValue='', FallbackValue=''}"
                                          TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <!-- Log Incident button keeps red — it's a semantic warning action -->
                        <Button Text="⚠️  Log Incident"
                                BackgroundColor="#d32f2f"
                                TextColor="White"
                                FontSize="13"
                                HeightRequest="44"
                                CornerRadius="8"
                                Command="{Binding OpenAddIncidentCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- No Incidents -->
                <Label Text="No incidents logged."
                       IsVisible="{Binding HasNoIncidents}"
                       FontSize="14" TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,16" />

                <!-- Incident List -->
                <Border Padding="16"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource CardStroke}"
                        IsVisible="{Binding HasNoIncidents,
                            Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="8">

                        <Label Text="⚠️  Incidents"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" Margin="0,0,0,8" />

                        <CollectionView ItemsSource="{Binding Incidents}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:IncidentLog">
                                    <Border Padding="12"
                                            Margin="0,0,0,8"
                                            BackgroundColor="{DynamicResource PageBackground}"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="{DynamicResource CardStroke}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- Severity indicator — semantic color from model, intentionally hardcoded -->
                                            <BoxView Grid.Column="0"
                                                     WidthRequest="4"
                                                     CornerRadius="2"
                                                     Margin="0,0,10,0"
                                                     VerticalOptions="Fill">
                                                <BoxView.Color>
                                                    <Binding Path="SeverityColor" />
                                                </BoxView.Color>
                                            </BoxView>

                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <Label Text="{Binding DisplayDate}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextPrimary}" />
                                                <Label Text="{Binding DisplayType}"
                                                       FontSize="13"
                                                       TextColor="{DynamicResource PrimaryAccent}" />
                                                <Label Text="{Binding Description}"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource TextMuted}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2"
                                                       IsVisible="{Binding Description,
                                                           Converter={StaticResource StringToBoolConverter}}" />
                                                <Border Padding="6,2"
                                                        BackgroundColor="{Binding SeverityColor}"
                                                        StrokeShape="RoundRectangle 4"
                                                        HorizontalOptions="Start">
                                                    <Label Text="{Binding DisplaySeverity}"
                                                           FontSize="11" FontAttributes="Bold"
                                                           TextColor="White" />
                                                </Border>
                                            </VerticalStackLayout>

                                            <Label Grid.Column="2"
                                                   Text="›"
                                                   FontSize="24"
                                                   TextColor="{DynamicResource PrimaryAccent}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:IncidentLogViewModel}},
                                                    Path=OpenIncidentDetailCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

                <!-- Status -->
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage,
                           Converter={StaticResource StringToBoolConverter}}"
                       TextColor="#d32f2f"
                       FontSize="13"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
