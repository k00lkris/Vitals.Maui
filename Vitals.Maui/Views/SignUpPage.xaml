<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             xmlns:controls="clr-namespace:Vitals.Maui.Controls"
             x:Class="Vitals.Maui.Views.SignUpPage"
             x:DataType="vm:SignUpViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource VitalsBluePageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Back -->
            <Button Text="←"
                    Command="{Binding BackToLoginCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource VitalsBlueTextSecondary}"
                    FontSize="22"
                    HorizontalOptions="Start"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0" />

            <!-- Logo + heading -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Image Source="vitals_logo.png" HeightRequest="56" HorizontalOptions="Center" />
                <Label Text="Create your account"
                       IsVisible="{Binding IsVerificationSent, Converter={StaticResource InvertedBoolConverter}}"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource VitalsBlueTextPrimary}"
                       HorizontalOptions="Center" />
                <Label Text="Almost there"
                       IsVisible="{Binding IsVerificationSent}"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource VitalsBlueTextPrimary}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- ============================================= -->
            <!-- Registration form — hidden once verification is sent -->
            <!-- ============================================= -->
            <VerticalStackLayout Spacing="20" IsVisible="{Binding IsVerificationSent, Converter={StaticResource InvertedBoolConverter}}">

                <Border Padding="16"
                        BackgroundColor="{StaticResource VitalsBlueCardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource VitalsBlueCardStroke}">
                    <VerticalStackLayout Spacing="12">

                        <Entry Placeholder="Full name"
                               Text="{Binding DisplayName}"
                               TextColor="{StaticResource VitalsBlueTextPrimary}"
                               PlaceholderColor="{StaticResource VitalsBlueTextMuted}"
                               BackgroundColor="Transparent" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />

                        <Entry Placeholder="Email address"
                               Text="{Binding Email}"
                               Keyboard="Email"
                               TextColor="{StaticResource VitalsBlueTextPrimary}"
                               PlaceholderColor="{StaticResource VitalsBlueTextMuted}"
                               BackgroundColor="Transparent" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />

                        <Entry Placeholder="Password (8+ characters)"
                               Text="{Binding Password}"
                               IsPassword="True"
                               TextColor="{StaticResource VitalsBlueTextPrimary}"
                               PlaceholderColor="{StaticResource VitalsBlueTextMuted}"
                               BackgroundColor="Transparent" />
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />

                        <Entry Placeholder="Confirm password"
                               Text="{Binding ConfirmPassword}"
                               IsPassword="True"
                               TextColor="{StaticResource VitalsBlueTextPrimary}"
                               PlaceholderColor="{StaticResource VitalsBlueTextMuted}"
                               BackgroundColor="Transparent" />

                        <Button Text="Create Account"
                                Command="{Binding CreateAccountCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="{StaticResource VitalsBlueButtonBackground}"
                                TextColor="{StaticResource VitalsBlueTextPrimary}"
                                FontSize="15"
                                FontAttributes="Bold"
                                HeightRequest="48"
                                CornerRadius="10" />

                    </VerticalStackLayout>
                </Border>

                <!-- Social sign-up -->
                <VerticalStackLayout Spacing="12">

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <BoxView HeightRequest="1" WidthRequest="60" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
                        <Label Text="or sign up with" FontSize="13" TextColor="{StaticResource VitalsBlueTextMuted}" />
                        <BoxView HeightRequest="1" WidthRequest="60" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
                    </HorizontalStackLayout>

                    <!-- Google — functional -->
                    <Button Text="Sign up with Google"
                            Command="{Binding SignUpWithGoogleCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            ImageSource="google_logo.png"
                            BackgroundColor="White"
                            TextColor="Black"
                            FontSize="15"
                            FontAttributes="Bold"
                            HeightRequest="52"
                            CornerRadius="10" />

                    <controls:AppleSignInButtonHost
                            IsVisible="{Binding IsAppleSignInAvailable}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            Command="{Binding SignUpWithAppleCommand}"
                            IsSignUp="True"
                            HeightRequest="52" />

                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- ============================================= -->
            <!-- Verification-sent confirmation — shown after successful -->
            <!-- registration instead of navigating anywhere, since the -->
            <!-- account isn't usable until the email link is clicked -->
            <!-- ============================================= -->
            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsVerificationSent}">

                <Border Padding="20"
                        BackgroundColor="{StaticResource VitalsBlueCardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource VitalsBlueCardStroke}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📧" FontSize="36" HorizontalOptions="Center" />
                        <Label Text="Check your email"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource VitalsBlueTextPrimary}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding Email, StringFormat='We sent a verification link to {0}. Click it, then come back and sign in.'}"
                               FontSize="14"
                               TextColor="{StaticResource VitalsBlueTextSecondary}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Resend email"
                        Command="{Binding ResendVerificationCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="{StaticResource VitalsBlueButtonSecondary}"
                        TextColor="{StaticResource VitalsBlueButtonSecondaryText}"
                        FontSize="14"
                        HeightRequest="44"
                        CornerRadius="10" />

                <Button Text="Back to Sign In"
                        Command="{Binding BackToLoginCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource VitalsBluePrimaryAccent}"
                        FontSize="14"
                        HeightRequest="40" />

            </VerticalStackLayout>

            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                   TextColor="#d32f2f"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontSize="13" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource VitalsBluePrimaryAccent}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
