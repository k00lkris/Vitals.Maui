<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             xmlns:models="clr-namespace:Vitals.Maui.Models"
             x:Class="Vitals.Maui.Views.AllergiesPage"
             x:DataType="vm:AllergiesViewModel"
             BackgroundColor="{DynamicResource PageBackground}">

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy}"
                 RefreshColor="{DynamicResource PrimaryAccent}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Header -->
                <Border Padding="16"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource CardStroke}">
                    <VerticalStackLayout Spacing="10">
                        <Label FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Allergies for " TextColor="{DynamicResource PrimaryAccent}" />
                                    <Span Text="{Binding SelectedPatient.FullName,
                                              TargetNullValue='',
                                              FallbackValue=''}"
                                          TextColor="{DynamicResource TextPrimary}"
                                          FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Button Text="➕  Add Allergy"
                                BackgroundColor="{DynamicResource ButtonBackground}"
                                TextColor="{DynamicResource TextPrimary}"
                                FontSize="13"
                                HeightRequest="44"
                                CornerRadius="8"
                                Command="{Binding OpenAddAllergyCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- No Allergies -->
                <Label Text="No known allergies on record."
                       IsVisible="{Binding HasNoAllergies}"
                       FontSize="14"
                       TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,16" />

                <!-- Allergies Card -->
                <Border Padding="16"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource CardStroke}"
                        IsVisible="{Binding HasNoAllergies,
                            Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="8">

                        <Label Text="⚠️  Allergies"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"
                               Margin="0,0,0,8" />

                        <!-- Medication Allergies -->
                        <VerticalStackLayout IsVisible="{Binding HasMedication}" Spacing="4">
                            <Label Text="💊  Medication"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryAccent}"
                                   Margin="0,8,0,4" />
                            <CollectionView ItemsSource="{Binding MedicationAllergies}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Allergy">
                                        <Grid ColumnDefinitions="*,Auto" Padding="8,8">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AllergiesViewModel}},
                                                        Path=OpenAllergyDetailCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Allergen}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextPrimary}" />
                                                <Label Text="{Binding Reaction}"
                                                       FontSize="13" FontAttributes="Italic"
                                                       TextColor="{DynamicResource TextMuted}"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1"
                                                    Padding="8,4"
                                                    BackgroundColor="{Binding SeverityColor}"
                                                    StrokeShape="RoundRectangle 6"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding SeverityDisplay}"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="White" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,4" />
                        </VerticalStackLayout>

                        <!-- Food Allergies -->
                        <VerticalStackLayout IsVisible="{Binding HasFood}" Spacing="4">
                            <Label Text="🍔  Food"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryAccent}"
                                   Margin="0,8,0,4" />
                            <CollectionView ItemsSource="{Binding FoodAllergies}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Allergy">
                                        <Grid ColumnDefinitions="*,Auto" Padding="8,8">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AllergiesViewModel}},
                                                        Path=OpenAllergyDetailCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Allergen}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextPrimary}" />
                                                <Label Text="{Binding Reaction}"
                                                       FontSize="13" FontAttributes="Italic"
                                                       TextColor="{DynamicResource TextMuted}"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1"
                                                    Padding="8,4"
                                                    BackgroundColor="{Binding SeverityColor}"
                                                    StrokeShape="RoundRectangle 6"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding SeverityDisplay}"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="White" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,4" />
                        </VerticalStackLayout>

                        <!-- Environmental Allergies -->
                        <VerticalStackLayout IsVisible="{Binding HasEnvironmental}" Spacing="4">
                            <Label Text="🌿  Environmental"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryAccent}"
                                   Margin="0,8,0,4" />
                            <CollectionView ItemsSource="{Binding EnvironmentalAllergies}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Allergy">
                                        <Grid ColumnDefinitions="*,Auto" Padding="8,8">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AllergiesViewModel}},
                                                        Path=OpenAllergyDetailCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Allergen}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextPrimary}" />
                                                <Label Text="{Binding Reaction}"
                                                       FontSize="13" FontAttributes="Italic"
                                                       TextColor="{DynamicResource TextMuted}"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1"
                                                    Padding="8,4"
                                                    BackgroundColor="{Binding SeverityColor}"
                                                    StrokeShape="RoundRectangle 6"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding SeverityDisplay}"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="White" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,4" />
                        </VerticalStackLayout>

                        <!-- Other Allergies -->
                        <VerticalStackLayout IsVisible="{Binding HasOther}" Spacing="4">
                            <Label Text="❓  Other"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryAccent}"
                                   Margin="0,8,0,4" />
                            <CollectionView ItemsSource="{Binding OtherAllergies}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Allergy">
                                        <Grid ColumnDefinitions="*,Auto" Padding="8,8">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AllergiesViewModel}},
                                                        Path=OpenAllergyDetailCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Allergen}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextPrimary}" />
                                                <Label Text="{Binding Reaction}"
                                                       FontSize="13" FontAttributes="Italic"
                                                       TextColor="{DynamicResource TextMuted}"
                                                       LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1"
                                                    Padding="8,4"
                                                    BackgroundColor="{Binding SeverityColor}"
                                                    StrokeShape="RoundRectangle 6"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding SeverityDisplay}"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="White" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Status -->
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage,
                           Converter={StaticResource StringToBoolConverter}}"
                       TextColor="#d32f2f"
                       FontSize="13"
                       HorizontalOptions="Center" />

                <!-- Busy -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{DynamicResource PrimaryAccent}"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
