<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             xmlns:models="clr-namespace:Vitals.Maui.Models"
             x:Class="Vitals.Maui.Views.VisitLogPage"
             x:DataType="vm:VisitLogViewModel"
             BackgroundColor="{DynamicResource PageBackground}">

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy}"
                 RefreshColor="{DynamicResource PrimaryAccent}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Header -->
                <Border Padding="16"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource CardStroke}">
                    <VerticalStackLayout Spacing="10">
                        <Label FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Visit Log — " TextColor="{DynamicResource PrimaryAccent}" />
                                    <Span Text="{Binding SelectedPatient.FullName,
                                              TargetNullValue='', FallbackValue=''}"
                                          TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Button Text="➕  Log Visit"
                                BackgroundColor="{DynamicResource ButtonBackground}"
                                TextColor="{DynamicResource TextPrimary}"
                                FontSize="13"
                                HeightRequest="44"
                                CornerRadius="8"
                                Command="{Binding OpenAddVisitCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- No Visits -->
                <Label Text="No visits logged yet."
                       IsVisible="{Binding HasNoVisits}"
                       FontSize="14" TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,16" />

                <!-- Visit List -->
                <Border Padding="16"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource CardStroke}"
                        IsVisible="{Binding HasNoVisits,
                            Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="8">

                        <Label Text="🏥  Visits"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" Margin="0,0,0,8" />

                        <CollectionView ItemsSource="{Binding Visits}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:VisitLog">
                                    <Border Padding="12"
                                            Margin="0,0,0,8"
                                            BackgroundColor="{DynamicResource PageBackground}"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="{DynamicResource CardStroke}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                <Label Text="{Binding DisplayDate}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextPrimary}" />
                                                <Label Text="{Binding DisplayDoctor}"
                                                       FontSize="13"
                                                       TextColor="{DynamicResource PrimaryAccent}" />
                                                <Label Text="{Binding Reason}"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource TextMuted}"
                                                       LineBreakMode="WordWrap"
                                                       IsVisible="{Binding Reason,
                                                           Converter={StaticResource StringToBoolConverter}}" />
                                                <Label Text="{Binding DisplayFollowUp,
                                                           StringFormat='Follow up: {0}'}"
                                                       FontSize="11"
                                                       TextColor="#f57c00"
                                                       IsVisible="{Binding FollowUpDate,
                                                           Converter={StaticResource StringToBoolConverter}}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="›"
                                                   FontSize="24"
                                                   TextColor="{DynamicResource PrimaryAccent}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VisitLogViewModel}},
                                                    Path=OpenVisitDetailCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

                <!-- Status -->
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage,
                           Converter={StaticResource StringToBoolConverter}}"
                       TextColor="#d32f2f"
                       FontSize="13"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
