<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="Vitals.Maui.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             BackgroundColor="#1a1a2e">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Patient Header Card -->
            <Border Padding="16"
                BackgroundColor="#16213e"
                StrokeShape="RoundRectangle 12"
                Stroke="#2a2a4a">
                <VerticalStackLayout Spacing="10">
                    <Label FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Dashboard — " TextColor="#90caf9" />
                                <Span Text="{Binding SelectedPatient.FullName}"
                                  TextColor="White"
                                  FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Button Text="➕  Enter Vitals"
                        BackgroundColor="#1976d2"
                        TextColor="White"
                        FontSize="15"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        CornerRadius="8"
                        Command="{Binding GoToVitalsEntryCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Latest Vitals Card -->

            <!-- Latest Vitals Card -->
            <Border Padding="16"
                    BackgroundColor="#16213e"
                    StrokeShape="RoundRectangle 12"
                    Stroke="#2a2a4a">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Latest Reading"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label Grid.Column="1"
                               Text="{Binding LatestRecordedAt}"
                               FontSize="11"
                               TextColor="#888888"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- BP -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🫀" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="Blood Pressure"
                               FontSize="15" TextColor="#e0e0e0"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding LatestBp}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="White" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />

                    <!-- HR -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="💓" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="Heart Rate"
                               FontSize="15" TextColor="#e0e0e0"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding LatestHeartRate}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="White" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />

                    <!-- SpO2 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🫁" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="SpO₂"
                               FontSize="15" TextColor="#e0e0e0"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding LatestSpo2}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="White" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />

                    <!-- Temperature -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🌡️" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="Temperature"
                               FontSize="15" TextColor="#e0e0e0"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding LatestTemperature}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="White" VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Average Vitals Card -->
            <Border Padding="16"
                    BackgroundColor="#16213e"
                    StrokeShape="RoundRectangle 12"
                    Stroke="#2a2a4a">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Averages"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <!-- Day selector buttons -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="15d"
                                BackgroundColor="{Binding Btn15Color}"
                                TextColor="White" FontSize="13"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectDaysCommand}"
                                CommandParameter="15" />
                        <Button Grid.Column="1" Text="30d"
                                BackgroundColor="{Binding Btn30Color}"
                                TextColor="White" FontSize="13"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectDaysCommand}"
                                CommandParameter="30" />
                        <Button Grid.Column="2" Text="45d"
                                BackgroundColor="{Binding Btn45Color}"
                                TextColor="White" FontSize="13"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectDaysCommand}"
                                CommandParameter="45" />
                        <Button Grid.Column="3" Text="60d"
                                BackgroundColor="{Binding Btn60Color}"
                                TextColor="White" FontSize="13"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectDaysCommand}"
                                CommandParameter="60" />
                    </Grid>

                    <!-- BP -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🫀" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="Blood Pressure"
                               FontSize="15" TextColor="#e0e0e0"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding AvgBp}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="White" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />

                    <!-- HR -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="💓" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="Heart Rate"
                               FontSize="15" TextColor="#e0e0e0"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding AvgHeartRate}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="White" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />

                    <!-- SpO2 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🫁" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="SpO₂"
                               FontSize="15" TextColor="#e0e0e0"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding AvgSpo2}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="White" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />

                    <!-- Temperature -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🌡️" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="Temperature"
                               FontSize="15" TextColor="#e0e0e0"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding AvgTemperature}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="White" VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Vitals Analysis + Charts -->
            <Border Padding="16"
        BackgroundColor="#16213e"
        StrokeShape="RoundRectangle 12"
        Stroke="#2a2a4a">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Vitals Analysis"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="White" />

                    <Label Text="Clinical trend analysis coming in a future update."
               FontSize="13"
               TextColor="#888888" />

                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />

                    <!-- Charts Toggle Button -->
                    <Button Text="{Binding ChartsToggleText}"
                BackgroundColor="#0f3460"
                TextColor="White"
                FontSize="14"
                HeightRequest="44"
                CornerRadius="8"
                Command="{Binding ToggleChartsCommand}" />

                    <!-- View History Button -->
                    <Button Text="📋  View History"
                        BackgroundColor="#0f3460"
                        TextColor="White"
                        FontSize="14"
                        HeightRequest="44"
                        CornerRadius="8"
                        Command="{Binding GoToVitalsHistoryCommand}" />

                    <!-- Charts Section -->
                    <VerticalStackLayout IsVisible="{Binding ChartsExpanded}"
                             Spacing="16">

                        <!-- Blood Pressure Chart -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Blood Pressure (mmHg)"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#90caf9" />
                            <lvc:CartesianChart
                    Series="{Binding BpSeries}"
                    XAxes="{Binding DateAxes}"
                    HeightRequest="200"
                    BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />

                        <!-- Heart Rate Chart -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Heart Rate (bpm)"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#90caf9" />
                            <lvc:CartesianChart
                    Series="{Binding HeartRateSeries}"
                    XAxes="{Binding DateAxes}"
                    HeightRequest="200"
                    BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />

                        <!-- SpO2 Chart -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="SpO₂ (%)"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#90caf9" />
                            <lvc:CartesianChart
                    Series="{Binding Spo2Series}"
                    XAxes="{Binding DateAxes}"
                    HeightRequest="200"
                    BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />

                        <!-- Temperature Chart -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Temperature (°F)"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#90caf9" />
                            <lvc:CartesianChart
                    Series="{Binding TempSeries}"
                    XAxes="{Binding DateAxes}"
                    HeightRequest="200"
                    BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Busy Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#90caf9"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>