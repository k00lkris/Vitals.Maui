<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             x:Class="Vitals.Maui.Views.OnboardingPlanSelectionPage"
             x:DataType="vm:OnboardingPlanSelectionViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource VitalsBluePageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <!-- Back -->
            <Button Text="←"
                    Command="{Binding BackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource VitalsBlueTextSecondary}"
                    FontSize="22"
                    HorizontalOptions="Start"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0" />

            <Label Text="Choose a plan — or decide later"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{StaticResource VitalsBlueTextPrimary}"
                   HorizontalOptions="Center" />

            <Label Text="Every new household gets 30 days of full Vitals access for up to 5 people. No payment method is required today. Choose the plan you expect to use, or decide later."
                   FontSize="13"
                   TextColor="{StaticResource VitalsBlueTextMuted}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="16,0,16,8" />

            <!-- Standard -->
            <Border Padding="18"
                    BackgroundColor="{Binding StandardCardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{Binding StandardCardColor}"
                    StrokeThickness="2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectStandardCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Standard" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource VitalsBlueTextPrimary}" />
                    <Label Text="$10/mo or $89/yr — full Vitals access for up to 2 people" FontSize="14" TextColor="{StaticResource VitalsBlueTextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <!-- Family -->
            <Border Padding="18"
                    BackgroundColor="{Binding FamilyCardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{Binding FamilyCardColor}"
                    StrokeThickness="2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectFamilyCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Family" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource VitalsBlueTextPrimary}" />
                    <Label Text="$20/mo or $189/yr — track up to 5 people" FontSize="14" TextColor="{StaticResource VitalsBlueTextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <!-- Decide Later / Full Trial -->
            <Border Padding="18"
                    BackgroundColor="{Binding TrialCardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{Binding TrialCardColor}"
                    StrokeThickness="2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectTrialCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Decide Later" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource VitalsBlueTextPrimary}" />
                    <Label Text="Start your 30-day full-access trial now. No payment method required — choose Standard or Family anytime during the trial." FontSize="14" TextColor="{StaticResource VitalsBlueTextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                   FontSize="13"
                   TextColor="#d32f2f"
                   HorizontalOptions="Center" />

            <Button Text="Continue"
                    Command="{Binding ContinueCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{StaticResource VitalsBlueButtonBackground}"
                    TextColor="{StaticResource VitalsBlueTextPrimary}"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    CornerRadius="12"
                    Margin="0,4,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource VitalsBluePrimaryAccent}"
                               HorizontalOptions="Center" />

            <!-- Join existing household -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,12,0,0">
                <BoxView HeightRequest="1" WidthRequest="60" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
                <Label Text="or" FontSize="13" TextColor="{StaticResource VitalsBlueTextMuted}" />
                <BoxView HeightRequest="1" WidthRequest="60" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
            </HorizontalStackLayout>

            <Button Text="I have an invite code — join a household"
                    Command="{Binding JoinExistingHouseholdCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource VitalsBluePrimaryAccent}"
                    FontSize="14"
                    FontAttributes="Bold"
                    HeightRequest="44" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
