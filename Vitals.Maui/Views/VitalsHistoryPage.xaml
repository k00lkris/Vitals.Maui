<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             xmlns:models="clr-namespace:Vitals.Maui.Models"
             x:Class="Vitals.Maui.Views.VitalsHistoryPage"
             x:DataType="vm:VitalsHistoryViewModel"
             BackgroundColor="{DynamicResource PageBackground}">

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy}"
                 RefreshColor="{DynamicResource PrimaryAccent}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Header -->
                <Border Padding="16"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource CardStroke}">
                    <VerticalStackLayout Spacing="10">
                        <Label FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Vitals History — " TextColor="{DynamicResource PrimaryAccent}" />
                                    <Span Text="{Binding SelectedPatient.FullName,
                                              TargetNullValue='',
                                              FallbackValue=''}"
                                          TextColor="{DynamicResource TextPrimary}"
                                          FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Day Range Buttons -->
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                            <Button Grid.Column="0" Text="15d"
                                    BackgroundColor="{Binding BtnDay15Color}"
                                    TextColor="{Binding BtnDay15TextColor}" FontSize="12"
                                    HeightRequest="36" CornerRadius="6"
                                    Command="{Binding SelectDaysCommand}"
                                    CommandParameter="15" />
                            <Button Grid.Column="1" Text="30d"
                                    BackgroundColor="{Binding BtnDay30Color}"
                                    TextColor="{Binding BtnDay30TextColor}" FontSize="12"
                                    HeightRequest="36" CornerRadius="6"
                                    Command="{Binding SelectDaysCommand}"
                                    CommandParameter="30" />
                            <Button Grid.Column="2" Text="45d"
                                    BackgroundColor="{Binding BtnDay45Color}"
                                    TextColor="{Binding BtnDay45TextColor}" FontSize="12"
                                    HeightRequest="36" CornerRadius="6"
                                    Command="{Binding SelectDaysCommand}"
                                    CommandParameter="45" />
                            <Button Grid.Column="3" Text="60d"
                                    BackgroundColor="{Binding BtnDay60Color}"
                                    TextColor="{Binding BtnDay60TextColor}" FontSize="12"
                                    HeightRequest="36" CornerRadius="6"
                                    Command="{Binding SelectDaysCommand}"
                                    CommandParameter="60" />
                            <Button Grid.Column="4"
                                    Text="{Binding CustomDaysLabel}"
                                    BackgroundColor="{Binding BtnCustomColor}"
                                    TextColor="{Binding BtnCustomTextColor}" FontSize="12"
                                    HeightRequest="36" CornerRadius="6"
                                    Clicked="OnCustomDaysClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- No Data -->
                <Label Text="No vitals recorded for this period."
                       IsVisible="{Binding HasNoData}"
                       FontSize="14"
                       TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,16" />

                <!-- Table -->
                <Border Padding="0"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource CardStroke}"
                        IsVisible="{Binding HasNoData,
                            Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout>

                        <!-- Header Row -->
                        <Grid ColumnDefinitions="90,70,55,55,60"
                              BackgroundColor="{DynamicResource ButtonBackground}"
                              Padding="8,10">
                            <Label Grid.Column="0"
                                   Text="Date"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" />
                            <Label Grid.Column="1"
                                   Text="BP"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="HR"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Grid.Column="3"
                                   Text="SpO₂"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   HorizontalOptions="Center" />
                            <Label Grid.Column="4"
                                   Text="Temp"
                                   FontSize="12" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   HorizontalOptions="Center" />
                        </Grid>

                        <!-- Data Rows -->
                        <CollectionView ItemsSource="{Binding Rows}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:VitalHistoryDisplay">
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="90,70,55,55,60"
                                              Padding="8,10">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Date}"
                                                   FontSize="11"
                                                   TextColor="{DynamicResource TextSecondary}"
                                                   LineBreakMode="WordWrap" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding Bp}"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="2"
                                                   Text="{Binding HeartRate}"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="3"
                                                   Text="{Binding Spo2}"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="4"
                                                   Text="{Binding Temperature}"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource TextPrimary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                        <BoxView HeightRequest="1"
                                                 BackgroundColor="{DynamicResource DividerColor}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

                <!-- Status -->
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage,
                           Converter={StaticResource StringToBoolConverter}}"
                       TextColor="#d32f2f"
                       FontSize="13"
                       HorizontalOptions="Center" />

                <!-- Busy -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{DynamicResource PrimaryAccent}"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
