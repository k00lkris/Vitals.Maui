<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="Vitals.Maui.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             BackgroundColor="{DynamicResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Patient Header Card -->
            <Border Padding="16"
                    BackgroundColor="{DynamicResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{DynamicResource CardStroke}">
                <VerticalStackLayout Spacing="10">
                    <Label FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Dashboard — " TextColor="{DynamicResource PrimaryAccent}" />
                                <Span Text="{Binding SelectedPatient.FullName}"
                                      TextColor="{DynamicResource TextPrimary}"
                                      FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Button Text="➕  Enter Vitals"
                            BackgroundColor="{DynamicResource ButtonBackground}"
                            TextColor="{DynamicResource TextPrimary}"
                            FontSize="15"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            CornerRadius="8"
                            Command="{Binding GoToVitalsEntryCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Latest Vitals Card -->
            <Border Padding="16"
                    BackgroundColor="{DynamicResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{DynamicResource CardStroke}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Latest Reading"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" />
                        <Label Grid.Column="1"
                               Text="{Binding LatestRecordedAt}"
                               FontSize="11"
                               TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- BP -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🫀" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="Blood Pressure"
                               FontSize="15" TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding LatestBp}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <!-- HR -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="💓" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="Heart Rate"
                               FontSize="15" TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding LatestHeartRate}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <!-- SpO2 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🫁" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="SpO₂"
                               FontSize="15" TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding LatestSpo2}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <!-- Temperature -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🌡️" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="Temperature"
                               FontSize="15" TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding LatestTemperature}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Average Vitals Card -->
            <Border Padding="16"
                    BackgroundColor="{DynamicResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{DynamicResource CardStroke}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Averages"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" />

                    <!-- Day selector buttons -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="15d"
                            BackgroundColor="{Binding BtnDay15Color}"
                            TextColor="{Binding BtnDay15TextColor}"
                            FontSize="13"
                            HeightRequest="36" CornerRadius="6"
                            Command="{Binding SelectDaysCommand}"
                            CommandParameter="15" />
                        <Button Grid.Column="1" Text="30d"
                            BackgroundColor="{Binding BtnDay30Color}"
                            TextColor="{Binding BtnDay30TextColor}"
                            FontSize="13"
                            HeightRequest="36" CornerRadius="6"
                            Command="{Binding SelectDaysCommand}"
                            CommandParameter="30" />
                        <Button Grid.Column="2" Text="45d"
                            BackgroundColor="{Binding BtnDay45Color}"
                            TextColor="{Binding BtnDay45TextColor}"
                            FontSize="13"
                            HeightRequest="36" CornerRadius="6"
                            Command="{Binding SelectDaysCommand}"
                            CommandParameter="45" />
                        <Button Grid.Column="3" Text="60d"
                            BackgroundColor="{Binding BtnDay60Color}"
                            TextColor="{Binding BtnDay60TextColor}"
                            FontSize="13"
                            HeightRequest="36" CornerRadius="6"
                            Command="{Binding SelectDaysCommand}"
                            CommandParameter="60" />
                    </Grid>

                    <!-- BP -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🫀" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="Blood Pressure"
                               FontSize="15" TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding AvgBp}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <!-- HR -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="💓" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="Heart Rate"
                               FontSize="15" TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding AvgHeartRate}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <!-- SpO2 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🫁" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="SpO₂"
                               FontSize="15" TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding AvgSpo2}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <!-- Temperature -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🌡️" FontSize="18"
                               VerticalOptions="Center" Margin="0,0,12,0"/>
                        <Label Grid.Column="1" Text="Temperature"
                               FontSize="15" TextColor="{DynamicResource TextSecondary}"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="2" Text="{Binding AvgTemperature}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Vitals Analysis + Charts -->
            <Border Padding="16"
                    BackgroundColor="{DynamicResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{DynamicResource CardStroke}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Vitals Analysis"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" />

                    <Button Text="📊  Vitals Analysis"
                            BackgroundColor="{DynamicResource ButtonBackground}"
                            TextColor="{DynamicResource TextPrimary}"
                            FontSize="15"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            CornerRadius="8"
                            Command="{Binding OpenVitalsAnalysisCommand}" />

                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <Button Text="{Binding ChartsToggleText}"
                            BackgroundColor="{DynamicResource ButtonBackground}"
                            TextColor="{DynamicResource TextPrimary}"
                            FontSize="14"
                            HeightRequest="44"
                            CornerRadius="8"
                            Command="{Binding ToggleChartsCommand}" />

                    <Button Text="📋  View History"
                            BackgroundColor="{DynamicResource ButtonBackground}"
                            TextColor="{DynamicResource TextPrimary}"
                            FontSize="14"
                            HeightRequest="44"
                            CornerRadius="8"
                            Command="{Binding GoToVitalsHistoryCommand}" />

                    <!-- Charts Section -->
                    <VerticalStackLayout IsVisible="{Binding ChartsExpanded}"
                                         Spacing="16">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Blood Pressure (mmHg)"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryAccent}" />
                            <lvc:CartesianChart
                                Series="{Binding BpSeries}"
                                XAxes="{Binding DateAxes}"
                                HeightRequest="200"
                                BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Heart Rate (bpm)"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryAccent}" />
                            <lvc:CartesianChart
                                Series="{Binding HeartRateSeries}"
                                XAxes="{Binding DateAxes}"
                                HeightRequest="200"
                                BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="SpO₂ (%)"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryAccent}" />
                            <lvc:CartesianChart
                                Series="{Binding Spo2Series}"
                                XAxes="{Binding DateAxes}"
                                HeightRequest="200"
                                BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Temperature (°F)"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryAccent}" />
                            <lvc:CartesianChart
                                Series="{Binding TempSeries}"
                                XAxes="{Binding DateAxes}"
                                HeightRequest="200"
                                BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Busy Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{DynamicResource PrimaryAccent}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
