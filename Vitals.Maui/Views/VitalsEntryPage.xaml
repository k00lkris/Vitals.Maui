<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             x:Class="Vitals.Maui.Views.VitalsEntryPage"
             x:DataType="vm:VitalsEntryViewModel"
             Title="Vitals"
             BackgroundColor="#1a1a2e">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Patient Card -->
            <Border Padding="16"
                    BackgroundColor="#16213e"
                    StrokeShape="RoundRectangle 12"
                    Stroke="#2a2a4a">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Patient"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Border Padding="12,10"
                            BackgroundColor="#0f3460"
                            StrokeShape="RoundRectangle 8"
                            Stroke="#1a4a8a">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0"
                                   Text="☰"
                                   FontSize="18"
                                   TextColor="#90caf9"
                                   VerticalOptions="Center"
                                   Margin="0,0,12,0" />
                            <Picker Grid.Column="1"
                                    Title="Select Patient"
                                    TitleColor="#90caf9"
                                    TextColor="White"
                                    ItemsSource="{Binding Patients}"
                                    SelectedItem="{Binding SelectedPatient}"
                                    ItemDisplayBinding="{Binding FullName}"
                                    BackgroundColor="Transparent" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Enter Vitals Card -->
            <Border Padding="16"
                    BackgroundColor="#16213e"
                    StrokeShape="RoundRectangle 12"
                    Stroke="#2a2a4a">
                <VerticalStackLayout Spacing="0">
                    <Label Text="Enter Vitals"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"
                           Margin="0,0,0,16" />

                    <!-- Systolic -->
                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />
                    <Grid Padding="4,14" ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Text="—•—"
                               FontSize="13"
                               TextColor="#90caf9"
                               VerticalOptions="Center"
                               Margin="0,0,12,0" />
                        <Label Grid.Column="1"
                               Text="Systolic (mmHg)"
                               FontSize="15"
                               TextColor="#e0e0e0"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="2"
                               Text="{Binding Systolic}"
                               Keyboard="Numeric"
                               HorizontalTextAlignment="End"
                               TextColor="White"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#666"
                               Placeholder="—"
                               WidthRequest="80" />
                    </Grid>

                    <!-- Diastolic -->
                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />
                    <Grid Padding="4,14" ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Text="—•—"
                               FontSize="13"
                               TextColor="#90caf9"
                               VerticalOptions="Center"
                               Margin="0,0,12,0" />
                        <Label Grid.Column="1"
                               Text="Diastolic (mmHg)"
                               FontSize="15"
                               TextColor="#e0e0e0"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="2"
                               Text="{Binding Diastolic}"
                               Keyboard="Numeric"
                               HorizontalTextAlignment="End"
                               TextColor="White"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#666"
                               Placeholder="—"
                               WidthRequest="80" />
                    </Grid>

                    <!-- Heart Rate -->
                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />
                    <Grid Padding="4,14" ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Text="—•—"
                               FontSize="13"
                               TextColor="#90caf9"
                               VerticalOptions="Center"
                               Margin="0,0,12,0" />
                        <Label Grid.Column="1"
                               Text="Heart Rate (bpm)"
                               FontSize="15"
                               TextColor="#e0e0e0"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="2"
                               Text="{Binding HeartRate}"
                               Keyboard="Numeric"
                               HorizontalTextAlignment="End"
                               TextColor="White"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#666"
                               Placeholder="—"
                               WidthRequest="80" />
                    </Grid>

                    <!-- SpO2 -->
                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />
                    <Grid Padding="4,14" ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Text="—•—"
                               FontSize="13"
                               TextColor="#90caf9"
                               VerticalOptions="Center"
                               Margin="0,0,12,0" />
                        <Label Grid.Column="1"
                               Text="SpO₂ (%)"
                               FontSize="15"
                               TextColor="#e0e0e0"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="2"
                               Text="{Binding OxygenSaturation}"
                               Keyboard="Numeric"
                               HorizontalTextAlignment="End"
                               TextColor="White"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#666"
                               Placeholder="—"
                               WidthRequest="80" />
                    </Grid>

                    <!-- Temperature -->
                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />
                    <Grid Padding="4,14" ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Text="—•—"
                               FontSize="13"
                               TextColor="#90caf9"
                               VerticalOptions="Center"
                               Margin="0,0,12,0" />
                        <Label Grid.Column="1"
                               Text="Temperature (°F)"
                               FontSize="15"
                               TextColor="#e0e0e0"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="2"
                               Text="{Binding Temperature}"
                               Keyboard="Numeric"
                               HorizontalTextAlignment="End"
                               TextColor="White"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#666"
                               Placeholder="—"
                               WidthRequest="80" />
                    </Grid>

                    <!-- Blood Glucose -->
                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />
                    <Grid Padding="4,14" ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Text="—•—"
                               FontSize="13"
                               TextColor="#90caf9"
                               VerticalOptions="Center"
                               Margin="0,0,12,0" />
                        <Label Grid.Column="1"
                               Text="Blood Glucose (mg/dL)"
                               FontSize="15"
                               TextColor="#e0e0e0"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="2"
                               Text="{Binding BloodGlucose}"
                               Keyboard="Numeric"
                               HorizontalTextAlignment="End"
                               TextColor="White"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#666"
                               Placeholder="—"
                               WidthRequest="80" />
                    </Grid>

                    <!-- Notes -->
                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />
                    <Grid Padding="4,14" ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Text="—•—"
                               FontSize="13"
                               TextColor="#90caf9"
                               VerticalOptions="Start"
                               Margin="0,2,12,0" />
                        <Editor Grid.Column="1"
                                Text="{Binding Notes}"
                                Placeholder="Notes (optional)"
                                PlaceholderColor="#666"
                                TextColor="White"
                                BackgroundColor="Transparent"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="44" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />

                </VerticalStackLayout>
            </Border>

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, 
                       Converter={StaticResource StringToBoolConverter}}"
                   TextColor="{Binding IsSuccess, 
                       Converter={StaticResource BoolToColorConverter}}"
                   HorizontalOptions="Center"
                   FontSize="14" />

            <!-- Submit Button -->
            <Border Padding="0"
                    BackgroundColor="#16213e"
                    StrokeShape="RoundRectangle 12"
                    Stroke="#2a2a4a">
                <VerticalStackLayout Spacing="8" Padding="16">
                    <Button Text="⬆  Submit Vitals"
                            Command="{Binding SubmitVitalsCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            HeightRequest="56" />
                    <BoxView HeightRequest="2"
                             BackgroundColor="White"
                             Margin="60,0"
                             HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <!-- Busy Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#90caf9"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>