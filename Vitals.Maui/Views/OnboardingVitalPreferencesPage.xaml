<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             x:Class="Vitals.Maui.Views.OnboardingVitalPreferencesPage"
             x:DataType="vm:OnboardingVitalPreferencesViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource VitalsBluePageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <!-- Back -->
            <Button Text="←"
                    Command="{Binding BackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource VitalsBlueTextSecondary}"
                    FontSize="22"
                    HorizontalOptions="Start"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0" />

            <Label Text="What do you want to track?"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{StaticResource VitalsBlueTextPrimary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding SelectedPatient.FullName, StringFormat='Tracking preferences for {0}'}"
                   FontSize="14" FontAttributes="Bold"
                   TextColor="{StaticResource VitalsBluePrimaryAccent}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Label Text="Blood pressure is always tracked. Choose anything else that's relevant — these choices control entry, dashboard, analysis, and reports, and can be changed anytime in Settings."
                   FontSize="14"
                   TextColor="{StaticResource VitalsBlueTextSecondary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="16,0,16,8" />

            <Border Padding="16"
                    BackgroundColor="{StaticResource VitalsBlueCardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource VitalsBlueCardStroke}">
                <VerticalStackLayout Spacing="0">

                    <!-- Blood Pressure — always on, no toggle -->
                    <Grid Padding="4,12" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="Blood Pressure" FontSize="15" TextColor="{StaticResource VitalsBlueTextPrimary}" />
                            <Label Text="Always tracked" FontSize="12" TextColor="{StaticResource VitalsBlueTextMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="✓" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource VitalsBluePrimaryAccent}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />

                    <Grid Padding="4,12" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Heart Rate" FontSize="15" TextColor="{StaticResource VitalsBlueTextPrimary}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ShowHeartRate}" OnColor="{StaticResource VitalsBluePrimaryAccent}" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />

                    <Grid Padding="4,12" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="SpO₂" FontSize="15" TextColor="{StaticResource VitalsBlueTextPrimary}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ShowSpo2}" OnColor="{StaticResource VitalsBluePrimaryAccent}" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />

                    <Grid Padding="4,12" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Temperature" FontSize="15" TextColor="{StaticResource VitalsBlueTextPrimary}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ShowTemperature}" OnColor="{StaticResource VitalsBluePrimaryAccent}" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />

                    <Grid Padding="4,12" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Weight" FontSize="15" TextColor="{StaticResource VitalsBlueTextPrimary}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ShowWeight}" OnColor="{StaticResource VitalsBluePrimaryAccent}" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />

                    <Grid Padding="4,12" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Blood Glucose" FontSize="15" TextColor="{StaticResource VitalsBlueTextPrimary}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ShowGlucose}" OnColor="{StaticResource VitalsBluePrimaryAccent}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Progress dots (5 of 6) -->
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,8,0,0">
                <BoxView HeightRequest="8" WidthRequest="8" CornerRadius="4" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
                <BoxView HeightRequest="8" WidthRequest="8" CornerRadius="4" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
                <BoxView HeightRequest="8" WidthRequest="8" CornerRadius="4" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
                <BoxView HeightRequest="8" WidthRequest="8" CornerRadius="4" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
                <BoxView HeightRequest="8" WidthRequest="24" CornerRadius="4" BackgroundColor="{StaticResource VitalsBluePrimaryAccent}" />
                <BoxView HeightRequest="8" WidthRequest="8" CornerRadius="4" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
            </HorizontalStackLayout>

            <Button Text="Continue"
                    Command="{Binding ContinueCommand}"
                    BackgroundColor="{StaticResource VitalsBlueButtonBackground}"
                    TextColor="{StaticResource VitalsBlueTextPrimary}"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    CornerRadius="12"
                    Margin="0,4,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
