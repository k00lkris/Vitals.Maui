<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             xmlns:models="clr-namespace:Vitals.Maui.Models"
             x:Class="Vitals.Maui.Views.VitalsHistoryPage"
             x:DataType="vm:VitalsHistoryViewModel"
             BackgroundColor="{DynamicResource PageBackground}">

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy}"
                 RefreshColor="{DynamicResource PrimaryAccent}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Header -->
                <Border Padding="16"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource CardStroke}">
                    <VerticalStackLayout Spacing="10">
                        <Label FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Vitals History — " TextColor="{DynamicResource PrimaryAccent}" />
                                    <Span Text="{Binding SelectedPatient.FullName,
                                              TargetNullValue='',
                                              FallbackValue=''}"
                                          TextColor="{DynamicResource TextPrimary}"
                                          FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Day Range Buttons -->
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                            <Button Grid.Column="0" Text="15d"
                                    BackgroundColor="{Binding BtnDay15Color}"
                                    TextColor="{Binding BtnDay15TextColor}" FontSize="12"
                                    HeightRequest="36" CornerRadius="6"
                                    Command="{Binding SelectDaysCommand}"
                                    CommandParameter="15" />
                            <Button Grid.Column="1" Text="30d"
                                    BackgroundColor="{Binding BtnDay30Color}"
                                    TextColor="{Binding BtnDay30TextColor}" FontSize="12"
                                    HeightRequest="36" CornerRadius="6"
                                    Command="{Binding SelectDaysCommand}"
                                    CommandParameter="30" />
                            <Button Grid.Column="2" Text="45d"
                                    BackgroundColor="{Binding BtnDay45Color}"
                                    TextColor="{Binding BtnDay45TextColor}" FontSize="12"
                                    HeightRequest="36" CornerRadius="6"
                                    Command="{Binding SelectDaysCommand}"
                                    CommandParameter="45" />
                            <Button Grid.Column="3" Text="60d"
                                    BackgroundColor="{Binding BtnDay60Color}"
                                    TextColor="{Binding BtnDay60TextColor}" FontSize="12"
                                    HeightRequest="36" CornerRadius="6"
                                    Command="{Binding SelectDaysCommand}"
                                    CommandParameter="60" />
                            <Button Grid.Column="4"
                                    Text="{Binding CustomDaysLabel}"
                                    BackgroundColor="{Binding BtnCustomColor}"
                                    TextColor="{Binding BtnCustomTextColor}" FontSize="12"
                                    HeightRequest="36" CornerRadius="6"
                                    Clicked="OnCustomDaysClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- No Data -->
                <Label Text="No vitals recorded for this period."
                       IsVisible="{Binding HasNoData}"
                       FontSize="14"
                       TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,16" />

                <!-- Table -->
                <Border Padding="0"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource CardStroke}"
                        IsVisible="{Binding HasNoData,
                            Converter={StaticResource InvertedBoolConverter}}">

                    <!-- One horizontal scroll surface keeps the header and every
                         row aligned when Weight/Glucose add more columns than a
                         portrait phone can comfortably display. Disabled patient
                         preferences collapse their columns entirely. -->
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Default">
                        <VerticalStackLayout Spacing="0">

                            <!-- Header Row -->
                            <HorizontalStackLayout
                                BackgroundColor="{DynamicResource ButtonBackground}"
                                Padding="8,10"
                                Spacing="0">
                                <Label Text="Date"
                                       WidthRequest="90"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}" />
                                <Label Text="BP"
                                       WidthRequest="70"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="HR"
                                       WidthRequest="55"
                                       IsVisible="{Binding ShowHeartRate}"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="SpO₂"
                                       WidthRequest="55"
                                       IsVisible="{Binding ShowSpo2}"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Temp"
                                       WidthRequest="60"
                                       IsVisible="{Binding ShowTemperature}"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Weight"
                                       WidthRequest="78"
                                       IsVisible="{Binding ShowWeight}"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Glucose"
                                       WidthRequest="88"
                                       IsVisible="{Binding ShowGlucose}"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="{DynamicResource TextPrimary}"
                                       HorizontalTextAlignment="Center" />
                            </HorizontalStackLayout>

                            <!-- Data Rows -->
                            <VerticalStackLayout
                                Spacing="0"
                                BindableLayout.ItemsSource="{Binding Rows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:VitalHistoryDisplay">
                                        <VerticalStackLayout Spacing="0">
                                            <HorizontalStackLayout Padding="8,10" Spacing="0">
                                                <Label Text="{Binding Date}"
                                                       WidthRequest="90"
                                                       FontSize="11"
                                                       TextColor="{DynamicResource TextSecondary}"
                                                       LineBreakMode="WordWrap" />
                                                <Label Text="{Binding Bp}"
                                                       WidthRequest="70"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource TextPrimary}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                                <Label Text="{Binding HeartRate}"
                                                       WidthRequest="55"
                                                       IsVisible="{Binding ShowHeartRate}"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource TextPrimary}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                                <Label Text="{Binding Spo2}"
                                                       WidthRequest="55"
                                                       IsVisible="{Binding ShowSpo2}"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource TextPrimary}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                                <Label Text="{Binding Temperature}"
                                                       WidthRequest="60"
                                                       IsVisible="{Binding ShowTemperature}"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource TextPrimary}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                                <Label Text="{Binding Weight}"
                                                       WidthRequest="78"
                                                       IsVisible="{Binding ShowWeight}"
                                                       FontSize="11"
                                                       TextColor="{DynamicResource TextPrimary}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                                <Label Text="{Binding Glucose}"
                                                       WidthRequest="88"
                                                       IsVisible="{Binding ShowGlucose}"
                                                       FontSize="11"
                                                       TextColor="{DynamicResource TextPrimary}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                            </HorizontalStackLayout>
                                            <BoxView HeightRequest="1"
                                                     BackgroundColor="{DynamicResource DividerColor}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </ScrollView>
                </Border>

                <!-- Status -->
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage,
                           Converter={StaticResource StringToBoolConverter}}"
                       TextColor="#d32f2f"
                       FontSize="13"
                       HorizontalOptions="Center" />

                <!-- Busy -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{DynamicResource PrimaryAccent}"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
