<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             xmlns:models="clr-namespace:Vitals.Maui.Models"
             x:Class="Vitals.Maui.Views.NotesPage"
             x:DataType="vm:NotesViewModel"
             BackgroundColor="{DynamicResource PageBackground}">

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy}"
                 RefreshColor="{DynamicResource PrimaryAccent}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Header -->
                <Border Padding="16"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource CardStroke}">
                    <VerticalStackLayout Spacing="10">
                        <Label FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Notes — " TextColor="{DynamicResource PrimaryAccent}" />
                                    <Span Text="{Binding SelectedPatient.FullName,
                                              TargetNullValue='', FallbackValue=''}"
                                          TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Button Text="📝  Add Note"
                                BackgroundColor="{DynamicResource ButtonBackground}"
                                TextColor="{DynamicResource TextPrimary}"
                                FontSize="13"
                                HeightRequest="44"
                                CornerRadius="8"
                                Command="{Binding OpenAddNoteCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- No Notes -->
                <Label Text="No notes recorded yet."
                       IsVisible="{Binding HasNoNotes}"
                       FontSize="14" TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,16" />

                <!-- Notes List -->
                <Border Padding="16"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource CardStroke}"
                        IsVisible="{Binding HasNoNotes,
                            Converter={StaticResource InvertedBoolConverter}}">
                    <VerticalStackLayout Spacing="8">

                        <Label Text="📝  Notes"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}" Margin="0,0,0,8" />

                        <CollectionView ItemsSource="{Binding Notes}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PatientNote">
                                    <Border Padding="12"
                                            Margin="0,0,0,8"
                                            BackgroundColor="{DynamicResource PageBackground}"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="{DynamicResource CardStroke}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- Type color indicator — semantic color from model -->
                                            <BoxView Grid.Column="0"
                                                     WidthRequest="4"
                                                     CornerRadius="2"
                                                     Margin="0,0,10,0"
                                                     VerticalOptions="Fill"
                                                     Color="{Binding TypeColor}" />

                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <Label Text="{Binding DisplayTitle}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextPrimary}" />
                                                <Label Text="{Binding DisplayType}"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource PrimaryAccent}" />
                                                <Label Text="{Binding Body}"
                                                       FontSize="12"
                                                       TextColor="{DynamicResource TextMuted}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2"
                                                       IsVisible="{Binding Body,
                                                           Converter={StaticResource StringToBoolConverter}}" />
                                                <Label Text="{Binding DisplayDate}"
                                                       FontSize="11"
                                                       TextColor="{DynamicResource TextMuted}" />
                                            </VerticalStackLayout>

                                            <Label Grid.Column="2"
                                                   Text="›"
                                                   FontSize="24"
                                                   TextColor="{DynamicResource PrimaryAccent}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotesViewModel}},
                                                    Path=OpenNoteDetailCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

                <!-- Status -->
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage,
                           Converter={StaticResource StringToBoolConverter}}"
                       TextColor="#d32f2f"
                       FontSize="13"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
