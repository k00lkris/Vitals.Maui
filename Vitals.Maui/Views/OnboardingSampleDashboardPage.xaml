<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             x:Class="Vitals.Maui.Views.OnboardingSampleDashboardPage"
             x:DataType="vm:OnboardingSampleDashboardViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Back + Example banner -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                <Button Grid.Column="0"
                        Text="←"
                        Command="{Binding BackCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource TextSecondary}"
                        FontSize="22"
                        WidthRequest="44"
                        HeightRequest="44"
                        Padding="0" />
                <Label Grid.Column="1"
                       Text="{Binding StepIndicatorText}"
                       FontSize="13"
                       TextColor="{DynamicResource TextMuted}"
                       HorizontalOptions="End"
                       VerticalOptions="Center" />
            </Grid>

            <Border Padding="8,4"
                    BackgroundColor="#3A2E00"
                    StrokeShape="RoundRectangle 8"
                    Stroke="Transparent"
                    HorizontalOptions="Center"
                    Margin="0,0,0,4">
                <Label Text="EXAMPLE DASHBOARD — this is what yours will look like"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="#FFD54F" />
            </Border>

            <!-- Header / Enter Vitals Card -->
            <Border Padding="16"
                    Opacity="{Binding HeaderOpacity}"
                    BackgroundColor="{DynamicResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{Binding HeaderStroke}"
                    StrokeThickness="2">
                <VerticalStackLayout Spacing="10">
                    <Label FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Dashboard — " TextColor="{DynamicResource PrimaryAccent}" />
                                <Span Text="You" TextColor="{DynamicResource TextPrimary}" FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Button Text="➕  Enter Vitals"
                            BackgroundColor="{DynamicResource ButtonBackground}"
                            TextColor="{DynamicResource TextPrimary}"
                            FontSize="15"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            CornerRadius="8" />
                </VerticalStackLayout>
            </Border>

            <!-- Tooltip: Header -->
            <Border IsVisible="{Binding ShowHeaderTooltip}"
                    Padding="14"
                    BackgroundColor="#1976d2"
                    StrokeShape="RoundRectangle 10"
                    Stroke="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding TourTitle}" FontSize="15" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding TourDescription}" FontSize="13" TextColor="#E3F2FD" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Skip tour" FontSize="12" TextColor="#BBDEFB" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SkipTourCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Button Grid.Column="1" Text="{Binding TourButtonText}"
                                Command="{Binding NextStepCommand}"
                                BackgroundColor="White" TextColor="#1976d2"
                                FontAttributes="Bold" FontSize="13"
                                HeightRequest="38" WidthRequest="90" CornerRadius="8" Padding="0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Latest Vitals Card -->
            <Border Padding="16"
                    Opacity="{Binding LatestReadingOpacity}"
                    BackgroundColor="{DynamicResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{Binding LatestReadingStroke}"
                    StrokeThickness="2">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Latest Reading" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                        <Label Grid.Column="1" Text="Today, 8:15 AM" FontSize="11" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🫀" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0" />
                        <Label Grid.Column="1" Text="Blood Pressure" FontSize="15" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="122/78" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="💓" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0" />
                        <Label Grid.Column="1" Text="Heart Rate" FontSize="15" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="72 bpm" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🫁" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0" />
                        <Label Grid.Column="1" Text="SpO₂" FontSize="15" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="97%" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🌡️" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0" />
                        <Label Grid.Column="1" Text="Temperature" FontSize="15" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="98.4 °F" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Tooltip: Latest Reading -->
            <Border IsVisible="{Binding ShowLatestReadingTooltip}"
                    Padding="14"
                    BackgroundColor="#1976d2"
                    StrokeShape="RoundRectangle 10"
                    Stroke="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding TourTitle}" FontSize="15" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding TourDescription}" FontSize="13" TextColor="#E3F2FD" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Skip tour" FontSize="12" TextColor="#BBDEFB" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SkipTourCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Button Grid.Column="1" Text="{Binding TourButtonText}"
                                Command="{Binding NextStepCommand}"
                                BackgroundColor="White" TextColor="#1976d2"
                                FontAttributes="Bold" FontSize="13"
                                HeightRequest="38" WidthRequest="90" CornerRadius="8" Padding="0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Average Vitals Card -->
            <Border Padding="16"
                    Opacity="{Binding AveragesOpacity}"
                    BackgroundColor="{DynamicResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{Binding AveragesStroke}"
                    StrokeThickness="2">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Averages" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="15d" BackgroundColor="{DynamicResource ButtonBackground}" TextColor="{DynamicResource TextPrimary}" FontSize="13" HeightRequest="36" CornerRadius="6" />
                        <Button Grid.Column="1" Text="30d" BackgroundColor="{DynamicResource ButtonSecondary}" TextColor="{DynamicResource ButtonSecondaryText}" FontSize="13" HeightRequest="36" CornerRadius="6" />
                        <Button Grid.Column="2" Text="45d" BackgroundColor="{DynamicResource ButtonSecondary}" TextColor="{DynamicResource ButtonSecondaryText}" FontSize="13" HeightRequest="36" CornerRadius="6" />
                        <Button Grid.Column="3" Text="60d" BackgroundColor="{DynamicResource ButtonSecondary}" TextColor="{DynamicResource ButtonSecondaryText}" FontSize="13" HeightRequest="36" CornerRadius="6" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🫀" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0" />
                        <Label Grid.Column="1" Text="Blood Pressure" FontSize="15" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="124/79" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="💓" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0" />
                        <Label Grid.Column="1" Text="Heart Rate" FontSize="15" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="73 bpm" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🫁" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0" />
                        <Label Grid.Column="1" Text="SpO₂" FontSize="15" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="96.8%" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="🌡️" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0" />
                        <Label Grid.Column="1" Text="Temperature" FontSize="15" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="98.6 °F" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Tooltip: Averages -->
            <Border IsVisible="{Binding ShowAveragesTooltip}"
                    Padding="14"
                    BackgroundColor="#1976d2"
                    StrokeShape="RoundRectangle 10"
                    Stroke="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding TourTitle}" FontSize="15" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding TourDescription}" FontSize="13" TextColor="#E3F2FD" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Skip tour" FontSize="12" TextColor="#BBDEFB" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SkipTourCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Button Grid.Column="1" Text="{Binding TourButtonText}"
                                Command="{Binding NextStepCommand}"
                                BackgroundColor="White" TextColor="#1976d2"
                                FontAttributes="Bold" FontSize="13"
                                HeightRequest="38" WidthRequest="90" CornerRadius="8" Padding="0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Vitals Analysis + Charts Card -->
            <Border Padding="16"
                    Opacity="{Binding AnalysisOpacity}"
                    BackgroundColor="{DynamicResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{Binding AnalysisStroke}"
                    StrokeThickness="2">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Vitals Analysis" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />

                    <Button Text="📊  Vitals Analysis"
                            BackgroundColor="{DynamicResource ButtonBackground}"
                            TextColor="{DynamicResource TextPrimary}"
                            FontSize="15" FontAttributes="Bold"
                            HeightRequest="48" CornerRadius="8" />

                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <Button Text="📈  Expand Charts"
                            BackgroundColor="{DynamicResource ButtonBackground}"
                            TextColor="{DynamicResource TextPrimary}"
                            FontSize="14"
                            HeightRequest="44" CornerRadius="8" />

                    <Button Text="📋  View History"
                            BackgroundColor="{DynamicResource ButtonBackground}"
                            TextColor="{DynamicResource TextPrimary}"
                            FontSize="14"
                            HeightRequest="44" CornerRadius="8" />
                </VerticalStackLayout>
            </Border>

            <!-- Tooltip: Analysis -->
            <Border IsVisible="{Binding ShowAnalysisTooltip}"
                    Padding="14"
                    BackgroundColor="#1976d2"
                    StrokeShape="RoundRectangle 10"
                    Stroke="Transparent">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding TourTitle}" FontSize="15" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding TourDescription}" FontSize="13" TextColor="#E3F2FD" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text=" " FontSize="12" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{Binding TourButtonText}"
                                Command="{Binding NextStepCommand}"
                                BackgroundColor="White" TextColor="#1976d2"
                                FontAttributes="Bold" FontSize="13"
                                HeightRequest="38" WidthRequest="110" CornerRadius="8" Padding="0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
