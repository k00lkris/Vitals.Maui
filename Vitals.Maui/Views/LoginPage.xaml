<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             xmlns:controls="clr-namespace:Vitals.Maui.Controls"
             x:Class="Vitals.Maui.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{StaticResource VitalsBluePageBackground}">

    <VerticalStackLayout VerticalOptions="Center"
                         HorizontalOptions="Center"
                         Spacing="24"
                         Padding="32">

        <!-- Logo / Title -->
        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
            <Image Source="vitals_logo"
               HeightRequest="120"
               HorizontalOptions="Center"
               Aspect="AspectFit" />
            <Label Text="Clinical clarity for the people who care most."
               FontSize="15"
               TextColor="{StaticResource VitalsBlueTextMuted}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Email / password -->
        <VerticalStackLayout Spacing="12" WidthRequest="280">
            <Entry Placeholder="Email address"
                   Text="{Binding Email}"
                   Keyboard="Email"
                   TextColor="{StaticResource VitalsBlueTextPrimary}"
                   PlaceholderColor="{StaticResource VitalsBlueTextMuted}"
                   BackgroundColor="{StaticResource VitalsBlueCardBackground}" />
            <Entry Placeholder="Password"
                   Text="{Binding Password}"
                   IsPassword="True"
                   TextColor="{StaticResource VitalsBlueTextPrimary}"
                   PlaceholderColor="{StaticResource VitalsBlueTextMuted}"
                   BackgroundColor="{StaticResource VitalsBlueCardBackground}" />
            <Button Text="Sign In"
                    Command="{Binding SignInWithEmailCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{StaticResource VitalsBlueButtonBackground}"
                    TextColor="{StaticResource VitalsBlueTextPrimary}"
                    FontSize="15"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    CornerRadius="10" />
        </VerticalStackLayout>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
            <BoxView HeightRequest="1" WidthRequest="60" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
            <Label Text="or" FontSize="13" TextColor="{StaticResource VitalsBlueTextMuted}" />
            <BoxView HeightRequest="1" WidthRequest="60" BackgroundColor="{StaticResource VitalsBlueDividerColor}" />
        </HorizontalStackLayout>

        <!-- Sign In Buttons -->
        <Button Text="  Sign in with Google"
            BackgroundColor="White"
            TextColor="#3c4043"
            FontSize="16"
            FontAttributes="Bold"
            HeightRequest="54"
            CornerRadius="10"
            Command="{Binding SignInWithGoogleCommand}">
            <Button.ImageSource>
                <FileImageSource File="google_logo" />
            </Button.ImageSource>
        </Button>

        <controls:AppleSignInButtonHost
            IsVisible="{Binding IsAppleSignInAvailable}"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
            Command="{Binding SignInWithAppleCommand}"
            IsSignUp="False"
            HeightRequest="54" />

        <!-- New to Vitals? -->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
            <Label Text="New to Vitals?"
                   FontSize="14"
                   TextColor="{StaticResource VitalsBlueTextSecondary}"
                   VerticalOptions="Center" />
            <Button Text="Sign up here"
                    Command="{Binding NavigateToSignUpCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource VitalsBluePrimaryAccent}"
                    FontSize="14"
                    FontAttributes="Bold"
                    Padding="0"
                    BorderWidth="0" />
        </HorizontalStackLayout>

        <!-- Status -->
        <Label Text="{Binding StatusMessage}"
               IsVisible="{Binding StatusMessage,
                   Converter={StaticResource StringToBoolConverter}}"
               TextColor="#d32f2f"
               FontSize="13"
               HorizontalOptions="Center" />

        <!-- Resend verification — only shown when a login attempt failed
             specifically because the account isn't verified yet. This is
             the only way back to a resend option from here, since the
             user is on Login, not Sign Up, at this point. -->
        <Button Text="Resend verification email"
                Command="{Binding ResendVerificationCommand}"
                IsVisible="{Binding ShowResendVerification}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="Transparent"
                TextColor="{StaticResource VitalsBluePrimaryAccent}"
                FontSize="14"
                FontAttributes="Bold"
                Padding="0"
                BorderWidth="0"
                HorizontalOptions="Center" />

        <!-- Busy -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource VitalsBluePrimaryAccent}"
                           HorizontalOptions="Center" />

        <!-- Version -->
        <Label Text="Vitals v0.69 alpha"
               FontSize="11"
               TextColor="{StaticResource VitalsBlueTextMuted}"
               HorizontalOptions="Center"
               Margin="0,32,0,0" />

    </VerticalStackLayout>
</ContentPage>