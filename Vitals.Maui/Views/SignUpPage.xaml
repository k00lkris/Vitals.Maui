<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             x:Class="Vitals.Maui.Views.SignUpPage"
             x:DataType="vm:SignUpViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBackground}">

    <ScrollView>
        <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="24">

            <!-- Back -->
            <Button Grid.Row="0"
                    Text="←"
                    Command="{Binding BackToLoginCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource TextSecondary}"
                    FontSize="22"
                    HorizontalOptions="Start"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0" />

            <!-- Logo + heading -->
            <VerticalStackLayout Grid.Row="1" Spacing="8" HorizontalOptions="Center">
                <Image Source="vitals_logo.png" HeightRequest="56" HorizontalOptions="Center" />
                <Label Text="Create your account"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Email / password (disabled placeholder — no backend yet) -->
            <Border Grid.Row="2"
                    Padding="16"
                    BackgroundColor="{DynamicResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{DynamicResource CardStroke}">
                <VerticalStackLayout Spacing="12">

                    <Entry Placeholder="Email address"
                           Text="{Binding Email}"
                           IsEnabled="False"
                           Keyboard="Email"
                           TextColor="{DynamicResource TextPrimary}"
                           PlaceholderColor="{DynamicResource TextMuted}"
                           BackgroundColor="Transparent" />
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <Entry Placeholder="Password"
                           Text="{Binding Password}"
                           IsEnabled="False"
                           IsPassword="True"
                           TextColor="{DynamicResource TextPrimary}"
                           PlaceholderColor="{DynamicResource TextMuted}"
                           BackgroundColor="Transparent" />
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <Entry Placeholder="Confirm password"
                           Text="{Binding ConfirmPassword}"
                           IsEnabled="False"
                           IsPassword="True"
                           TextColor="{DynamicResource TextPrimary}"
                           PlaceholderColor="{DynamicResource TextMuted}"
                           BackgroundColor="Transparent" />

                    <Button Text="Create Account"
                            IsEnabled="False"
                            BackgroundColor="{DynamicResource ButtonSecondary}"
                            TextColor="{DynamicResource ButtonSecondaryText}"
                            FontSize="15"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            CornerRadius="10" />

                    <Label Text="Email sign-up is coming soon — use Google for now."
                           FontSize="12"
                           TextColor="{DynamicResource TextMuted}"
                           HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Border>

            <!-- Spacer -->
            <BoxView Grid.Row="3" Opacity="0" />

            <!-- Social sign-up -->
            <VerticalStackLayout Grid.Row="4" Spacing="12">

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <BoxView HeightRequest="1" WidthRequest="60" BackgroundColor="{DynamicResource DividerColor}" />
                    <Label Text="or sign up with" FontSize="13" TextColor="{DynamicResource TextMuted}" />
                    <BoxView HeightRequest="1" WidthRequest="60" BackgroundColor="{DynamicResource DividerColor}" />
                </HorizontalStackLayout>

                <!-- Google — functional -->
                <Button Text="Sign up with Google"
                        Command="{Binding SignUpWithGoogleCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        ImageSource="google_logo.png"
                        BackgroundColor="White"
                        TextColor="Black"
                        FontSize="15"
                        FontAttributes="Bold"
                        HeightRequest="52"
                        CornerRadius="10" />

                <!-- Apple ID — disabled placeholder until Apple Developer
                     Program enrollment + Sign in with Apple implementation -->
                <Button Text="Sign up with Apple ID"
                        IsEnabled="False"
                        BackgroundColor="{DynamicResource ButtonSecondary}"
                        TextColor="{DynamicResource ButtonSecondaryText}"
                        FontSize="15"
                        FontAttributes="Bold"
                        HeightRequest="52"
                        CornerRadius="10" />

                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                       TextColor="{DynamicResource TileCriticalBg}"
                       HorizontalOptions="Center"
                       FontSize="13" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{DynamicResource PrimaryAccent}"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>

        </Grid>
    </ScrollView>
</ContentPage>
