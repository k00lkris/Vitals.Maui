<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
               xmlns:models="clr-namespace:Vitals.Maui.Models"
               x:Class="Vitals.Maui.Views.DoctorDetailPopup"
               x:DataType="vm:DoctorDetailViewModel">

    <Grid RowDefinitions="*,Auto"
          HeightRequest="640"
          WidthRequest="360"
          BackgroundColor="#1a1a2e">

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="0" Padding="16">
            <VerticalStackLayout Spacing="16">
                <!-- Existing Doctors Section (Add mode only) -->
                <VerticalStackLayout IsVisible="{Binding ShowExistingDoctors}" Spacing="12">
                    <Label Text="Select an existing doctor to add to this patient's care team:"
                       FontSize="13"
                       TextColor="#90caf9" />

                                <Picker Title="Select a doctor..."
                        TitleColor="#666666"
                        TextColor="White"
                        BackgroundColor="#0f3460"
                        ItemsSource="{Binding HouseholdDoctors}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedHouseholdDoctor}" />

                                <!-- PCP toggle for existing doctor -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                           Text="Set as Primary Care Provider"
                           FontSize="13"
                           TextColor="#90caf9"
                           VerticalOptions="Center" />
                                    <Switch Grid.Column="1"
                            IsToggled="{Binding IsPrimary}"
                            OnColor="#1976d2" />
                                </Grid>

                                <Button Text="✅  Link Doctor to Patient"
                        BackgroundColor="#1976d2"
                        TextColor="White"
                        FontSize="13"
                        HeightRequest="44"
                        CornerRadius="8"
                        Command="{Binding LinkSelectedDoctorCommand}"
                        IsEnabled="{Binding IsBusy,
                            Converter={StaticResource InvertedBoolConverter}}" />

                                <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />

                                <Button Text="➕  Add New Doctor Instead"
                        BackgroundColor="#0f3460"
                        TextColor="White"
                        FontSize="13"
                        HeightRequest="44"
                        CornerRadius="8"
                        Command="{Binding ShowNewFormCommand}" />

                    <!-- Status and busy for both modes -->
                    <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage,
                           Converter={StaticResource StringToBoolConverter}}"
                       TextColor="#d32f2f"
                       FontSize="13"
                       HorizontalOptions="Center" />

                                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#90caf9"
                        HorizontalOptions="Center" />
                    <!-- Close button for existing doctors mode -->
                    <Button Text="✖  Close"
                        BackgroundColor="#0f3460"
                        TextColor="White"
                        FontSize="13"
                        HeightRequest="44"
                        CornerRadius="8"
                        Clicked="OnCloseClicked" />
                </VerticalStackLayout>
                <!-- New Doctor Form -->
                <VerticalStackLayout IsVisible="{Binding ShowNewDoctorForm}" Spacing="16">
                        <!-- Back button (shown when new form is visible in add mode) -->
                    <Button Text="← Back to Existing Doctors"
                        BackgroundColor="Transparent"
                        TextColor="#90caf9"
                        FontSize="12"
                        HeightRequest="36"
                        IsVisible="{Binding ShowBackButton}"
                        Command="{Binding BackToExistingCommand}" />
                    <!-- Name + Primary Badge -->
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Read-only name -->
                        <Label Grid.Column="0"
                               Text="{Binding Name}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center"
                               IsVisible="{Binding IsEditing,
                                   Converter={StaticResource InvertedBoolConverter}}" />
                        <!-- Edit name -->
                        <Entry Grid.Column="0"
                               Text="{Binding Name}"
                               FontSize="16"
                               TextColor="White"
                               BackgroundColor="#0f3460"
                               Placeholder="Doctor name"
                               PlaceholderColor="#666"
                               IsVisible="{Binding IsEditing}" />

                        <!-- PCP Badge read-only -->
                        <Border Grid.Column="1"
                                Padding="8,4"
                                BackgroundColor="#1976d2"
                                StrokeShape="RoundRectangle 6"
                                VerticalOptions="Center"
                                IsVisible="{Binding IsPrimary}">
                            <Label Text="🩺 PCP"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />
                    <!-- Latest Visit & Follow Up -->
                    <Border Padding="12"
        BackgroundColor="#0f3460"
        StrokeShape="RoundRectangle 8"
        Stroke="#2a2a4a"
        IsVisible="{Binding HasVisitHistory}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🏥  Last Visit"
               FontSize="12"
               FontAttributes="Bold"
               TextColor="#90caf9" />
                            <Label Text="{Binding LatestVisit.DisplayVisitDate}"
               FontSize="13"
               TextColor="White" />
                            <Label Text="{Binding LatestVisit.Reason}"
               FontSize="12"
               TextColor="#aaaaaa"
               LineBreakMode="WordWrap"
               IsVisible="{Binding LatestVisit.Reason,
                   Converter={StaticResource StringToBoolConverter}}" />
                            <BoxView HeightRequest="1" BackgroundColor="#2a2a4a"
                 IsVisible="{Binding LatestVisit.HasFollowUp}" />
                            <Label Text="📅  Follow Up"
               FontSize="12"
               FontAttributes="Bold"
               IsVisible="{Binding LatestVisit.HasFollowUp}">
                                <Label.TextColor>
                                    <Binding Path="LatestVisit.FollowUpColor" />
                                </Label.TextColor>
                            </Label>
                            <Label Text="{Binding LatestVisit.DisplayFollowUp}"
               FontSize="13"
               IsVisible="{Binding LatestVisit.HasFollowUp}">
                                <Label.TextColor>
                                    <Binding Path="LatestVisit.FollowUpColor" />
                                </Label.TextColor>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                    <!-- Specialty -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Specialty"
                               FontSize="11"
                               TextColor="#90caf9" />
                        <Label Text="{Binding Specialty}"
                               FontSize="14"
                               TextColor="#e0e0e0"
                               IsVisible="{Binding IsEditing,
                                   Converter={StaticResource InvertedBoolConverter}}" />
                        <Entry Text="{Binding Specialty}"
                               FontSize="14"
                               TextColor="White"
                               BackgroundColor="#0f3460"
                               Placeholder="Specialty"
                               PlaceholderColor="#666"
                               IsVisible="{Binding IsEditing}" />
                    </VerticalStackLayout>

                    <!-- Address -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Address"
                               FontSize="11"
                               TextColor="#90caf9" />
                        <Label Text="{Binding Address}"
                               FontSize="14"
                               TextColor="#e0e0e0"
                               LineBreakMode="WordWrap"
                               IsVisible="{Binding IsEditing,
                                   Converter={StaticResource InvertedBoolConverter}}" />
                        <Entry Text="{Binding Address}"
                               FontSize="14"
                               TextColor="White"
                               BackgroundColor="#0f3460"
                               Placeholder="Address"
                               PlaceholderColor="#666"
                               IsVisible="{Binding IsEditing}" />
                    </VerticalStackLayout>

                    <!-- Phone + Fax -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Phone"
                                   FontSize="11"
                                   TextColor="#90caf9" />
                            <!-- Read-only tappable phone -->
                            <Label Text="{Binding Phone}"
                                   FontSize="14"
                                   TextColor="#90caf9"
                                   TextDecorations="Underline"
                                   IsVisible="{Binding IsEditing,
                                       Converter={StaticResource InvertedBoolConverter}}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding CallPhoneCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Entry Text="{Binding Phone}"
                                   Keyboard="Telephone"
                                   FontSize="14"
                                   TextColor="White"
                                   BackgroundColor="#0f3460"
                                   Placeholder="Phone"
                                   PlaceholderColor="#666"
                                   IsVisible="{Binding IsEditing}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Fax"
                                   FontSize="11"
                                   TextColor="#90caf9" />
                            <Label Text="{Binding Fax}"
                                   FontSize="14"
                                   TextColor="#e0e0e0"
                                   IsVisible="{Binding IsEditing,
                                       Converter={StaticResource InvertedBoolConverter}}" />
                            <Entry Text="{Binding Fax}"
                                   Keyboard="Telephone"
                                   FontSize="14"
                                   TextColor="White"
                                   BackgroundColor="#0f3460"
                                   Placeholder="Fax"
                                   PlaceholderColor="#666"
                                   IsVisible="{Binding IsEditing}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Email"
                               FontSize="11"
                               TextColor="#90caf9" />
                        <!-- Read-only tappable email -->
                        <Label Text="{Binding Email}"
                               FontSize="14"
                               TextColor="#90caf9"
                               TextDecorations="Underline"
                               IsVisible="{Binding IsEditing,
                                   Converter={StaticResource InvertedBoolConverter}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding SendEmailCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Entry Text="{Binding Email}"
                               Keyboard="Email"
                               FontSize="14"
                               TextColor="White"
                               BackgroundColor="#0f3460"
                               Placeholder="Email"
                               PlaceholderColor="#666"
                               IsVisible="{Binding IsEditing}" />
                    </VerticalStackLayout>

                    <!-- Notes -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Notes"
                               FontSize="11"
                               TextColor="#90caf9" />
                        <Label Text="{Binding Notes}"
                               FontSize="14"
                               TextColor="#e0e0e0"
                               LineBreakMode="WordWrap"
                               IsVisible="{Binding IsEditing,
                                   Converter={StaticResource InvertedBoolConverter}}" />
                        <Editor Text="{Binding Notes}"
                                FontSize="14"
                                TextColor="White"
                                BackgroundColor="#0f3460"
                                Placeholder="Notes"
                                PlaceholderColor="#666"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="80"
                                IsVisible="{Binding IsEditing}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             BackgroundColor="#2a2a4a"
                             IsVisible="{Binding IsEditing}" />

                    <!-- Primary + Active toggles (edit mode only) -->
                    <Grid ColumnDefinitions="*,Auto"
                          IsVisible="{Binding IsEditing}">
                        <Label Grid.Column="0"
                               Text="Primary Care Provider"
                               FontSize="14"
                               TextColor="#90caf9"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsPrimary}"
                                OnColor="#1976d2" />
                    </Grid>

                    <!-- Remove from Care Team (edit mode only) -->
                    <Grid ColumnDefinitions="*,Auto"
                          IsVisible="{Binding IsEditing}">
                        <Button Text="🗑️  Remove from Care Team"
                            BackgroundColor="#d32f2f"
                            TextColor="White"
                            FontSize="13"
                            HeightRequest="44"
                            CornerRadius="8"
                            IsVisible="{Binding ShowRemoveButton}"
                            Command="{Binding RemoveFromCareTeamCommand}" />
                    </Grid>

                    <!-- Status Message -->
                    <Label Text="{Binding StatusMessage}"
                           IsVisible="{Binding StatusMessage,
                               Converter={StaticResource StringToBoolConverter}}"
                           TextColor="#d32f2f"
                           FontSize="13"
                           HorizontalOptions="Center" />

                    <!-- Busy -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#90caf9"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="1"
              Padding="16"
              BackgroundColor="#16213e"
              ColumnDefinitions="*,*"
              ColumnSpacing="8"
              IsVisible="{Binding ShowBottomBar}">

            <!-- Read-only: Close + Edit -->
            <Button Grid.Column="0"
            Text="✖  Close"
            BackgroundColor="#0f3460"
            TextColor="White"
            FontSize="15"
            HeightRequest="48"
            CornerRadius="8"
            IsVisible="{Binding IsEditing,
                Converter={StaticResource InvertedBoolConverter}}"
            Clicked="OnCloseClicked" />
            <Button Grid.Column="1"
            Text="✏️  Edit"
            BackgroundColor="#1976d2"
            TextColor="White"
            FontSize="15"
            HeightRequest="48"
            CornerRadius="8"
            IsVisible="{Binding IsEditing,
                Converter={StaticResource InvertedBoolConverter}}"
            Command="{Binding StartEditCommand}" />

            <!-- Edit mode: Cancel + Save -->
            <Button Grid.Column="0"
            Text="✖  Cancel"
            BackgroundColor="#0f3460"
            TextColor="White"
            FontSize="15"
            HeightRequest="48"
            CornerRadius="8"
            IsVisible="{Binding IsEditing}"
            Command="{Binding CancelCommand}" />
            <Button Grid.Column="1"
            Text="✅  Save"
            BackgroundColor="#1976d2"
            TextColor="White"
            FontSize="15"
            HeightRequest="48"
            CornerRadius="8"
            IsVisible="{Binding IsEditing}"
            Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</toolkit:Popup>