<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             xmlns:models="clr-namespace:Vitals.Maui.Models"
             x:Class="Vitals.Maui.Views.CareTeamPage"
             x:DataType="vm:CareTeamViewModel"
             BackgroundColor="#1a1a2e">

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy}"
                 RefreshColor="#90caf9">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Header Card -->
                <Border Padding="16"
                        BackgroundColor="#16213e"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#2a2a4a">
                    <VerticalStackLayout Spacing="10">
                        <Label FontSize="18"
                               FontAttributes="Bold"
                               TextColor="White">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Care Team for " TextColor="#90caf9" />
                                    <Span Text="{Binding SelectedPatient.FullName}"
                                          TextColor="White"
                                          FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Button Text="➕  Add Provider"
                                BackgroundColor="#1976d2"
                                TextColor="White"
                                FontSize="13"
                                HeightRequest="44"
                                CornerRadius="8"
                                Command="{Binding OpenAddDoctorCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- No Doctors -->
                <Label Text="No providers on record."
                       IsVisible="{Binding HasNoDoctors}"
                       FontSize="14"
                       TextColor="#888888"
                       HorizontalOptions="Center"
                       Margin="0,16" />

                <!-- Doctors List -->
                <CollectionView ItemsSource="{Binding Doctors}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Doctor">
                            <Border Padding="16"
                                    Margin="0,0,0,8"
                                    BackgroundColor="#16213e"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#2a2a4a">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CareTeamViewModel}},
                                            Path=OpenDoctorDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               LineBreakMode="WordWrap" />
                                        <Label Text="{Binding Specialty}"
                                               FontSize="13"
                                               TextColor="#aaaaaa"
                                               FontAttributes="Italic" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1"
                                            Padding="8,4"
                                            BackgroundColor="#1976d2"
                                            StrokeShape="RoundRectangle 6"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding IsPrimary}">
                                        <Label Text="🩺 PCP"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                    </Border>
                                    <Label Grid.Column="1"
                                           Text="›"
                                           FontSize="22"
                                           TextColor="#1976d2"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding IsPrimary,
                                               Converter={StaticResource InvertedBoolConverter}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Status Message -->
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage,
                           Converter={StaticResource StringToBoolConverter}}"
                       TextColor="#d32f2f"
                       FontSize="13"
                       HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>