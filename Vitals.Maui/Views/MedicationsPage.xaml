<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             xmlns:models="clr-namespace:Vitals.Maui.Models"
             x:Class="Vitals.Maui.Views.MedicationsPage"
             x:DataType="vm:MedicationsViewModel"
             BackgroundColor="{DynamicResource PageBackground}">

    <RefreshView Command="{Binding LoadCommand}"
                 IsRefreshing="{Binding IsBusy}"
                 RefreshColor="{DynamicResource PrimaryAccent}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Patient Header -->
                <Border Padding="16"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource CardStroke}">
                    <VerticalStackLayout Spacing="10">
                        <Label FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Medications for " TextColor="{DynamicResource PrimaryAccent}" />
                                    <Span Text="{Binding SelectedPatient.FullName}"
                                          TextColor="{DynamicResource TextPrimary}"
                                          FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Button Text="➕  Add Medication"
                                BackgroundColor="{DynamicResource ButtonBackground}"
                                TextColor="{DynamicResource TextPrimary}"
                                FontSize="13"
                                HeightRequest="44"
                                CornerRadius="8"
                                Command="{Binding OpenAddMedicationCommand}" />

                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,4" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Hide inactive/discontinued medications"
                                   FontSize="13"
                                   TextColor="{DynamicResource TextSecondary}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding HideInactiveMedications}"
                                    OnColor="{DynamicResource PrimaryAccent}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Medications Card -->
                <Border Padding="16"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource CardStroke}">
                    <VerticalStackLayout Spacing="8">

                        <Label Text="💊  Medications"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource TextPrimary}"
                               Margin="0,0,0,8" />

                        <!-- No Medications -->
                        <Label Text="{Binding NoMedicationsMessage}"
                               IsVisible="{Binding HasNoMedications}"
                               FontSize="14"
                               TextColor="{DynamicResource TextMuted}"
                               HorizontalOptions="Center"
                               Margin="0,16" />

                        <!-- Morning -->
                        <VerticalStackLayout IsVisible="{Binding HasMorning}" Spacing="4">
                            <Label Text="🌅  Morning"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryAccent}"
                                   Margin="0,8,0,4" />
                            <CollectionView ItemsSource="{Binding MorningMeds}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Medication">
                                        <VerticalStackLayout Padding="8,6" Spacing="2">
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MedicationsViewModel}},
                                                        Path=OpenMedicationDetailCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </VerticalStackLayout.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Name}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextPrimary}" />
                                                <Label Text="Inactive"
                                                       IsVisible="{Binding IsActive, Converter={StaticResource InvertedBoolConverter}}"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextMuted}"
                                                       BackgroundColor="{DynamicResource DividerColor}"
                                                       Padding="6,1"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Dosage}"
                                                   FontSize="13" FontAttributes="Italic"
                                                   TextColor="{DynamicResource TextMuted}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,4" />
                        </VerticalStackLayout>

                        <!-- Midday -->
                        <VerticalStackLayout IsVisible="{Binding HasMidday}" Spacing="4">
                            <Label Text="☀️  Midday"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryAccent}"
                                   Margin="0,8,0,4" />
                            <CollectionView ItemsSource="{Binding MiddayMeds}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Medication">
                                        <VerticalStackLayout Padding="8,6" Spacing="2">
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MedicationsViewModel}},
                                                        Path=OpenMedicationDetailCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </VerticalStackLayout.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Name}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextPrimary}" />
                                                <Label Text="Inactive"
                                                       IsVisible="{Binding IsActive, Converter={StaticResource InvertedBoolConverter}}"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextMuted}"
                                                       BackgroundColor="{DynamicResource DividerColor}"
                                                       Padding="6,1"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Dosage}"
                                                   FontSize="13" FontAttributes="Italic"
                                                   TextColor="{DynamicResource TextMuted}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,4" />
                        </VerticalStackLayout>

                        <!-- Evening -->
                        <VerticalStackLayout IsVisible="{Binding HasEvening}" Spacing="4">
                            <Label Text="🌆  Evening"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryAccent}"
                                   Margin="0,8,0,4" />
                            <CollectionView ItemsSource="{Binding EveningMeds}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Medication">
                                        <VerticalStackLayout Padding="8,6" Spacing="2">
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MedicationsViewModel}},
                                                        Path=OpenMedicationDetailCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </VerticalStackLayout.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Name}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextPrimary}" />
                                                <Label Text="Inactive"
                                                       IsVisible="{Binding IsActive, Converter={StaticResource InvertedBoolConverter}}"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextMuted}"
                                                       BackgroundColor="{DynamicResource DividerColor}"
                                                       Padding="6,1"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Dosage}"
                                                   FontSize="13" FontAttributes="Italic"
                                                   TextColor="{DynamicResource TextMuted}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,4" />
                        </VerticalStackLayout>

                        <!-- Night -->
                        <VerticalStackLayout IsVisible="{Binding HasNight}" Spacing="4">
                            <Label Text="🌙  Night"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryAccent}"
                                   Margin="0,8,0,4" />
                            <CollectionView ItemsSource="{Binding NightMeds}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Medication">
                                        <VerticalStackLayout Padding="8,6" Spacing="2">
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MedicationsViewModel}},
                                                        Path=OpenMedicationDetailCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </VerticalStackLayout.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Name}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextPrimary}" />
                                                <Label Text="Inactive"
                                                       IsVisible="{Binding IsActive, Converter={StaticResource InvertedBoolConverter}}"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextMuted}"
                                                       BackgroundColor="{DynamicResource DividerColor}"
                                                       Padding="6,1"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Dosage}"
                                                   FontSize="13" FontAttributes="Italic"
                                                   TextColor="{DynamicResource TextMuted}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,4" />
                        </VerticalStackLayout>

                        <!-- Other / PRN -->
                        <VerticalStackLayout IsVisible="{Binding HasOther}" Spacing="4">
                            <Label Text="🔄  Other / As Needed"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryAccent}"
                                   Margin="0,8,0,4" />
                            <CollectionView ItemsSource="{Binding OtherMeds}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Medication">
                                        <VerticalStackLayout Padding="8,6" Spacing="2">
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MedicationsViewModel}},
                                                        Path=OpenMedicationDetailCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </VerticalStackLayout.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Name}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextPrimary}" />
                                                <Label Text="Inactive"
                                                       IsVisible="{Binding IsActive, Converter={StaticResource InvertedBoolConverter}}"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="{DynamicResource TextMuted}"
                                                       BackgroundColor="{DynamicResource DividerColor}"
                                                       Padding="6,1"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Dosage}"
                                                   FontSize="13" FontAttributes="Italic"
                                                   TextColor="{DynamicResource TextMuted}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Busy Indicator -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{DynamicResource PrimaryAccent}"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
