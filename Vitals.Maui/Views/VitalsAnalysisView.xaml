<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
               x:Class="Vitals.Maui.Views.VitalsAnalysisView"
               x:DataType="vm:VitalsAnalysisViewModel">

    <Grid RowDefinitions="*,Auto"
          HeightRequest="680"
          WidthRequest="360"
          BackgroundColor="{DynamicResource CardBackground}">

        <ScrollView Grid.Row="0" Padding="16">
            <VerticalStackLayout Spacing="14">

                <!-- Header -->
                <Label Text="📊  Vitals Analysis"
                       FontSize="20" FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}" />

                <Label FontSize="13" TextColor="{DynamicResource TextMuted}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding SelectedPatient.FullName,
                                      TargetNullValue='', FallbackValue=''}"
                                  TextColor="{DynamicResource PrimaryAccent}" />
                            <Span Text="  •  Last " TextColor="{DynamicResource TextMuted}" />
                            <Span Text="{Binding SelectedDays}" TextColor="{DynamicResource PrimaryAccent}" />
                            <Span Text=" days  •  " TextColor="{DynamicResource TextMuted}" />
                            <Span Text="{Binding Analysis.ReadingCount}" TextColor="{DynamicResource PrimaryAccent}" />
                            <Span Text=" readings" TextColor="{DynamicResource TextMuted}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Day Range Buttons -->
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                    <Button Grid.Column="0" Text="15d"
                            BackgroundColor="{Binding Btn15Color}"
                            TextColor="{Binding Btn15TextColor}" FontSize="12"
                            HeightRequest="36" CornerRadius="6"
                            Command="{Binding SelectDaysCommand}"
                            CommandParameter="15" />
                    <Button Grid.Column="1" Text="30d"
                            BackgroundColor="{Binding Btn30Color}"
                            TextColor="{Binding Btn30TextColor}" FontSize="12"
                            HeightRequest="36" CornerRadius="6"
                            Command="{Binding SelectDaysCommand}"
                            CommandParameter="30" />
                    <Button Grid.Column="2" Text="45d"
                            BackgroundColor="{Binding Btn45Color}"
                            TextColor="{Binding Btn45TextColor}" FontSize="12"
                            HeightRequest="36" CornerRadius="6"
                            Command="{Binding SelectDaysCommand}"
                            CommandParameter="45" />
                    <Button Grid.Column="3" Text="60d"
                            BackgroundColor="{Binding Btn60Color}"
                            TextColor="{Binding Btn60TextColor}" FontSize="12"
                            HeightRequest="36" CornerRadius="6"
                            Command="{Binding SelectDaysCommand}"
                            CommandParameter="60" />
                    <Button Grid.Column="4"
                            Text="{Binding CustomDaysLabel}"
                            BackgroundColor="{Binding BtnCustomColor}"
                            TextColor="{Binding BtnCustomTextColor}" FontSize="12"
                            HeightRequest="36" CornerRadius="6"
                            Clicked="OnCustomDaysClicked" />
                </Grid>

                <!-- Busy -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{DynamicResource PrimaryAccent}"
                                   HorizontalOptions="Center" />

                <!-- Insufficient Data -->
                <Border Padding="16"
                        BackgroundColor="{DynamicResource CardBackground}"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{DynamicResource CardStroke}"
                        IsVisible="{Binding IsInsufficient}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="📈  Not Enough Data Yet"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="{DynamicResource PrimaryAccent}" />
                        <Label Text="{Binding Analysis.Message}"
                               FontSize="13" TextColor="{DynamicResource TextSecondary}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Analysis Results -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsOk}">

                    <!-- Tab Buttons -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                        <Button Grid.Column="0" Text="❤️ BP"
                                BackgroundColor="{Binding TabBpColor}"
                                TextColor="{Binding TabBpTextColor}" FontSize="12"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="bp" />
                        <Button Grid.Column="1" Text="💓 HR"
                                BackgroundColor="{Binding TabHrColor}"
                                TextColor="{Binding TabHrTextColor}" FontSize="12"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="hr" />
                        <Button Grid.Column="2" Text="🫁 SpO₂"
                                BackgroundColor="{Binding TabSpo2Color}"
                                TextColor="{Binding TabSpo2TextColor}" FontSize="12"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="spo2" />
                        <Button Grid.Column="3" Text="🌡️ Temp"
                                BackgroundColor="{Binding TabTempColor}"
                                TextColor="{Binding TabTempTextColor}" FontSize="12"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectTabCommand}"
                                CommandParameter="temp" />
                    </Grid>

                    <!-- ==================== BP TAB ==================== -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowBp}">

                        <!-- Classification -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="ACC/AHA Classification"
                                       FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.ClassificationDisplay}"
                                       FontSize="18" FontAttributes="Bold">
                                    <Label.TextColor>
                                        <Binding Path="Analysis.ClassificationColor" />
                                    </Label.TextColor>
                                </Label>
                                <Label FontSize="12" TextColor="{DynamicResource TextMuted}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Avg BP  " />
                                            <Span Text="{Binding Analysis.Systolic.Avg, StringFormat='{0:F1}'}"
                                                  TextColor="{DynamicResource TextPrimary}" />
                                            <Span Text=" / " />
                                            <Span Text="{Binding Analysis.Diastolic.Avg, StringFormat='{0:F1}'}"
                                                  TextColor="{DynamicResource TextPrimary}" />
                                            <Span Text=" mmHg" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,4,0,2" />
                                <Label FontSize="12" TextColor="{DynamicResource TextMuted}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="MAP  " />
                                            <Span Text="{Binding Analysis.Map.Avg, StringFormat='{0:F1}'}"
                                                  TextColor="{DynamicResource TextPrimary}" />
                                            <Span Text=" mmHg  " />
                                            <Span Text="{Binding Analysis.Map.RangeLabel}" FontSize="11" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="Mean arterial pressure — the average pressure the arteries experience across the full heartbeat cycle. Normal: 70–100 mmHg."
                                       FontSize="10" TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Trend -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="BLOOD PRESSURE TREND"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryAccent}" />

                                <!-- Systolic -->
                                <Label Text="Systolic" FontSize="11" FontAttributes="Bold" TextColor="#d32f2f" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Direction" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label FontSize="14" FontAttributes="Bold">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Analysis.Systolic.TrendArrow}" FontSize="16" />
                                                    <Span Text="  " />
                                                    <Span Text="{Binding Analysis.Systolic.TrendLabel}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                            <Label.TextColor>
                                                <Binding Path="Analysis.Systolic.TrendColor" />
                                            </Label.TextColor>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="Rate of Change" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Systolic.SlopeDisplay}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <Label Text="Significance" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Systolic.PValueDisplay}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Label Text="Consistency" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Systolic.ConsistencyLabel}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="2">
                                        <Label Text="Momentum" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Systolic.MomentumLabel}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,4" />

                                <!-- Diastolic -->
                                <Label Text="Diastolic" FontSize="11" FontAttributes="Bold" TextColor="#1976d2" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Direction" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label FontSize="14" FontAttributes="Bold">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Analysis.Diastolic.TrendArrow}" FontSize="16" />
                                                    <Span Text="  " />
                                                    <Span Text="{Binding Analysis.Diastolic.TrendLabel}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                            <Label.TextColor>
                                                <Binding Path="Analysis.Diastolic.TrendColor" />
                                            </Label.TextColor>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="Rate of Change" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Diastolic.SlopeDisplay}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <Label Text="Significance" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Diastolic.PValueDisplay}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Label Text="Consistency" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Diastolic.ConsistencyLabel}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="2">
                                        <Label Text="Momentum" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Diastolic.MomentumLabel}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- BP Burden — Hypertension -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.IsHypotension,
                                    Converter={StaticResource InvertedBoolConverter}}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="BP BURDEN" FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="Percentage of time spent in each range:"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                    <Border Grid.Column="0" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileNormalBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Burden.NormalDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="Normal" FontSize="10" TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="&lt;120" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileLowBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Burden.ElevatedDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#f57c00" HorizontalOptions="Center" />
                                            <Label Text="Elevated" FontSize="10" TextColor="#f57c00" HorizontalOptions="Center" />
                                            <Label Text="120-129" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileSevereBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Burden.Stage1Display}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="Stage 1" FontSize="10" TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="130-139" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="3" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileCriticalBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Burden.Stage2Display}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#7b1fa2" HorizontalOptions="Center" />
                                            <Label Text="Stage 2" FontSize="10" TextColor="#7b1fa2" HorizontalOptions="Center" />
                                            <Label Text="≥140" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- BP Burden — Hypotension -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.IsHypotension}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="LOW BP BURDEN" FontSize="11" FontAttributes="Bold" TextColor="#1976d2" />
                                <Label Text="Percentage of time spent in each low BP range:"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                    <Border Grid.Column="0" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileNormalBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.HypoBurden.NormalDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="Normal" FontSize="10" TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="≥90" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileLowBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.HypoBurden.ModerateDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="{DynamicResource PrimaryAccent}" HorizontalOptions="Center" />
                                            <Label Text="Low" FontSize="10" TextColor="{DynamicResource PrimaryAccent}" HorizontalOptions="Center" />
                                            <Label Text="80-89" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileSevereBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.HypoBurden.SevereDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="Severe" FontSize="10" TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="&lt;80" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Low Diastolic Burden -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Analysis.IsHypotension}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="LOW DIASTOLIC BURDEN" FontSize="11" FontAttributes="Bold" TextColor="#1976d2" />
                                <Label Text="Percentage of time spent in each diastolic range:"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                    <Border Grid.Column="0" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileNormalBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.LowDbpBurden.NormalDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="Normal" FontSize="10" TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="≥70" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileLowBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.LowDbpBurden.LowDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="{DynamicResource PrimaryAccent}" HorizontalOptions="Center" />
                                            <Label Text="Low" FontSize="10" TextColor="{DynamicResource PrimaryAccent}" HorizontalOptions="Center" />
                                            <Label Text="60-69" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileSevereBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.LowDbpBurden.SevereDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="Severe" FontSize="10" TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="&lt;60" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="3" Padding="8,6"
                                            BackgroundColor="{DynamicResource TileCriticalBg}"
                                            StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.LowDbpBurden.CriticalDisplay}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#ff1744" HorizontalOptions="Center" />
                                            <Label Text="Critical" FontSize="10" TextColor="#ff1744" HorizontalOptions="Center" />
                                            <Label Text="&lt;50" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                                <Label FontSize="12" TextColor="{DynamicResource TextMuted}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Lowest recorded diastolic: " />
                                            <Span Text="{Binding Analysis.LowDbpBurden.LowestDiaDisplay}"
                                                  FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Text="{Binding Analysis.LowDbpBurden.PlainEnglish}"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="WordWrap" />
                                <Border Padding="10,8"
                                        BackgroundColor="{DynamicResource TileCriticalBg}"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#ff1744"
                                        IsVisible="{Binding Analysis.ShowLowDiastolicAlert}">
                                    <Label Text="{Binding Analysis.LowDiastolicAlertText}"
                                           FontSize="12" TextColor="#ff1744"
                                           LineBreakMode="WordWrap" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- SBP Burden + TTR -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="BLOOD PRESSURE BURDEN &amp; TIME IN RANGE"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Pumping Pressure Burden"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextSecondary}" />
                                        <Label Text="Time pumping pressure exceeded 130 mmHg (weighted by excess)"
                                               FontSize="10" TextColor="{DynamicResource TextMuted}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Padding="12,8"
                                            BackgroundColor="{DynamicResource TileSevereBg}"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center"
                                            Margin="8,0,0,0">
                                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.SbpBurden.PctDisplay}"
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="of readings" FontSize="9" TextColor="{DynamicResource TextMuted}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding Analysis.SbpBurden.PlainEnglish}"
                                           FontSize="12" TextColor="{DynamicResource TextMuted}"
                                           LineBreakMode="WordWrap" Margin="0,4,0,0" />
                                </Grid>
                                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" Margin="0,4" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Time in Healthy Range"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextSecondary}" />
                                        <Label Text="Pumping pressure within target range of 100–130 mmHg"
                                               FontSize="10" TextColor="{DynamicResource TextMuted}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Padding="12,8"
                                            BackgroundColor="{DynamicResource TileNormalBg}"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center"
                                            Margin="8,0,0,0">
                                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Ttr.PctDisplay}"
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="of time" FontSize="9" TextColor="{DynamicResource TextMuted}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding Analysis.Ttr.PlainEnglish}"
                                           FontSize="12" TextColor="{DynamicResource TextMuted}"
                                           LineBreakMode="WordWrap" Margin="0,4,0,0" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Resting Pressure Burden (DBP) -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="RESTING PRESSURE BURDEN"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="How often the heart's resting pressure between beats exceeds the healthy threshold of 80 mmHg"
                                       FontSize="11" TextColor="{DynamicResource TextMuted}"
                                       LineBreakMode="WordWrap" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Diastolic Burden"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="{DynamicResource TextSecondary}" />
                                        <Label Text="The heart's resting pressure between beats"
                                               FontSize="10" TextColor="{DynamicResource TextMuted}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Padding="12,8"
                                            BackgroundColor="{DynamicResource TileLowBg}"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center"
                                            Margin="8,0,0,0">
                                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.DbpBurden.PctDisplay}"
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="#ffa726" HorizontalOptions="Center" />
                                            <Label Text="of time" FontSize="9" TextColor="{DynamicResource TextMuted}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding Analysis.DbpBurden.PlainEnglish}"
                                           FontSize="12" TextColor="{DynamicResource TextMuted}"
                                           LineBreakMode="WordWrap" Margin="0,4,0,0" />
                                </Grid>
                                <Border Padding="10,8"
                                        BackgroundColor="{DynamicResource TileLowBg}"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#ffa726"
                                        IsVisible="{Binding ShowDiastolicWarning}">
                                    <Label Text="{Binding DiastolicWarningText}"
                                           FontSize="12" TextColor="#ffa726"
                                           LineBreakMode="WordWrap" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Plain English -->
                        <Border Padding="16"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding PlainEnglishSummary,
                                    Converter={StaticResource StringToBoolConverter}}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="💬  In Plain English"
                                       FontSize="13" FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding PlainEnglishSummary}"
                                       FontSize="13" TextColor="{DynamicResource TextSecondary}"
                                       LineBreakMode="WordWrap" />
                                <Label Text="{Binding PcpLine}"
                                       FontSize="13" TextColor="{DynamicResource PrimaryAccent}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap"
                                       IsVisible="{Binding PcpLine,
                                           Converter={StaticResource StringToBoolConverter}}" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <!-- ==================== HR TAB ==================== -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowHr}">

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Heart Rate Classification" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.HeartRate.HrClassificationDisplay}"
                                       FontSize="18" FontAttributes="Bold">
                                    <Label.TextColor>
                                        <Binding Path="Analysis.HeartRate.HrClassificationColor" />
                                    </Label.TextColor>
                                </Label>
                                <Label Text="{Binding Analysis.HeartRate.Avg, StringFormat='Avg {0:F0} BPM'}"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="HEART RATE TREND" FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Direction" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label FontSize="14" FontAttributes="Bold">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Analysis.HeartRate.TrendArrow}" FontSize="16" />
                                                    <Span Text="  " />
                                                    <Span Text="{Binding Analysis.HeartRate.TrendLabel}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                            <Label.TextColor>
                                                <Binding Path="Analysis.HeartRate.TrendColor" />
                                            </Label.TextColor>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="Rate of Change" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.HeartRate.SlopeDisplay, StringFormat='{0} BPM/day'}"
                                               FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <Label Text="Significance" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.HeartRate.PValueDisplay}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Label Text="Consistency" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.HeartRate.ConsistencyLabel}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="HEART RATE BURDEN" FontSize="11" FontAttributes="Bold"
                                       TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="Percentage of time spent in each range:"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                    <Border Grid.Column="0" Padding="8,6" BackgroundColor="{DynamicResource TileLowBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.HeartRate.HrBurden.BradycardiaDisplay}" FontSize="16" FontAttributes="Bold" TextColor="#1976d2" HorizontalOptions="Center" />
                                            <Label Text="Brady" FontSize="10" TextColor="#1976d2" HorizontalOptions="Center" />
                                            <Label Text="&lt;60" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="8,6" BackgroundColor="{DynamicResource TileNormalBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.HeartRate.HrBurden.NormalDisplay}" FontSize="16" FontAttributes="Bold" TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="Normal" FontSize="10" TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="60-100" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Padding="8,6" BackgroundColor="{DynamicResource TileSevereBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.HeartRate.HrBurden.MildTachyDisplay}" FontSize="16" FontAttributes="Bold" TextColor="#f57c00" HorizontalOptions="Center" />
                                            <Label Text="Mild Tachy" FontSize="10" TextColor="#f57c00" HorizontalOptions="Center" />
                                            <Label Text="101-120" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="3" Padding="8,6" BackgroundColor="{DynamicResource TileCriticalBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.HeartRate.HrBurden.TachycardiaDisplay}" FontSize="16" FontAttributes="Bold" TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="Tachy" FontSize="10" TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="&gt;120" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding HrSummary, Converter={StaticResource StringToBoolConverter}}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="💬  In Plain English" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding HrSummary}" FontSize="13" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding PcpLine}" FontSize="13" TextColor="{DynamicResource PrimaryAccent}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap"
                                       IsVisible="{Binding PcpLine, Converter={StaticResource StringToBoolConverter}}" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <!-- ==================== SPO2 TAB ==================== -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowSpo2}">

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="SpO₂ Classification" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Spo2.Spo2ClassificationDisplay}" FontSize="18" FontAttributes="Bold">
                                    <Label.TextColor>
                                        <Binding Path="Analysis.Spo2.Spo2ClassificationColor" />
                                    </Label.TextColor>
                                </Label>
                                <Label Text="{Binding Analysis.Spo2.Avg, StringFormat='Avg {0:F1}%'}"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="OXYGEN SATURATION TREND" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource PrimaryAccent}" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Direction" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label FontSize="14" FontAttributes="Bold">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Analysis.Spo2.TrendArrow}" FontSize="16" />
                                                    <Span Text="  " />
                                                    <Span Text="{Binding Analysis.Spo2.TrendLabel}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                            <Label.TextColor>
                                                <Binding Path="Analysis.Spo2.TrendColor" />
                                            </Label.TextColor>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="Rate of Change" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Spo2.SlopeDisplay, StringFormat='{0} %/day'}"
                                               FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <Label Text="Significance" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Spo2.PValueDisplay}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Label Text="Consistency" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Spo2.ConsistencyLabel}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="SPO₂ BURDEN" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="Percentage of time spent in each range:" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                    <Border Grid.Column="0" Padding="8,6" BackgroundColor="{DynamicResource TileNormalBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Spo2.Spo2Burden.NormalDisplay}" FontSize="16" FontAttributes="Bold" TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="Normal" FontSize="10" TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="≥95%" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="8,6" BackgroundColor="{DynamicResource TileLowBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Spo2.Spo2Burden.MildHypoxemiaDisplay}" FontSize="16" FontAttributes="Bold" TextColor="#f57c00" HorizontalOptions="Center" />
                                            <Label Text="Mild" FontSize="10" TextColor="#f57c00" HorizontalOptions="Center" />
                                            <Label Text="92-94%" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Padding="8,6" BackgroundColor="{DynamicResource TileSevereBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Spo2.Spo2Burden.ModerateHypoxemiaDisplay}" FontSize="16" FontAttributes="Bold" TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="Moderate" FontSize="10" TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="88-91%" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="3" Padding="8,6" BackgroundColor="{DynamicResource TileCriticalBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Spo2.Spo2Burden.SevereHypoxemiaDisplay}" FontSize="16" FontAttributes="Bold" TextColor="#7b1fa2" HorizontalOptions="Center" />
                                            <Label Text="Severe" FontSize="10" TextColor="#7b1fa2" HorizontalOptions="Center" />
                                            <Label Text="&lt;88%" FontSize="9" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding Spo2Summary, Converter={StaticResource StringToBoolConverter}}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="💬  In Plain English" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Spo2Summary}" FontSize="13" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding PcpLine}" FontSize="13" TextColor="{DynamicResource PrimaryAccent}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap"
                                       IsVisible="{Binding PcpLine, Converter={StaticResource StringToBoolConverter}}" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <!-- ==================== TEMP TAB ==================== -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowTemp}">

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Temperature Classification" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding Analysis.Temperature.TempClassificationDisplay}" FontSize="18" FontAttributes="Bold">
                                    <Label.TextColor>
                                        <Binding Path="Analysis.Temperature.TempClassificationColor" />
                                    </Label.TextColor>
                                </Label>
                                <Label Text="{Binding Analysis.Temperature.Avg, StringFormat='Avg {0:F1} °F'}"
                                       FontSize="12" TextColor="{DynamicResource TextMuted}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="TEMPERATURE TREND" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource PrimaryAccent}" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Direction" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label FontSize="14" FontAttributes="Bold">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Analysis.Temperature.TrendArrow}" FontSize="16" />
                                                    <Span Text="  " />
                                                    <Span Text="{Binding Analysis.Temperature.TrendLabel}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                            <Label.TextColor>
                                                <Binding Path="Analysis.Temperature.TrendColor" />
                                            </Label.TextColor>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="Rate of Change" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.SlopeDisplay, StringFormat='{0} °F/day'}"
                                               FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <Label Text="Significance" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.PValueDisplay}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Label Text="Consistency" FontSize="11" TextColor="{DynamicResource TextMuted}" />
                                        <Label Text="{Binding Analysis.Temperature.ConsistencyLabel}"
                                               FontSize="13" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="TEMPERATURE BURDEN" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="Percentage of time spent in each range:" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
                                    <Border Grid.Column="0" Padding="6,6" BackgroundColor="{DynamicResource TileLowBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Temperature.TempBurden.HypothermiaDisplay}" FontSize="14" FontAttributes="Bold" TextColor="#1976d2" HorizontalOptions="Center" />
                                            <Label Text="Hypo" FontSize="9" TextColor="#1976d2" HorizontalOptions="Center" />
                                            <Label Text="&lt;96.8" FontSize="8" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Padding="6,6" BackgroundColor="{DynamicResource TileNormalBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Temperature.TempBurden.NormalDisplay}" FontSize="14" FontAttributes="Bold" TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="Normal" FontSize="9" TextColor="#388e3c" HorizontalOptions="Center" />
                                            <Label Text="96.8-98.9" FontSize="8" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Padding="6,6" BackgroundColor="{DynamicResource TileSevereBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Temperature.TempBurden.ElevatedDisplay}" FontSize="14" FontAttributes="Bold" TextColor="#f57c00" HorizontalOptions="Center" />
                                            <Label Text="Elevated" FontSize="9" TextColor="#f57c00" HorizontalOptions="Center" />
                                            <Label Text="99-100.3" FontSize="8" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="3" Padding="6,6" BackgroundColor="{DynamicResource TileSevereBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Temperature.TempBurden.FeverDisplay}" FontSize="14" FontAttributes="Bold" TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="Fever" FontSize="9" TextColor="#d32f2f" HorizontalOptions="Center" />
                                            <Label Text="100.4-103" FontSize="8" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="4" Padding="6,6" BackgroundColor="{DynamicResource TileCriticalBg}" StrokeShape="RoundRectangle 6">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="{Binding Analysis.Temperature.TempBurden.HighFeverDisplay}" FontSize="14" FontAttributes="Bold" TextColor="#7b1fa2" HorizontalOptions="Center" />
                                            <Label Text="High Fever" FontSize="9" TextColor="#7b1fa2" HorizontalOptions="Center" />
                                            <Label Text="&gt;103" FontSize="8" TextColor="{DynamicResource TextMuted}" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border Padding="16" BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 12" Stroke="{DynamicResource CardStroke}"
                                IsVisible="{Binding TempSummary, Converter={StaticResource StringToBoolConverter}}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="💬  In Plain English" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryAccent}" />
                                <Label Text="{Binding TempSummary}" FontSize="13" TextColor="{DynamicResource TextSecondary}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding PcpLine}" FontSize="13" TextColor="{DynamicResource PrimaryAccent}"
                                       FontAttributes="Italic" LineBreakMode="WordWrap"
                                       IsVisible="{Binding PcpLine, Converter={StaticResource StringToBoolConverter}}" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <!-- Status -->
                    <Label Text="{Binding StatusMessage}"
                           IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                           TextColor="#d32f2f"
                           FontSize="13"
                           HorizontalOptions="Center" />

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="1" Padding="16" BackgroundColor="{DynamicResource CardBackground}">
            <Button Text="✖  Close"
                    BackgroundColor="{DynamicResource ButtonSecondary}"
                    TextColor="{DynamicResource ButtonSecondaryText}"
                    FontSize="15"
                    HeightRequest="48"
                    CornerRadius="8"
                    Clicked="OnCloseClicked" />
        </Grid>
    </Grid>
</toolkit:Popup>
