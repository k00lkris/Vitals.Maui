<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
               x:Class="Vitals.Maui.Views.NoteDetailPopup"
               x:DataType="vm:NoteDetailViewModel">

    <Grid RowDefinitions="*,Auto"
          HeightRequest="680"
          WidthRequest="360"
          BackgroundColor="#1a1a2e">

        <ScrollView Grid.Row="0" Padding="16">
            <VerticalStackLayout Spacing="14">

                <!-- Note Type -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Note Type" FontSize="11" TextColor="#90caf9" />
                    <Label Text="{Binding SelectedNoteTypeLabel}"
                           FontSize="14" TextColor="#e0e0e0"
                           IsVisible="{Binding IsEditing,
                               Converter={StaticResource InvertedBoolConverter}}" />

                    <!-- Type buttons row 1 -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6"
                          IsVisible="{Binding IsEditing}">
                        <Button Grid.Column="0"
                                Text="General"
                                BackgroundColor="{Binding GeneralColor}"
                                TextColor="White" FontSize="12"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectGeneralCommand}" />
                        <Button Grid.Column="1"
                                Text="Medication Change"
                                BackgroundColor="{Binding MedicationChangeColor}"
                                TextColor="White" FontSize="11"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectMedicationChangeCommand}" />
                    </Grid>

                    <!-- Type buttons row 2 -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6"
                          IsVisible="{Binding IsEditing}">
                        <Button Grid.Column="0"
                                Text="Behavioral"
                                BackgroundColor="{Binding BehavioralColor}"
                                TextColor="White" FontSize="12"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectBehavioralCommand}" />
                        <Button Grid.Column="1"
                                Text="Caregiver Handoff"
                                BackgroundColor="{Binding CaregiverHandoffColor}"
                                TextColor="White" FontSize="11"
                                HeightRequest="36" CornerRadius="6"
                                Command="{Binding SelectCaregiverHandoffCommand}" />
                    </Grid>

                    <!-- Type buttons row 3 -->
                    <Button Text="Family Communication"
                            BackgroundColor="{Binding FamilyCommunicationColor}"
                            TextColor="White" FontSize="12"
                            HeightRequest="36" CornerRadius="6"
                            IsVisible="{Binding IsEditing}"
                            Command="{Binding SelectFamilyCommunicationCommand}" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1" BackgroundColor="#2a2a4a" />

                <!-- Title -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Title (optional)" FontSize="11" TextColor="#90caf9" />
                    <Label Text="{Binding Title,
                               TargetNullValue='—', FallbackValue='—'}"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="White"
                           IsVisible="{Binding IsEditing,
                               Converter={StaticResource InvertedBoolConverter}}" />
                    <Entry Text="{Binding Title}"
                           FontSize="14" TextColor="White"
                           BackgroundColor="#0f3460"
                           Placeholder="Note title"
                           PlaceholderColor="#666"
                           IsVisible="{Binding IsEditing}" />
                </VerticalStackLayout>

                <!-- Body -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Note" FontSize="11" TextColor="#90caf9" />
                    <Label Text="{Binding Body,
                               TargetNullValue='—', FallbackValue='—'}"
                           FontSize="14" TextColor="#e0e0e0"
                           LineBreakMode="WordWrap"
                           IsVisible="{Binding IsEditing,
                               Converter={StaticResource InvertedBoolConverter}}" />
                    <Editor Text="{Binding Body}"
                            FontSize="14" TextColor="White"
                            BackgroundColor="#0f3460"
                            Placeholder="{Binding BodyPlaceholder}"
                            PlaceholderColor="#666"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="160"
                            IsVisible="{Binding IsEditing}" />
                </VerticalStackLayout>

                <!-- Delete button -->
                <Button Text="🗑️  Delete Note"
                        BackgroundColor="#d32f2f"
                        TextColor="White"
                        FontSize="13"
                        HeightRequest="44"
                        CornerRadius="8"
                        IsVisible="{Binding ShowDeleteButton}"
                        Command="{Binding DeleteCommand}" />

                <!-- Status -->
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage,
                           Converter={StaticResource StringToBoolConverter}}"
                       TextColor="#d32f2f"
                       FontSize="13"
                       HorizontalOptions="Center" />

                <!-- Busy -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#90caf9"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="1"
              Padding="16"
              BackgroundColor="#16213e"
              ColumnDefinitions="*,*"
              ColumnSpacing="8">

            <Button Grid.Column="0"
                    Text="✖  Close"
                    BackgroundColor="#0f3460"
                    TextColor="White"
                    FontSize="15"
                    HeightRequest="48"
                    CornerRadius="8"
                    IsVisible="{Binding IsEditing,
                        Converter={StaticResource InvertedBoolConverter}}"
                    Clicked="OnCloseClicked" />
            <Button Grid.Column="1"
                    Text="✏️  Edit"
                    BackgroundColor="#1976d2"
                    TextColor="White"
                    FontSize="15"
                    HeightRequest="48"
                    CornerRadius="8"
                    IsVisible="{Binding IsEditing,
                        Converter={StaticResource InvertedBoolConverter}}"
                    Command="{Binding StartEditCommand}" />

            <Button Grid.Column="0"
                    Text="✖  Cancel"
                    BackgroundColor="#0f3460"
                    TextColor="White"
                    FontSize="15"
                    HeightRequest="48"
                    CornerRadius="8"
                    IsVisible="{Binding IsEditing}"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="1"
                    Text="✅  Save"
                    BackgroundColor="#1976d2"
                    TextColor="White"
                    FontSize="15"
                    HeightRequest="48"
                    CornerRadius="8"
                    IsVisible="{Binding IsEditing}"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</toolkit:Popup>