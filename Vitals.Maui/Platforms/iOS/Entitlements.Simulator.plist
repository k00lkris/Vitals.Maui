<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- .NET MAUI SecureStorage uses the iOS Keychain. The simulator needs
         an explicit keychain access group even though a physical iOS device
         does not. Use the team's explicit prefix here because simulator
         builds intentionally run without a provisioning profile. -->
    <key>keychain-access-groups</key>
    <array>
        <string>UZKKYZQM5N.com.vitalswellness.vitals</string>
    </array>
</dict>
</plist>
