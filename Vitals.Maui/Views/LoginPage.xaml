<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             x:Class="Vitals.Maui.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{DynamicResource PageBackground}">

    <VerticalStackLayout VerticalOptions="Center"
                         HorizontalOptions="Center"
                         Spacing="24"
                         Padding="32">

        <!-- Logo / Title -->
        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
            <Image Source="vitals_logo"
               HeightRequest="120"
               HorizontalOptions="Center"
               Aspect="AspectFit" />
            <Label Text="Clinical clarity for the people who care most."
               FontSize="15"
               TextColor="{DynamicResource TextMuted}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Email / password (disabled placeholder — no backend yet) -->
        <VerticalStackLayout Spacing="12" WidthRequest="280">
            <Entry Placeholder="Email address"
                   Text="{Binding Email}"
                   IsEnabled="False"
                   Keyboard="Email"
                   TextColor="{DynamicResource TextPrimary}"
                   PlaceholderColor="{DynamicResource TextMuted}"
                   BackgroundColor="{DynamicResource CardBackground}" />
            <Entry Placeholder="Password"
                   Text="{Binding Password}"
                   IsEnabled="False"
                   IsPassword="True"
                   TextColor="{DynamicResource TextPrimary}"
                   PlaceholderColor="{DynamicResource TextMuted}"
                   BackgroundColor="{DynamicResource CardBackground}" />
            <Button Text="Sign In"
                    IsEnabled="False"
                    BackgroundColor="{DynamicResource ButtonSecondary}"
                    TextColor="{DynamicResource ButtonSecondaryText}"
                    FontSize="15"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    CornerRadius="10" />
            <Label Text="Email sign-in is coming soon — use Google for now."
                   FontSize="12"
                   TextColor="{DynamicResource TextMuted}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
            <BoxView HeightRequest="1" WidthRequest="60" BackgroundColor="{DynamicResource DividerColor}" />
            <Label Text="or" FontSize="13" TextColor="{DynamicResource TextMuted}" />
            <BoxView HeightRequest="1" WidthRequest="60" BackgroundColor="{DynamicResource DividerColor}" />
        </HorizontalStackLayout>

        <!-- Sign In Buttons -->
        <Button Text="  Sign in with Google"
            BackgroundColor="White"
            TextColor="#3c4043"
            FontSize="16"
            FontAttributes="Bold"
            HeightRequest="54"
            CornerRadius="10"
            Command="{Binding SignInWithGoogleCommand}">
            <Button.ImageSource>
                <FileImageSource File="google_logo" />
            </Button.ImageSource>
        </Button>

        <!-- New to Vitals? -->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
            <Label Text="New to Vitals?"
                   FontSize="14"
                   TextColor="{DynamicResource TextSecondary}"
                   VerticalOptions="Center" />
            <Button Text="Sign up here"
                    Command="{Binding NavigateToSignUpCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource PrimaryAccent}"
                    FontSize="14"
                    FontAttributes="Bold"
                    Padding="0"
                    BorderWidth="0" />
        </HorizontalStackLayout>

        <!-- Status -->
        <Label Text="{Binding StatusMessage}"
               IsVisible="{Binding StatusMessage,
                   Converter={StaticResource StringToBoolConverter}}"
               TextColor="#d32f2f"
               FontSize="13"
               HorizontalOptions="Center" />

        <!-- Busy -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{DynamicResource PrimaryAccent}"
                           HorizontalOptions="Center" />

        <!-- Version -->
        <Label Text="Vitals v0.1 alpha"
               FontSize="11"
               TextColor="{DynamicResource TextMuted}"
               HorizontalOptions="Center"
               Margin="0,32,0,0" />

    </VerticalStackLayout>
</ContentPage>