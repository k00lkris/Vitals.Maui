<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             x:Class="Vitals.Maui.Views.PatientAccessSelectionPage"
             x:DataType="vm:PatientAccessSelectionViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource VitalsBluePageBackground}">

    <Grid Padding="24"
          RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
          RowSpacing="12">

        <Label Grid.Row="0"
               Text="Choose active patients"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="{StaticResource VitalsBlueTextPrimary}"
               HorizontalOptions="Center"
               Margin="0,16,0,0" />

        <Label Grid.Row="1"
               Text="Your current plan supports fewer patient profiles. Choose which patients you want to keep active right now."
               FontSize="14"
               TextColor="{StaticResource VitalsBlueTextSecondary}"
               HorizontalTextAlignment="Center"
               Margin="12,0" />

        <VerticalStackLayout Grid.Row="2" Spacing="4">
            <Label Text="{Binding SelectionSummary}"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{StaticResource VitalsBluePrimaryAccent}"
                   HorizontalOptions="Center" />
            <Label Text="Nothing is deleted. Other patient profiles and their clinical history stay safely stored and will become available again when your plan supports them."
                   FontSize="12"
                   TextColor="{StaticResource VitalsBlueTextMuted}"
                   HorizontalTextAlignment="Center"
                   Margin="8,0" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Patients}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PatientAccessChoice">
                    <Border Padding="14"
                            Margin="0,0,0,8"
                            BackgroundColor="{StaticResource VitalsBlueCardBackground}"
                            Stroke="{StaticResource VitalsBlueCardStroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <CheckBox Grid.Column="0"
                                      VerticalOptions="Center"
                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      CheckedChanged="OnPatientCheckedChanged" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding FullName}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource VitalsBlueTextPrimary}" />
                                <Label Text="{Binding Details}"
                                       FontSize="12"
                                       TextColor="{StaticResource VitalsBlueTextMuted}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="4"
               Text="{Binding StatusMessage}"
               FontSize="13"
               TextColor="#d32f2f"
               HorizontalTextAlignment="Center"
               MinHeightRequest="20" />

        <Button Grid.Row="5"
                Text="Keep selected patients active"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding CanContinue}"
                BackgroundColor="{StaticResource VitalsBlueButtonBackground}"
                TextColor="{StaticResource VitalsBlueTextPrimary}"
                FontSize="15"
                FontAttributes="Bold"
                HeightRequest="52"
                CornerRadius="12"
                Margin="0,0,0,12" />

    </Grid>
</ContentPage>
