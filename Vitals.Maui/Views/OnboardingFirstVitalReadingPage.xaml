<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             x:Class="Vitals.Maui.Views.OnboardingFirstVitalReadingPage"
             x:DataType="vm:OnboardingFirstVitalReadingViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">

            <!-- Back -->
            <Button Text="←"
                    Command="{Binding BackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource TextSecondary}"
                    FontSize="22"
                    HorizontalOptions="Start"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0" />

            <Label Text="Your baseline starts now"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TextPrimary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Label Text="Log your first reading, or skip and do it later."
                   FontSize="14"
                   TextColor="{DynamicResource TextSecondary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="16,0,16,8" />

            <!-- Patient picker — only shown when there's more than one -->
            <Picker ItemsSource="{Binding Patients}"
                    SelectedItem="{Binding SelectedPatient}"
                    IsVisible="{Binding HasMultiplePatients}"
                    TextColor="{DynamicResource TextPrimary}"
                    TitleColor="{DynamicResource TextMuted}"
                    Title="Who is this reading for?"
                    BackgroundColor="{DynamicResource CardBackground}" />

            <Border Padding="16"
                    BackgroundColor="{DynamicResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{DynamicResource CardStroke}">
                <VerticalStackLayout Spacing="0">

                    <!-- Systolic — always shown -->
                    <Grid Padding="4,12" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Systolic (mmHg)" FontSize="15" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding Systolic}" Keyboard="Numeric"
                               HorizontalTextAlignment="End" TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="Transparent" PlaceholderColor="{DynamicResource TextMuted}"
                               Placeholder="—" WidthRequest="80" />
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <!-- Diastolic — always shown -->
                    <Grid Padding="4,12" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Diastolic (mmHg)" FontSize="15" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding Diastolic}" Keyboard="Numeric"
                               HorizontalTextAlignment="End" TextColor="{DynamicResource TextPrimary}"
                               BackgroundColor="Transparent" PlaceholderColor="{DynamicResource TextMuted}"
                               Placeholder="—" WidthRequest="80" />
                    </Grid>

                    <!-- Heart Rate -->
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding ShowHeartRate}">
                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />
                        <Grid Padding="4,12" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Heart Rate (bpm)" FontSize="15" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding HeartRate}" Keyboard="Numeric"
                                   HorizontalTextAlignment="End" TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="Transparent" PlaceholderColor="{DynamicResource TextMuted}"
                                   Placeholder="—" WidthRequest="80" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- SpO2 -->
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding ShowSpo2}">
                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />
                        <Grid Padding="4,12" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="SpO₂ (%)" FontSize="15" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding OxygenSaturation}" Keyboard="Numeric"
                                   HorizontalTextAlignment="End" TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="Transparent" PlaceholderColor="{DynamicResource TextMuted}"
                                   Placeholder="—" WidthRequest="80" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Temperature -->
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding ShowTemperature}">
                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />
                        <Grid Padding="4,12" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Temperature (°F)" FontSize="15" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding Temperature}" Keyboard="Numeric"
                                   HorizontalTextAlignment="End" TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="Transparent" PlaceholderColor="{DynamicResource TextMuted}"
                                   Placeholder="—" WidthRequest="80" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Blood Glucose -->
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding ShowGlucose}">
                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />
                        <Grid Padding="4,12" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Blood Glucose (mg/dL)" FontSize="15" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding BloodGlucose}" Keyboard="Numeric"
                                   HorizontalTextAlignment="End" TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="Transparent" PlaceholderColor="{DynamicResource TextMuted}"
                                   Placeholder="—" WidthRequest="80" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Weight -->
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding ShowWeight}">
                        <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />
                        <Grid Padding="4,12" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Weight (lbs)" FontSize="15" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding Weight}" Keyboard="Numeric"
                                   HorizontalTextAlignment="End" TextColor="{DynamicResource TextPrimary}"
                                   BackgroundColor="Transparent" PlaceholderColor="{DynamicResource TextMuted}"
                                   Placeholder="—" WidthRequest="80" />
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                   FontSize="13"
                   TextColor="#E57373"
                   HorizontalOptions="Center" />

            <!-- Progress dots (6 of 6) -->
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,4,0,0">
                <BoxView HeightRequest="8" WidthRequest="8" CornerRadius="4" BackgroundColor="{DynamicResource DividerColor}" />
                <BoxView HeightRequest="8" WidthRequest="8" CornerRadius="4" BackgroundColor="{DynamicResource DividerColor}" />
                <BoxView HeightRequest="8" WidthRequest="8" CornerRadius="4" BackgroundColor="{DynamicResource DividerColor}" />
                <BoxView HeightRequest="8" WidthRequest="8" CornerRadius="4" BackgroundColor="{DynamicResource DividerColor}" />
                <BoxView HeightRequest="8" WidthRequest="8" CornerRadius="4" BackgroundColor="{DynamicResource DividerColor}" />
                <BoxView HeightRequest="8" WidthRequest="24" CornerRadius="4" BackgroundColor="{DynamicResource PrimaryAccent}" />
            </HorizontalStackLayout>

            <Button Text="Submit Reading"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="{DynamicResource ButtonBackground}"
                    TextColor="{DynamicResource TextPrimary}"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    CornerRadius="12"
                    Margin="0,4,0,0" />

            <Button Text="Skip for now"
                    Command="{Binding SkipCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource TextSecondary}"
                    FontSize="14"
                    HeightRequest="44" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{DynamicResource PrimaryAccent}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
