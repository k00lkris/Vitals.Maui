<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
               x:Class="Vitals.Maui.Views.AllergyDetailPopup"
               x:DataType="vm:AllergyDetailViewModel">

    <Grid RowDefinitions="*,Auto"
          HeightRequest="580"
          WidthRequest="360"
          BackgroundColor="{DynamicResource CardBackground}">

        <ScrollView Grid.Row="0" Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- Allergen Name -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="{Binding Allergen}"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}"
                           LineBreakMode="WordWrap" VerticalOptions="Center"
                           IsVisible="{Binding IsEditing,
                               Converter={StaticResource InvertedBoolConverter}}" />
                    <Entry Grid.Column="0"
                           Text="{Binding Allergen}"
                           FontSize="16"
                           TextColor="{DynamicResource TextPrimary}"
                           BackgroundColor="{DynamicResource PageBackground}"
                           Placeholder="Allergen name"
                           PlaceholderColor="{DynamicResource TextMuted}"
                           IsVisible="{Binding IsEditing}" />

                    <!-- Severity Badge — BackgroundColor is semantic from VM binding -->
                    <Border Grid.Column="1"
                            Padding="8,4"
                            StrokeShape="RoundRectangle 6"
                            VerticalOptions="Center"
                            IsVisible="{Binding IsEditing,
                                Converter={StaticResource InvertedBoolConverter}}">
                        <Border.BackgroundColor>
                            <Binding Path="SelectedSeverityLabel">
                                <Binding.Converter>
                                    <StaticResource Key="BoolToColorConverter" />
                                </Binding.Converter>
                            </Binding>
                        </Border.BackgroundColor>
                        <Label Text="{Binding SelectedSeverityLabel}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="White" />
                    </Border>
                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                <!-- Type (read-only) -->
                <VerticalStackLayout Spacing="2"
                                     IsVisible="{Binding IsEditing,
                                         Converter={StaticResource InvertedBoolConverter}}">
                    <Label Text="Type" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                    <Label Text="{Binding SelectedTypeLabel}"
                           FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>

                <!-- Type toggles (edit mode) -->
                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsEditing}">
                    <Label Text="Type" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="8" RowSpacing="8">
                        <Button Grid.Row="0" Grid.Column="0" Text="💊 Medication"
                                BackgroundColor="{Binding MedicationColor}"
                                TextColor="{DynamicResource TextPrimary}" FontSize="12"
                                HeightRequest="40" CornerRadius="8"
                                Command="{Binding SelectMedicationCommand}"
                                InputTransparent="{Binding IsEditing,
                                    Converter={StaticResource InvertedBoolConverter}}" />
                        <Button Grid.Row="0" Grid.Column="1" Text="🍔 Food"
                                BackgroundColor="{Binding FoodColor}"
                                TextColor="{DynamicResource TextPrimary}" FontSize="12"
                                HeightRequest="40" CornerRadius="8"
                                Command="{Binding SelectFoodCommand}"
                                InputTransparent="{Binding IsEditing,
                                    Converter={StaticResource InvertedBoolConverter}}" />
                        <Button Grid.Row="1" Grid.Column="0" Text="🌿 Environmental"
                                BackgroundColor="{Binding EnvironmentalColor}"
                                TextColor="{DynamicResource TextPrimary}" FontSize="12"
                                HeightRequest="40" CornerRadius="8"
                                Command="{Binding SelectEnvironmentalCommand}"
                                InputTransparent="{Binding IsEditing,
                                    Converter={StaticResource InvertedBoolConverter}}" />
                        <Button Grid.Row="1" Grid.Column="1" Text="❓ Other"
                                BackgroundColor="{Binding OtherTypeColor}"
                                TextColor="{DynamicResource TextPrimary}" FontSize="12"
                                HeightRequest="40" CornerRadius="8"
                                Command="{Binding SelectOtherTypeCommand}"
                                InputTransparent="{Binding IsEditing,
                                    Converter={StaticResource InvertedBoolConverter}}" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Severity (read-only) -->
                <VerticalStackLayout Spacing="2"
                                     IsVisible="{Binding IsEditing,
                                         Converter={StaticResource InvertedBoolConverter}}">
                    <Label Text="Severity" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                    <Label Text="{Binding SelectedSeverityLabel}"
                           FontSize="14" TextColor="{DynamicResource TextSecondary}" />
                </VerticalStackLayout>

                <!-- Severity toggles (edit mode) -->
                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsEditing}">
                    <Label Text="Severity" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Mild"
                                BackgroundColor="{Binding MildColor}"
                                TextColor="{DynamicResource TextPrimary}" FontSize="13"
                                HeightRequest="40" CornerRadius="8"
                                Command="{Binding SelectMildCommand}" />
                        <Button Grid.Column="1" Text="Moderate"
                                BackgroundColor="{Binding ModerateColor}"
                                TextColor="{DynamicResource TextPrimary}" FontSize="13"
                                HeightRequest="40" CornerRadius="8"
                                Command="{Binding SelectModerateCommand}" />
                        <Button Grid.Column="2" Text="Severe"
                                BackgroundColor="{Binding SevereColor}"
                                TextColor="{DynamicResource TextPrimary}" FontSize="13"
                                HeightRequest="40" CornerRadius="8"
                                Command="{Binding SelectSevereCommand}" />
                    </Grid>
                </VerticalStackLayout>

                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                <!-- Reaction -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Reaction" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                    <Label Text="{Binding Reaction}"
                           FontSize="14" TextColor="{DynamicResource TextSecondary}"
                           LineBreakMode="WordWrap"
                           IsVisible="{Binding IsEditing,
                               Converter={StaticResource InvertedBoolConverter}}" />
                    <Entry Text="{Binding Reaction}"
                           FontSize="14"
                           TextColor="{DynamicResource TextPrimary}"
                           BackgroundColor="{DynamicResource PageBackground}"
                           Placeholder="Describe the reaction"
                           PlaceholderColor="{DynamicResource TextMuted}"
                           IsVisible="{Binding IsEditing}" />
                </VerticalStackLayout>

                <!-- Notes -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Notes" FontSize="11" TextColor="{DynamicResource PrimaryAccent}" />
                    <Label Text="{Binding Notes}"
                           FontSize="14" TextColor="{DynamicResource TextSecondary}"
                           LineBreakMode="WordWrap"
                           IsVisible="{Binding IsEditing,
                               Converter={StaticResource InvertedBoolConverter}}" />
                    <Editor Text="{Binding Notes}"
                            FontSize="14"
                            TextColor="{DynamicResource TextPrimary}"
                            BackgroundColor="{DynamicResource PageBackground}"
                            Placeholder="Additional notes"
                            PlaceholderColor="{DynamicResource TextMuted}"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="60"
                            IsVisible="{Binding IsEditing}" />
                </VerticalStackLayout>

                <!-- Active Toggle (edit mode only) -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsEditing}">
                    <Label Grid.Column="0"
                           Text="Active" FontSize="14"
                           TextColor="{DynamicResource PrimaryAccent}"
                           VerticalOptions="Center" />
                    <Switch Grid.Column="1"
                            IsToggled="{Binding IsActive}"
                            OnColor="{DynamicResource ButtonBackground}" />
                </Grid>

                <!-- Status -->
                <Label Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage,
                           Converter={StaticResource StringToBoolConverter}}"
                       TextColor="#d32f2f" FontSize="13"
                       HorizontalOptions="Center" />

                <!-- Busy -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{DynamicResource PrimaryAccent}"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="1"
              Padding="16"
              BackgroundColor="{DynamicResource CardBackground}"
              ColumnDefinitions="*,*"
              ColumnSpacing="8">

            <!-- Read-only: Close + Edit -->
            <Button Grid.Column="0" Text="✖  Close"
                    BackgroundColor="{DynamicResource ButtonSecondary}"
                    TextColor="{DynamicResource ButtonSecondaryText}"
                    FontSize="15" HeightRequest="48" CornerRadius="8"
                    IsVisible="{Binding IsEditing,
                        Converter={StaticResource InvertedBoolConverter}}"
                    Clicked="OnCloseClicked" />
            <Button Grid.Column="1" Text="✏️  Edit"
                    BackgroundColor="{DynamicResource ButtonBackground}"
                    TextColor="{DynamicResource TextPrimary}"
                    FontSize="15" HeightRequest="48" CornerRadius="8"
                    IsVisible="{Binding IsEditing,
                        Converter={StaticResource InvertedBoolConverter}}"
                    Command="{Binding StartEditCommand}" />

            <!-- Edit mode: Cancel + Save -->
            <Button Grid.Column="0" Text="✖  Cancel"
                    BackgroundColor="{DynamicResource ButtonSecondary}"
                    TextColor="{DynamicResource ButtonSecondaryText}"
                    FontSize="15" HeightRequest="48" CornerRadius="8"
                    IsVisible="{Binding IsEditing}"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="1" Text="✅  Save"
                    BackgroundColor="{DynamicResource ButtonBackground}"
                    TextColor="{DynamicResource TextPrimary}"
                    FontSize="15" HeightRequest="48" CornerRadius="8"
                    IsVisible="{Binding IsEditing}"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</toolkit:Popup>
