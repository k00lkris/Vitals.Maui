<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vitals.Maui.ViewModels"
             xmlns:services="clr-namespace:Vitals.Maui.Services"
             x:Class="Vitals.Maui.Views.HouseholdInvitePage"
             x:DataType="vm:HouseholdInviteViewModel"
             Title="Household Members"
             BackgroundColor="{DynamicResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Invite form -->
            <Border Padding="16"
                    BackgroundColor="{DynamicResource CardBackground}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{DynamicResource CardStroke}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Invite a household member"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" />

                    <Label Text="{Binding AvailableSlots, StringFormat='{0} patient slot(s) available for new invites'}"
                           FontSize="13"
                           TextColor="{DynamicResource TextMuted}" />

                    <Entry Placeholder="Their email address"
                           Text="{Binding InviteeEmail}"
                           Keyboard="Email"
                           IsEnabled="{Binding CanInvite}"
                           TextColor="{DynamicResource TextPrimary}"
                           PlaceholderColor="{DynamicResource TextMuted}"
                           BackgroundColor="Transparent" />
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource DividerColor}" />

                    <Button Text="Send Invite"
                            Command="{Binding SendInviteCommand}"
                            IsEnabled="{Binding CanInvite}"
                            BackgroundColor="{DynamicResource ButtonBackground}"
                            TextColor="{DynamicResource TextPrimary}"
                            FontSize="15" FontAttributes="Bold"
                            HeightRequest="48" CornerRadius="10" />

                    <Label Text="No patient slots available — cancel a pending invite below, or wait for one to expire, to invite someone new."
                           IsVisible="{Binding CanInvite, Converter={StaticResource InvertedBoolConverter}}"
                           FontSize="12"
                           TextColor="{DynamicResource TextMuted}" />

                    <Label Text="{Binding StatusMessage}"
                           IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBoolConverter}}"
                           FontSize="13"
                           TextColor="{DynamicResource PrimaryAccent}" />
                </VerticalStackLayout>
            </Border>

            <!-- Pending invites -->
            <Label Text="Pending invites"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="{DynamicResource TextPrimary}"
                   Margin="4,8,0,0" />

            <CollectionView ItemsSource="{Binding PendingInvites}">
                <CollectionView.EmptyView>
                    <Label Text="No pending invites."
                           FontSize="13"
                           TextColor="{DynamicResource TextMuted}"
                           Margin="4,0,0,0" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:PendingInvite">
                        <Border Padding="14" Margin="0,0,0,8"
                                BackgroundColor="{DynamicResource CardBackground}"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{DynamicResource CardStroke}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding InvitedEmail}" FontSize="15" TextColor="{DynamicResource TextPrimary}" />
                                    <Label Text="{Binding ExpiresAt, StringFormat='Expires {0}'}" FontSize="12" TextColor="{DynamicResource TextMuted}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Cancel"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HouseholdInviteViewModel}}, Path=CancelInviteCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent"
                                        TextColor="#d32f2f"
                                        FontSize="13"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{DynamicResource PrimaryAccent}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
